CI_FALSE_VALUES = ("", "0", "false", "no")


def person_at_terminal():
    """True only when CI reads false and stdin and stdout are both terminals (design D1)."""
    if os.environ.get("CI", "").strip().lower() not in CI_FALSE_VALUES:
        return False
    try:
        return bool(sys.stdin is not None and sys.stdout is not None
                    and sys.stdin.isatty() and sys.stdout.isatty())
    except (AttributeError, OSError, ValueError):
        return False


