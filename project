# The two status pins, on the status and hidden-state probes and the removal.
STATUS_PINS = ("-c", "core.untrackedCache=false", "-c", "core.fsmonitor=false")

# Per kind of Git child: whether it is a read-only probe, which sets
# GIT_OPTIONAL_LOCKS=0; the -c pins it carries before the protocol pins;
# whether it carries the protocol pins; and the scrubbed names it keeps.
GIT_KINDS = {
    "probe": (True, (), True, ()),
    "status": (True, STATUS_PINS, True, ()),
    "hidden": (True, STATUS_PINS, True, ()),
    "removal": (False, ("-c", "status.showUntrackedFiles=normal", *STATUS_PINS), True, ()),
    "delegate": (False, (), True, ()),
    # The push child of `clean --action push` follows draft PR #19 and lead
    # ruling R-28: no protocol pin, and the caller's GIT_ALLOW_PROTOCOL kept.
