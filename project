# region git environment
# The environment and the argument vector of every Git child (design D6, D9 and
# D11; contracts/project-clean.md, "Git children"; FR-054).

# The variables of D11's configuration-path test (Brett Heap's ruling LQ-15;
# lead ruling R-102), in D18's order. Git builds its user configuration and its
# global ignore and attributes files from HOME and XDG_CONFIG_HOME as they are
# spelled, so a relative value resolves in the directory a Git child runs in,
# where a repository's own files would be read as the user's configuration.
CONFIG_PATH_RULED = ("HOME", "XDG_CONFIG_HOME")
# The lead's extension of LQ-15, which Brett Heap may strike: Git's own names
# for the user's and the system's configuration file. Striking it is this one
# line, made `CONFIG_PATH_EXTENSION = ()`; nothing else in project names them
# for the test.
CONFIG_PATH_EXTENSION = ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM")


def relative_config_paths():
    """The names of the variables that fail D11's configuration-path test, in
    D18's order: each of CONFIG_PATH_RULED and CONFIG_PATH_EXTENSION whose raw
    value (os.environb) is not empty and whose first byte is not b"/", so that
    ` /x`, `~/x`, `.` and a first byte that is not UTF-8 fail it and `/` alone
    passes. An unset or empty variable passes. Each is tested whether or not
    Git would read a file through it, not in Git's order of precedence. The
    values are read for this test alone: they reach every child unchanged, and
    nothing prints them."""
    return [name for name in (*CONFIG_PATH_RULED, *CONFIG_PATH_EXTENSION) if config_path_fails(name)]


def config_path_fails(name):
    """Whether the variable NAME fails D11's test: its raw value is set, not
    empty, and its first byte is not b"/"."""
    return os.environb.get(os.fsencode(name), b"")[:1] not in (b"", b"/")


def home_directory():
    """project's own home directory, Path.home(), for the files status, doctor
    and update read under it (the workspace configuration, the credential
    presence checks, the default projects directories); None when HOME fails
    D11's test. Such a HOME names no home directory: nothing is read under it,
    and Path.home(), which raises RuntimeError for a HOME that begins with `~`
    and resolves a relative one against the working directory, is never called
    on it (lead ruling R-202; lane 3's W30 M-1)."""
    return None if config_path_fails("HOME") else Path.home()


def expand_user(path):
    """Path(path).expanduser(), or None for a path that names the current
    user's home, `~` alone or `~/...`, while HOME fails D11's test, so that
    nothing is expanded against such a HOME (R-202). `~user` is read from the
    user database, never from HOME, and expands as before."""
    path = Path(path)
    if path.parts[:1] == ("~",) and config_path_fails("HOME"):
        return None
    return path.expanduser()


def config_path_message(names):
    """D18's text for the variables that fail the test: one line per name, in
    the order given, never a value."""
    return "\n".join(TEXT["relative_config_path"].format(NAME=name) for name in names)


def hold_git_for_config_paths(run):
    """The configuration-path test of status, doctor and update, at their entry,
    before any Git child (D11, D16; LQ-15). When a variable fails it, run's
    version memo is set, in place of the version check, to a GitVersion whose
    code is `relative-config-path` and whose detail is config_path_message()'s
    text, and returned: every reader that tests the memo before a Git child,
    discover(), repo_state(), handoff()'s remote read through git() and
    doctor's git row, then starts none, `git --version` included, and the
    command reports the code as it reports a Git below the floor. Returns None,
    and sets nothing, when every variable passes. `clean` refuses instead
    (require_git())."""
    names = relative_config_paths()
    if not names:
        return None
    run.version = GitVersion("relative-config-path", detail=config_path_message(names))
    return run.version


