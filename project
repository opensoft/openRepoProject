# whether it carries the protocol pins; and the scrubbed names it keeps.
GIT_KINDS = {
    "probe": (True, (), True, ()),
    "status": (True, STATUS_PINS, True, ()),
    "hidden": (True, STATUS_PINS, True, ()),
    "removal": (False, ("-c", "status.showUntrackedFiles=normal", *STATUS_PINS), True, ()),
