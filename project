# region resolution
def is_bare_name(argument):
    """Whether argument names a project rather than a path (research.md R13
    as plan review M15 words it): after expanduser(), a relative argument
    that contains no `/` and is neither `.` nor `..`. An empty argument is
    none, as discover() reads it."""
    text = os.path.expanduser(os.fsdecode(argument))
    return bool(text) and not os.path.isabs(text) and "/" not in text and text not in (".", "..")


def resolve_clean_target(args, run):
    """Resolve the target argument Git-first to exactly one repository and
    its main worktree (T107; D8, FR-016, FR-017; contracts/project-clean.md,
    "Resolution"; lead rulings R-13, R-51 and R-53, P-10 to P-12 and P-20).
    Returns {"root": the main worktree, a Path, the command directory;
    "evidence": inspect_repository()'s dict}, which build_plan() reads
    instead of running row 3 again (lead ruling R-71 (b)).

    After expanduser(): an absolute path is probed where it names, and its
    realpath must equal row 3's toplevel and that toplevel be the main
    worktree; a relative path, or none, is joined to the working directory
    and probed there; a bare name (is_bare_name()) goes through discover()'s
    name lookup, and the directory it returns must be a worktree toplevel. A
    relative path and a bare name resolve to their repository's main
    worktree. discover()'s family-holder and manifest-ancestor redirections
    never apply to a path. discover()'s bare-name refusals are coded by their
    exact baseline messages, `ambiguous-name` for "Ambiguous project name;
    supply a path." and `repository-not-found` for "Directory does not exist:
    PATH" and "No project found at PATH; supply a path or name.", until US9's
    T118 gives discover() these codes itself (P-10); a refusal that already
    carries a code passes unchanged.

    Refused `target-not-repository-root`, exit 2, before any plan and with no
    context, in M6's order: row 3 failed (a directory outside any
    repository, a bare repository's own directory, a timeout); a submodule
    checkout (row 3's third line); a main worktree that main_worktree() gives
    as (None, cause); then the absolute-path and bare-name rules above. Then
    the merge target's own refusal (`no-merge-target`, `manifest-invalid`),
    before any row is probed, its context the repository and a null merge
    target. A repository-wide probe that failed after row 3 is no refusal
    here: build_plan() makes that plan incomplete."""
    target = getattr(args, "target", None) or ""
    text = os.path.expanduser(target)
    bare, absolute = is_bare_name(target), os.path.isabs(text)
    if bare:
        try:
            found = discover(target)
        except Refused as exc:
            message = str(exc)
            if exc.code is None and message == "Ambiguous project name; supply a path.":
                exc.code = "ambiguous-name"
            elif exc.code is None and (message.startswith("Directory does not exist: ") or (
                    message.startswith("No project found at ") and message.endswith("; supply a path or name."))):
                exc.code = "repository-not-found"
            raise
        directory = shown = os.fsencode(found)
    elif absolute:
        directory = shown = os.fsencode(text)
    else:
        directory = os.path.join(os.getcwdb(), os.fsencode(text)) if text else os.getcwdb()
        shown = os.path.abspath(directory)

    def refused():
        return Refused(TEXT["target_not_repository_root"].format(PATH=human_path(shown)),
                       code="target-not-repository-root", path=shown)

    evidence = inspect_repository(directory, run)
    identity = evidence["identity"]
    if identity is None or evidence["superproject"] is not None or evidence["main_cause"] is not None:
        raise refused()
    toplevel, root = evidence["toplevel"], identity["root"]
    if bare or absolute:  # the directory itself must be a worktree toplevel
        try:
            exact = _realpath(directory) == toplevel
        except EvidenceError:
            exact = False
        if not exact or (absolute and root is not None and toplevel != root):
            raise refused()
    refusal = evidence["merge_target_refusal"]
    if refusal is not None:
        refusal.context = {"repository": repository_object(identity), "merge_target": None}
        raise refusal
    return {"root": Path(os.fsdecode(toplevel if root is None else root)), "evidence": evidence}
# endregion resolution

# region plan
# The plan of one run (T049, T051; data-model.md, "Plan"; contracts/project-clean.md,
# "Plan envelope"; design D12 to D14; research.md R8 and R12).

# The baseline's freshness text, the envelope's `tracking_freshness`.
TRACKING_FRESHNESS = "local refs only; remote information is as of the last fetch; no fetch performed"


def repository_object(identity):
    """The envelope's `repository` (REPOSITORY_KEYS's order) for inspect_repository()'s
    identity: each path as json_path() writes it beside its flag; root and its
    flag null while the main worktree is not named."""
    root, root_valid = (None, None) if identity["root"] is None else json_path(identity["root"])
    common_dir, common_valid = json_path(identity["common_dir"])
    return {"root": root, "common_dir": common_dir, "dev": identity["dev"], "ino": identity["ino"],
            "root_valid_utf8": root_valid, "common_dir_valid_utf8": common_valid}


def _bounded_realpath(path):
    """The realpath of path by one fs_call(), or None when the call raised or
    was cut at its budget."""
    try:
        found = fs_call(os.path.realpath, path)
    except OSError:
        return None
    return None if isinstance(found, DriverOutcome) else found


def match_target(plan, run, entries, cap):
    """P of a named removal, `--apply --action remove --worktree P` (D13;
    contracts/project-clean.md, "Argument checks" and "Order of a run"; lead
    rulings R-53 P-15, R-56 and R-67 (b) as corrected), matched against the
    whole registry before any row is inspected. entries are the registry
    entries that are rows, (raw, record) in canonical order, raw the path the
    row carries; cap the plan's row cap. --worktree is expanded and
    realpath'd, which joins it to the working directory, by one bounded call;
    an entry matches when raw equals P's bytes, or else when its own realpath,
    one bounded call each, does; a realpath that cannot be read counts as a
    match, failing closed. The entries matched are P's rows: worktree_rows()
    inspects them before any other row, so that P's status probe is the run's
    first, and they are exempt from the row cap. When P's own realpath cannot
    be read, every entry counts as a match, so P's match is undecided and no
    entry is exempt: the entries matched are the ones the cap takes, the first
    cap of entries, the main worktree first, and no other row is inspected
    (lead ruling R-73 (d)). Sets plan.target_rows, the rows inspected for P,
    and plan.target, the one row when exactly one entry matched and was
    decided, else None. No match records `worktree-not-found` through
    refuse() with the baseline message, never raised (R-59 D4); several
    matches, or one not decided, leave plan.target None, so that nothing is
    selected for P and check_plan() refuses with inspection-incomplete.
    Returns (matched, path, exempt): the entries matched; P's realpath, or the
    expanded argument where that cannot be read, the PATH of the single-mode
    notes while no row is P's; and whether the entries matched are exempt from
    the cap."""
    wanted = os.path.expanduser(os.fsencode(run.args.worktree))
    found = _bounded_realpath(wanted)
    if found is None:
        matches, decided = list(entries[:cap]), False
    else:
        matches, decided = [], True
        for raw, record in entries:
            if raw == found:
                matches.append((raw, record))
            else:
                real = _bounded_realpath(raw)
                if real is None or real == found:
                    matches.append((raw, record))
                    decided = decided and real is not None
    path = found if found is not None else wanted
    plan.target_rows = worktree_rows(plan.evidence, run, records=[record for _, record in matches]) if matches else []
    if len(matches) == 1 and decided and len(plan.target_rows) == 1:
        plan.target = plan.target_rows[0]
    elif not matches:
        refuse(plan, Refused(f"No unique linked worktree found at {human_path(path)}",
                             code="worktree-not-found", path=path), run)
    return matches, path, found is not None


def row_incomplete(row):
    """Whether a row's own evidence is incomplete: `inspection-error`, or
    carrying the unprobed marker (T066's reflog read past its budget)."""
    return bool(row.unprobed) or row["classification"] == "inspection-error"


def plan_completeness(plan, exclude=()):
    """The codes that make plan incomplete, in REFUSAL_CODES order (FR-024,
    FR-031; data-model.md, "Plan"; analyze M6; T075): `inspection-incomplete`
    when a repository-wide probe failed (plan.evidence's errors), when a
    counted row of plan.rows not in exclude is `inspection-error` or unprobed,
    or when P's rows are not excluded and P names no single established row
    (plan.target None while plan.target_rows holds rows); `inspect-cap` when
    rows were left past the row cap (plan.omitted's count). In mode single for
    --action remove only P's own rows count and the cap is no code: another
    row's state and the rows past the cap are non-blocking notes, which
    build_plan() records, while P's own evidence stays strict (the delta's
    "Clean can explicitly retire verified worktrees"). Every other plan, push
    and delete-branch included, counts every row and the cap (plan review
    B1). check_plan() passes P's rows as exclude, so that its own step 3 judges
    them. T099 adds `deadline-exceeded`."""
    skip = {id(row) for row in exclude}
    target_rows = getattr(plan, "target_rows", [])
    named = plan.mode == "single" and plan.action == "remove"
    own = {id(row) for row in target_rows}
    counted = [row for row in plan.rows if id(row) not in skip and (id(row) in own or not named)]
    codes = []
    if ((plan.evidence and plan.evidence["errors"]) or any(row_incomplete(row) for row in counted)
            or (plan.target is None and bool(target_rows) and not any(id(row) in skip for row in target_rows))):
        codes.append("inspection-incomplete")
    if not named and (getattr(plan, "omitted", None) or {}).get("count"):
        codes.append("inspect-cap")
    return codes


def incomplete_refusal(plan, code):
    """The refusal of a plan incomplete with code (FR-024, FR-031; design D18):
    `The plan is incomplete (CODE): REMEDY.`, REMEDY D18's for the code."""
    if code == "inspect-cap":
        registry = (plan.evidence or {}).get("records") or ()
        remedy = TEXT["remedy_inspect_cap"].format(N=len(registry), M=LIMITS["worktree_rows"][plan.mode])
    elif code == "deadline-exceeded":
        remedy = TEXT["remedy_deadline_exceeded"]
    else:
        remedy = TEXT["remedy_inspection_incomplete"]
    return Refused(TEXT["plan_incomplete"].format(CODE=code, REMEDY=remedy), code=code)


def json_argument(argument):
    """One argument of a child's vector as a JSON document writes it."""
    return argument if isinstance(argument, str) else json_path(argument)[0]


def select_entry(row, plan):
    """One `selected` entry (contracts/project-clean.md, "Plan envelope"), in
    SELECTED_KEYS's order: the path beside its flag; the branch evidence
    (branch, head, upstream, upstream_oid, ahead, behind); the worktree identity
    (dev, ino, admin_id); locked; the baseline signature fields (present, dirty,
    ignored_files, remote_present, merged_into_target, current, classification);
    and operation, {kind: "worktree-remove", argv}, argv the exact vector of
    the row's removal child, git_argv("removal", row.removal_args), each path
    as json_path() writes it."""
    values = dict(row)
    values.update(upstream_oid=row.upstream_oid, dev=row.dev, ino=row.ino,
                  admin_id=None if row.admin_id is None else json_path(row.admin_id)[0],
                  operation={"kind": "worktree-remove",
                             "argv": [json_argument(arg) for arg in git_argv("removal", row.removal_args)]})
    return {key: values[key] for key in SELECTED_KEYS}


def plan_digest(plan):
    """The plan's digest (FR-025; research.md R12; T051): the lowercase hex
    SHA-256 of the UTF-8 encoding of json.dumps(value, sort_keys=True,
    separators=(",", ":"), ensure_ascii=False), value holding exactly the
    repository's `root`, `common_dir`, `dev` and `ino`, the merge target's
    `name` and `sha`, and `selected`, the [path, branch, head] of each selected
    row in canonical order, or null where a report withholds the selection.
    The mode, observed_at, the flags, `excluded` and the notes are not in it,
    and ensure_ascii=False serves this text alone, never a document. Paths are
    the text the document writes; a branch name that is not valid UTF-8 gives
    back its own bytes (surrogateescape)."""
    repository = plan.repository or {}
    merge_target = plan.merge_target or {}
    value = {
        "repository": {key: repository.get(key) for key in ("root", "common_dir", "dev", "ino")},
        "merge_target": {key: merge_target.get(key) for key in ("name", "sha")},
        "selected": None if plan.selected is None else [
            [row["path"], row["branch"], row["head"]] for row in plan.selected],
    }
    text = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(text.encode("utf-8", "surrogateescape")).hexdigest()


def plan_limits(mode):
    """The envelope's `limits`: the mode's row cap and the bounds, as in force."""
    return {"worktree_rows": LIMITS["worktree_rows"][mode], "targets": LIMITS["targets"],
            "ignored_entries": LIMITS["ignored_entries"], "status_records": LIMITS["status_records"],
            "ignored_samples": LIMITS["ignored_samples"]}


def plan_budget():
    """The envelope's `budget`: the values of TIMING in force, read now (R-29)."""
    return {"probe_timeout_seconds": TIMING["probe_budget"],
            "invocation_timeout_seconds": TIMING["invocation_deadline"],
            "reconciliation_reserve_seconds": TIMING["reconciliation_reserve"],
            "removal_floor_seconds": TIMING["removal_floor"],
            "removal_ceiling_seconds": TIMING["removal_ceiling"],
            "probe_concurrency": 1}


def plan_document(plan):
    """The plan envelope (T051; contracts/project-clean.md, "Plan envelope";
    plan review M6; lead ruling R-56), the keys of PLAN_ENVELOPE_KEYS and no
    other, in that order: the baseline `root`, `target_branch` and
    `tracking_freshness` kept; `observed_at` from region guard's observed_at();
    `worktrees`, the rows in canonical order, row `notes` code strings;
    `probes` and `operations` (research.md R8; lead ruling R-27), `estimated`
    the upper bound of an --apply run of this plan in every mode, F + W + E +
    5T + 3 and T, and `performed` from the counters of the invocation in force;
    `selected` (select_entry()), `excluded` {path, path_valid_utf8, branch,
    classification, reason}, `omitted` ({count: 0, exactness: "exact"} until
    T075 sets plan.omitted), the plan's `notes` as {code, message} objects,
    `completeness`, `apply_allowed`, `refusals` as refusal objects, and
    `plan_digest`. print_plan() writes it through write_document(), with
    ensure_ascii=True."""
    run = current_invocation()
    selected = plan.selected
    targets = 0 if selected is None else len(selected)
    repository, merge_target = plan.repository, plan.merge_target
    root = (repository["root"] if repository and repository["root"] is not None
            else json_path(os.fsencode(plan.root))[0])
    values = {
        "schema_version": 1,
        "observed_at": observed_at(),
        "mode": plan.mode,
        "root": root,
        "target_branch": merge_target["name"] if merge_target else None,
        "tracking_freshness": TRACKING_FRESHNESS,
        "worktrees": [dict(row) for row in plan.rows],
        "repository": repository,
        "merge_target": merge_target,
        "limits": plan_limits(plan.mode),
        "budget": plan_budget(),
        "probes": {"estimated": getattr(plan, "planning_probes", 0) + 5 * targets + 3, "performed": run.probes},
        "operations": {"estimated": targets, "performed": run.operations},
        "selected": None if selected is None else [select_entry(row, plan) for row in selected],
        "excluded": [{"path": row["path"], "path_valid_utf8": row["path_valid_utf8"], "branch": row.get("branch"),
                      "classification": row.get("classification"), "reason": reason}
                     for row, reason in plan.excluded],
        "omitted": getattr(plan, "omitted", None) or {"count": 0, "exactness": "exact"},
        "notes": [dict(note) for note in plan.notes],
        "completeness": plan.completeness,
        "apply_allowed": plan.apply_allowed,
        "refusals": [refusal.as_object() for refusal in plan.refusals],
        "plan_digest": plan.digest,
    }
    return {key: values[key] for key in PLAN_ENVELOPE_KEYS}


def build_plan(repo, run):
    """Build the run's Plan for repo, resolve_clean_target()'s dict, and return
    it, never a status (T049; data-model.md, "Plan"; lead rulings R-56 and R-59
    D4). It reads lane G's evidence directly, inspect_repository()'s dict and
    worktree_rows(), never cleanup_report(), so that a failed repository-wide
    probe gives a plan incomplete with inspection-incomplete rather than a
    refusal. That dict is repo's "evidence", the resolution's, so that row 3
    runs once (lead ruling R-71 (b)). Only for a caller that passes no
    evidence does build_plan() read it itself and raise the baseline's
    `Cannot inspect Git repository at ROOT` where row 3 failed, ROOT is no
    worktree toplevel, or no main worktree is named with no probe failed. On
    clean's path that raise is unreachable, because the evidence comes from
    the resolution, which refuses those repositories itself (T107; lead
    ruling R-72 (g)). Still raised, as the repository as a whole cannot be
    planned: the merge target's own refusal (`no-merge-target`, a
    manifest's), with the repository in its context.

    The plan holds: `evidence`; `repository`, the envelope's object;
    `merge_target` {name, source, sha}, its resolution's notes moved to the
    plan's `notes` as {code, message} objects (P-13); `rows`, the main worktree
    first, then by raw path bytes, read within the row cap (T075; FR-013,
    FR-031, D13): the registry, row 4, is read whole before any cap, and of
    its entries that are rows, in that order, the first LIMITS["worktree_rows"]
    of the mode (128, or 256 in a report) are inspected, the main worktree and
    missing rows counting; the rest are not inspected, in neither `rows` nor
    `excluded`, and counted in `omitted`, {count, exactness: "exact"}. In mode
    single for --action remove, P is matched against the whole registry first
    and inspected first (match_target(): `target_rows` and `target`,
    `worktree-not-found` recorded through refuse()), exempt from the cap, so
    that the rows inspected are P's and the first 128 others (lead ruling R-53
    P-15); another row's inspection-error or unprobed marker, and the rows
    past the cap, are its non-blocking notes `inspection-incomplete` and
    `inspect-cap`. Push and delete-branch take the cap with no exemption and
    the batch's completeness (plan_completeness()). Then `selected` and
    `excluded` from gate_rows(), each selected row given `removal_args`, ["-C",
    ROOT, "worktree", "remove", PATH] with ROOT the command directory and PATH
    the registry's raw bytes (design D9); `completeness` and `apply_allowed`
    (false for every report); `digest` (plan_digest()); `planning_probes`, the
    Git children other than removals that this invocation ran to build it, the
    F + W + E of the estimate (research.md R8); and `report`, the baseline
    report built from the same rows, which the first bodies of
    confirm_removal(), apply_removals() and push_or_delete() read until the
    apply and push lanes replace them. Interim until T066 (lead ruling R-56
    Q-17): an unstarted branch is selectable. A report above 128 rows is
    T101's, and the limit of 16 counting P alone T100's."""
    plan = Plan(repo, run)
    root = repo["root"]
    evidence = plan.evidence = repo.get("evidence")  # the resolution's: row 3 runs once (R-71 (b))
    if evidence is None:
        evidence = plan.evidence = inspect_repository(root, run)
        identity = evidence["identity"]
        try:
            toplevel = identity is not None and _realpath(os.fsencode(root)) == evidence["toplevel"]
        except EvidenceError:
            toplevel = False
        if not toplevel or (identity["root"] is None and not evidence["errors"]):
            raise Refused(f"Cannot inspect Git repository at {root}")
    identity = evidence["identity"]
    plan.repository = repository_object(identity)
    refusal = evidence["merge_target_refusal"]
    if refusal is not None:
        if refusal.context is None:
            refusal.context = {"repository": plan.repository}
        raise refusal
    target = evidence["merge_target"]
    if target is not None:
        plan.merge_target = {key: target[key] for key in MERGE_TARGET_KEYS}
        plan.notes.extend(target.get("notes") or ())
    # The registry's entries that are rows, as worktree_rows() builds them
    # (D8), in canonical order: the main worktree first, then raw path bytes.
    registry, common_first, entries = evidence["records"] or [], evidence["first_is_common_dir"], []
    for index, record in enumerate(registry):
        if index == 0 and (record["bare"] or (common_first and identity["root"] is None)):
            continue
        entries.append((identity["root"] if index == 0 and common_first else record["path"], record))
    entries.sort(key=lambda entry: (entry[1] is not registry[0], entry[0]))
    cap = LIMITS["worktree_rows"][plan.mode]
    named = plan.mode == "single" and plan.action == "remove"
    plan.target_rows, matched, path, exempt = [], (), None, True
    if named:
        matched, path, exempt = match_target(plan, run, entries, cap)
    own = {id(record) for _, record in matched}
    others = [record for _, record in entries if id(record) not in own]
    room = cap if exempt else max(0, cap - len(matched))  # an undecided P takes its rows from the cap
    rows = list(plan.target_rows)
    if others[:room]:
        rows += worktree_rows(evidence, run, records=others[:room])
    plan.omitted = {"count": max(0, len(others) - room), "exactness": "exact"}
    plan.rows = sorted(rows, key=lambda row: (not row.main, row.raw_path))
    plan.selected, plan.excluded = gate_rows(plan.rows, plan, run)
    command_dir = identity["root"] if identity["root"] is not None else os.fsencode(root)
    for row in plan.selected:
        row.removal_args = ["-C", command_dir, "worktree", "remove", row.raw_path]
    if named:
        shown = human_path(plan.target.raw_path if plan.target is not None else path)
        own = {id(row) for row in plan.target_rows}
        unread = sum(1 for row in plan.rows if id(row) not in own and row_incomplete(row))
        if unread:
            plan.notes.append({"code": "inspection-incomplete",
                               "message": TEXT["note_inspection_incomplete"].format(K=unread, PATH=shown)})
        if plan.omitted["count"]:
            plan.notes.append({"code": "inspect-cap", "message": TEXT["note_inspect_cap"].format(
                K=plan.omitted["count"], M=cap, PATH=shown)})
    codes = plan_completeness(plan)
    plan.completeness = "incomplete" if codes else "complete"
    plan.apply_allowed = plan.mode != "report" and not codes and not plan.refusals
    plan.digest = plan_digest(plan)
    plan.planning_probes = run.probes
    plan.report = {"root": str(root), "target_branch": target and target["name"],
                   "tracking_freshness": TRACKING_FRESHNESS, "worktrees": plan.rows}
    return plan
# endregion plan

# region gates
# The ten gates of FR-020 (T050; design D10, D12 and D13; data-model.md,
# "Gate"; lead rulings R-56 Q-6 and R-67 (a)). A row is selected only when it
# passes every gate, and an excluded row's reason is its first failing gate:
# 1 main-worktree, 2 unsupported-path-bytes, 3 registration-mismatch (region
# index), 4 locked-worktree, 5 the classification when it is not
# merged-removable, 6 not-requested, 7 unstarted-branch or reflog-unavailable
# (region reflog), 8 deferred-target-cap, 9 contains-submodule and 10
# hidden-local-state (region index). Gates 1 to 7 are per-row functions,
# gate(row, plan, run) returning the reason or None, each free to set the row's
# `errors`, set its class to inspection-error or set its unprobed marker; gate 8
# takes the rows that passed gates 1 to 7 together; gates 9 and 10 run only for
# the rows gate 8 takes. Every excluded row carries the reason its failing gate
# returned, never null (R-67 (a)).


def main_worktree_gate(row, plan, run):
    """Gate 1: `main-worktree` for the main worktree, which is never removed."""
    return "main-worktree" if row.main else None


def path_bytes_gate(row, plan, run):
    """Gate 2: `unsupported-path-bytes` for a path that is not valid UTF-8."""
    return None if row["path_valid_utf8"] else "unsupported-path-bytes"


def locked_gate(row, plan, run):
    """Gate 4: `locked-worktree` for a row whose registry record is locked."""
    return "locked-worktree" if row["locked"] else None


def class_gate(row, plan, run):
    """Gate 5: the row's classification when it is not `merged-removable`; a
    row whose evidence was not established is excluded here as
    `inspection-error`, and one whose registration was never read by its class
    (lead ruling R-53 P-16)."""
    classification = row["classification"]
    return None if classification == "merged-removable" else classification


def not_requested_gate(row, plan, run):
    """Gate 6: `not-requested` in mode single for a row other than P
    (plan.target), which has passed gates 1 to 5. Where P names no single row
    (plan.target None), every such row is not requested, so nothing is
    selected."""
    return "not-requested" if plan.mode == "single" and row is not plan.target else None


def row_gates():
    """The per-row gates 1 to 7 in FR-020's order, one tuple of functions,
    each gate(row, plan, run) returning its reason or None. The tuple is made
    when called, so that the bodies T066 and T067 give the stubs of regions
    reflog and index are the ones run."""
    return (main_worktree_gate, path_bytes_gate, registration_gate, locked_gate, class_gate,
            not_requested_gate, reflog_gate)


def deferral_gate(candidates, plan):
    """Gate 8, `deferred-target-cap` (T100 fills; D12, FR-032): candidates
    are the rows that passed gates 1 to 7, in canonical order. Returns (taken,
    deferred): taken, the first LIMITS["targets"] (16) of them, which go on to
    the index gates (9 and 10); deferred, the rest, which gate_rows() excludes
    as `deferred-target-cap` with no index probe. A row an index gate then
    excludes keeps its place among the 16. It runs no child. This stub takes
    every candidate and defers none."""
    return list(candidates), []


def first_failing_gate(row, gates, plan, run):
    """The reason of the first of gates that row fails, or None."""
    for gate in gates:
        reason = gate(row, plan, run)
        if reason is not None:
            return reason
    return None


def gate_rows(rows, plan, run):
    """The gates of FR-020 over rows, plan's rows in canonical order (data-model.md,
    "Gate"): gates 1 to 7 per row (row_gates()), then gate 8 over the rows that
    passed them (deferral_gate()), then gates 9 and 10 (index_gates()) for the
    rows gate 8 took. Returns (selected, excluded): selected, the rows that
    passed every gate; excluded, (row, reason) pairs, reason the first failing
    gate's, never None (R-67 (a)); both by raw path bytes."""
    excluded, candidates = [], []
    for row in rows:
        reason = first_failing_gate(row, row_gates(), plan, run)
        if reason is None:
            candidates.append(row)
        else:
            excluded.append((row, reason))
    taken, deferred = deferral_gate(candidates, plan)
    excluded += [(row, "deferred-target-cap") for row in deferred]
    selected = []
    for row in taken:
        reason = index_gates(row, plan, run)
        if reason is None:
            selected.append(row)
        else:
            excluded.append((row, reason))
    selected.sort(key=lambda row: row.raw_path)
    excluded.sort(key=lambda item: item[0].raw_path)
    return selected, excluded


def next_step(reason):
    """D18's next step for an exclusion reason: NEXT_STEPS's, else the class's
    recommendation (RECOMMENDATIONS); None for a reason with neither."""
    return NEXT_STEPS.get(reason) or RECOMMENDATIONS.get(reason)


def target_refusal(row, reason):
    """The `target-excluded` refusal of P's row, excluded by reason (FR-013;
    design D18; lead rulings R-58 (a) and R-59 D9), its message in the
    baseline's precedence (project:715-718 at 961c405): the current worktree's
    when P is current, else the class's when P's class is not
    merged-removable, which keeps its wording and has no next step, else the
    gate's, `Worktree is excluded: REASON; NEXT STEP`."""
    if row.get("current"):
        message = TEXT["target_excluded_current"]
    elif row["classification"] != "merged-removable":
        message = TEXT["target_excluded_class"].format(CLASS=row["classification"])
    else:
        message = TEXT["target_excluded_gate"].format(REASON=reason, NEXT_STEP=next_step(reason) or "")
    return Refused(message, code="target-excluded", path=row.raw_path, reason=reason)
# endregion gates

# region reflog
# Gate 7 from the branch's reflog (T066; design D10; data-model.md, "Reflog
# anchor and movement"; FR-021, FR-022; lead rulings R-33, R-53 P-22, R-54 X-1,
# R-56 Q-6 and R-67 (a)). read_reflog() makes the one bounded filesystem call;
# reflog_outcome() decides from the bytes read and does no I/O.

# One reflog line: `<old> <new> <identity> <time> <zone>`, then a tab and the
# message when the command wrote one; `git update-ref` without -m writes neither
# (D10). The identity ends at its first `>`, as Git's own reader takes it.
REFLOG_LINE = re.compile(
    rb"(?P<old>[0-9a-f]{40}|[0-9a-f]{64}) (?P<new>[0-9a-f]{40}|[0-9a-f]{64}) "
    rb"[^\n]*?> [0-9]+ [+-][0-9]{4}(?:\t(?P<message>[^\n]*))?")
# The messages that anchor a reflog besides an all-zeros old object (D10):
# `worktree add -b`, `branch` and `checkout -b` write the first; `worktree add
# -B`, `branch -f` and `checkout -B` on an existing branch the second.
REFLOG_ANCHOR_MESSAGES = (b"branch: Created from", b"branch: Reset to")


def reflog_path(common_dir, branch):
    """The branch's reflog, logs/refs/heads/<branch> under common_dir, as
    bytes: common_dir the common directory's bytes, branch the row's short
    name, whose text encodes back to its bytes with surrogateescape; each `/`
    of the name is a directory level."""
    name = branch.encode("utf-8", "surrogateescape") if isinstance(branch, str) else branch
    return os.path.join(common_dir, b"logs", b"refs", b"heads") + b"/" + name


def _null_object(name):
    return not name.strip(b"0")


def reflog_outcome(data, head):
    """Gate 7's decision from the bytes a reflog read gave, a pure decider
    (lead ruling R-54 X-1; D10; data-model.md, "Reflog anchor and movement"):
    `reflog-unavailable`, `unstarted-branch`, or None when the gate passes.
    data is what the read returned, at most LIMITS["reflog_bytes"]; head the
    row's head, its object name as text or bytes, or None.

    Empty data, data that reached the 64 KiB bound (65,536 bytes read, R-33),
    a line that is not `<old> <new> ...` (a truncated last line, one with no
    line feed, included: lead ruling R-53 P-22), or a last entry whose new
    object is not the head: `reflog-unavailable`, since the entries cannot
    decide or do not describe the branch. Otherwise the anchor is the last
    entry whose old object is all zeros or whose message begins `branch:
    Created from` or `branch: Reset to`; a movement is an entry after the
    anchor, or any entry when none survives, whose old and new objects are
    non-zero and differ (a rename's are equal). A movement passes (None); an
    anchor with no movement after it, its new object the head, is
    `unstarted-branch`; anything else, no anchor and no movement included, is
    `reflog-unavailable`."""
    if isinstance(head, str):
        head = head.encode("utf-8", "surrogateescape")
    if (head is None or not data or len(data) >= LIMITS["reflog_bytes"]
            or not data.endswith(b"\n")):
        return "reflog-unavailable"
    entries = []
    for line in data[:-1].split(b"\n"):
        match = REFLOG_LINE.fullmatch(line)
        if match is None or not len(match["old"]) == len(match["new"]) == len(head):
            return "reflog-unavailable"
        entries.append((match["old"], match["new"], match["message"] or b""))
    if entries[-1][1] != head:
        return "reflog-unavailable"
    anchor = None
    for index, (old, new, message) in enumerate(entries):
        if _null_object(old) or message.startswith(REFLOG_ANCHOR_MESSAGES):
            anchor = index
    later = entries if anchor is None else entries[anchor + 1:]
    if any(not _null_object(old) and not _null_object(new) and old != new for old, new, _ in later):
        return None
    if anchor is not None and entries[anchor][1] == head:
        return "unstarted-branch"
    return "reflog-unavailable"


def read_reflog(common_dir, branch, head, run):
    """Read the branch's reflog (reflog_path()) by one fs_call() of at most
    LIMITS["reflog_bytes"] (64 KiB) and decide gate 7 from it (D10, the
    project-clean delta's outcome rule; lead ruling R-56 Q-6): (reason, error),
    error a row error or None. The read asks for no more than 65,536 bytes and
    needs no fstat (R-33); it is never a Git child. ENOENT or ENOTDIR is
    (`reflog-unavailable`, None); any other OSError (`inspection-error`, its
    `os-error` for OPERATION read); a call cut at its budget or the deadline
    (`reflog-unavailable`, its `probe-timeout` or `deadline-exceeded`), the
    row to be left unprobed; and bytes read, (reflog_outcome(data, head),
    None). run is the invocation in force, whose per-child budget fs_call()
    gives the read and the timeout message names, as _fs() does; Interrupted
    passes up."""
    path = reflog_path(common_dir, branch)
    budget, _ = current_invocation().child_budget("probe")
    try:
        data = fs_call(_read_head, path, LIMITS["reflog_bytes"])
    except OSError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return "reflog-unavailable", None
        return "inspection-error", os_error("read", exc)
    if isinstance(data, DriverOutcome):
        return "reflog-unavailable", probe_error(data, "read", budget)
    return reflog_outcome(data, head), None


def reflog_gate(row, plan, run):
    """Gate 7, `unstarted-branch` or `reflog-unavailable` (T066 fills; D10,
    FR-021, FR-022; lead rulings R-56 Q-6 and R-67 (a)).

    Contract: reflog_gate(row, plan, run) -> reason or None, for a row that
    passed gates 1 to 6, in every mode. It reads the common directory from the
    plan (plan.evidence["identity"]["common_dir"]) and the branch and head from
    the row, so that it can mark the row, and wraps
    read_reflog(common_dir, branch, head, run): one fs_call() read of
    logs/refs/heads/<branch> under the common directory, at most 64 KiB, never
    a Git child. It returns `unstarted-branch` when an anchor survives with no
    movement after it, its new object the head; `reflog-unavailable` where the
    reflog cannot decide it (missing, empty, read to its 64 KiB bound, entries
    that cannot decide, or a last entry whose new object is not the head);
    `inspection-error`, after putting an `os-error` in row["errors"] and
    setting row["classification"] to inspection-error, for any other read
    error; and None when a movement survives. A read not finished within the
    filesystem budget returns `reflog-unavailable` AND sets row.unprobed, the
    marker's only setter, which plan_completeness() reads as
    inspection-incomplete; its `probe-timeout` or `deadline-exceeded` goes in
    row["errors"], as the delta records for every filesystem call cut at its
    budget. The inspection-error row also takes that class's
    recommendation, as classify() pairs them."""
    common_dir = plan.evidence["identity"]["common_dir"]
    reason, error = read_reflog(common_dir, row["branch"], row["head"], run)
    if error is not None:
        row["errors"].append(error)
        if reason == "inspection-error":
            row["classification"] = "inspection-error"
            row["recommendation"] = RECOMMENDATIONS["inspection-error"]
        else:
            row.unprobed = True
    return reason
# endregion reflog

# region index
def registration_gate(row, plan, run):
    """Gate 3, `registration-mismatch` (T067 fills; D7, FR-055; lead ruling
    R-53 P-16).

    Contract: registration_gate(row, plan, run) -> "registration-mismatch" or
    None. It fails only when row.registered is False, the two-way
    registration read and found to disagree, a path two registry entries share
    included; a row whose registration was never read (registered None, a
    present: false row among them) passes, and gate 5 excludes it by its class.
    It runs no child and reads no file. Such a row is already
    inspection-error by its evidence (classify(): no status probe ran), so
    the gate changes nothing on it."""
    return "registration-mismatch" if row.registered is False else None


# The hidden-state probe of a worktree, after its `-C WORKTREE` (design D2 and
# D11; contracts/project-clean.md, "Git children", the hidden-state row).
HIDDEN_STATE_PROBE = ("ls-files", "-v", "--stage", "-z")


def modules_check(common_dir, admin_id, run):
    """Gate 9's admin-directory half for one target (T067; D12, FR-023; lead
    rulings R-53 P-21 and R-56 Q-6), shared with US4's revalidation (T084).

    Signature: modules_check(common_dir, admin_id, run) -> (result,
    row_error). common_dir is the repository's common directory and admin_id
    the target's admin directory name (WorktreeRow.admin_id), both bytes; run
    is the Invocation in force, whose per-child budget bounds the call. One
    fs_call() lstat of `<common_dir>/worktrees/<admin_id>/modules` (through
    _fs(), OPERATION `lstat`), never a Git child:

    - ENOENT or ENOTDIR, no entry: (None, None), the gate passes;
    - an entry of any type: ("contains-submodule", None);
    - any other error: (None, an `os-error` row error);
    - the call cut at its budget: (None, a `probe-timeout` row error), or
      `deadline-exceeded` where the work deadline was the limit.

    A row error means the check decided nothing; the caller makes the row
    inspection-error, since a null flag never passes."""
    path = os.path.join(common_dir, b"worktrees", admin_id, b"modules")
    try:
        _fs("lstat", os.lstat, path)
    except EvidenceError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return None, None
        return None, exc.error
    return "contains-submodule", None


def hidden_state_probe(path, run):
    """Gates 9's index half and gate 10 for one target (T067; D2, D11, D12,
    FR-023; lead ruling R-56 Q-6), shared with US4's revalidation (T084).

    Signature: hidden_state_probe(path, run) -> (result, row_error). path is
    the target's worktree, the row's raw path bytes; run is the Invocation
    that bounds and counts the child. One Git child of kind `hidden`,
    git_argv("hidden", ["-C", path, "ls-files", "-v", "--stage", "-z"]): the
    two status pins, then the protocol pins, run through run_bounded() with
    HiddenStateParser, so that the index read is the worktree's own:

    - a gitlink (mode 160000), where the parser stops at its bound:
      ("contains-submodule", None);
    - else an entry flagged assume-unchanged (a lowercase tag) or
      skip-worktree (`S`): ("hidden-local-state", None);
    - else (None, None), the gates pass;
    - a child that failed, timed out or met the deadline: (None, its row
      error), `probe-failed`, `probe-timeout` or `deadline-exceeded` by T024's
      map as built (OUTCOME_ERRORS, probe_error()), OPERATION `git ls-files`.

    Interrupted passes, as from any probe."""
    outcome, error = _git(run, path, list(HIDDEN_STATE_PROBE), "ls-files", HiddenStateParser(), kind="hidden")
    if error is not None:
        return None, error
    if outcome.result["gitlink"]:
        return "contains-submodule", None
    if outcome.result["hidden"]:
        return "hidden-local-state", None
    return None, None


def index_gates(row, plan, run):
    """Gates 9 and 10, `contains-submodule` and `hidden-local-state` (T067
    fills; D12, FR-023; lead ruling R-56 Q-6).

    Contract: index_gates(row, plan, run) -> reason or None, for a row that
    passed gates 1 to 8 only. Through the per-target helpers T067 adds,
    modules_check(common_dir, admin_id, run) and hidden_state_probe(path, run),
    each (result, row_error): `contains-submodule` for a `modules` entry in the
    row's admin directory or a gitlink in its own index; `hidden-local-state`
    for an index entry flagged assume-unchanged or skip-worktree; and
    `inspection-error`, after putting the check's row error in row["errors"]
    and setting row["classification"] to inspection-error, for a check that
    failed, timed out or met the deadline, since a null flag never passes.

    The common directory is the plan's (plan.evidence["identity"]). The
    `modules` check runs first, being one filesystem call; the hidden-state
    probe runs only when it passed, so that the first check to fail or to be
    undecided names the row's reason. A row whose admin directory or common
    directory is not established cannot be checked and is inspection-error,
    with no read made: a defensive branch, since every row past gate 5 is a
    present linked worktree whose registration holds."""
    identity = plan.evidence["identity"] if plan.evidence else None
    common_dir = identity["common_dir"] if identity else None
    if common_dir is None or row.admin_id is None:
        return _index_undecided(row, None)
    reason, error = modules_check(common_dir, row.admin_id, run)
    if reason is None and error is None:
        reason, error = hidden_state_probe(row.raw_path, run)
    if error is not None:
        return _index_undecided(row, error)
    return reason


def _index_undecided(row, error):
    """Make row inspection-error for an index gate that decided nothing,
    error its row error (None when no read was made); return that reason."""
    if error is not None:
        row["errors"].append(error)
    row["classification"], row["recommendation"] = "inspection-error", RECOMMENDATIONS["inspection-error"]
    return "inspection-error"
# endregion index

# region preview
def print_plan(plan, run):
    """Print the plan as the run shows it (T052 fills; contracts/project-clean.md,
    "Streams" and "Human output"; lead ruling R-56 Q-3 and Q-11). The pipeline
    calls it once after check_plan()'s decision, with run.status the status
    the run stops at (None while it goes on), and once more where a removal
    run stops at the question (confirm_removal() returned 2). The human plan
    goes to run.human through say(), on the first call only (plan.printed);
    plain --json prints none, and push and delete-branch print nothing here,
    keeping their `Cleanup action:` output. Under --json the plan envelope goes
    to standard output through write_document() on the call where the run
    stops before the apply phase, so one document is written. The pipeline
    writes `REFUSED:` itself.

    What prints (T052; lead rulings R-56 Q-11, R-57 H1, R-59 D2 and D8, R-62
    (b) and R-67 (a)): a report, the baseline layout with each null shown as
    `unknown` (report_lines()); an --all-safe plan, and a single-mode plan for
    --action remove, D18's preview layout (preview_lines()); push and
    delete-branch, nothing. `Merge target: NAME (SOURCE)` prints in every
    mode, and every path and branch goes through human_path(). This replaces
    print_clean_report() for `clean`."""
    if plan.action in ("push", "delete-branch"):
        return
    json_output, apply = getattr(run.args, "json", False), getattr(run.args, "apply", False)
    if not plan.printed:
        plan.printed = True
        if apply or not json_output:
            for line in plan_lines(plan):
                say(run, line)
    if json_output and run.status is not None:
        write_document(plan_document(plan))


# The order of the Excluded groups (contracts/project-clean.md, "Human
# output"): the gates in FR-020's order, the classes of gate 5 in the ladder's
# order (RECOMMENDATIONS's), then the later gates; a reason not listed follows.
EXCLUDED_GROUP_ORDER = ("main-worktree", "unsupported-path-bytes", "registration-mismatch", "locked-worktree",
                        *RECOMMENDATIONS, "not-requested", "unstarted-branch", "reflog-unavailable",
                        "deferred-target-cap", "contains-submodule", "hidden-local-state")


def _shown(value):
    """A report value as the baseline prints it, null as `unknown`."""
    return "unknown" if value is None else str(value)


def plan_lines(plan):
    """The human plan, one string per line: the baseline header, `Cleanup plan
    for ROOT`, then `Merge target: NAME (SOURCE)` (`unknown` while none is
    established) and `Freshness:`, then the report's rows or the preview."""
    identity = plan.evidence["identity"] if plan.evidence else None
    root = identity["root"] if identity and identity["root"] is not None else os.fsencode(plan.root)
    target = plan.merge_target
    lines = [f"Cleanup plan for {human_path(root)}",
             TEXT["merge_target_line"].format(NAME=human_path(target["name"]) if target else "unknown",
                                              SOURCE=target["source"] if target else "unknown"),
             f"Freshness: {TRACKING_FRESHNESS}"]
    return lines + (report_lines(plan) if plan.mode == "report" else preview_lines(plan))


def report_lines(plan):
    """The baseline report's rows (project:631-637 at 961c405), in canonical
    order: `CLASS: PATH [BRANCH] dirty=D; upstream=U; DELTA; merged=M`, then
    the recommendation; a null dirty, merge answer or count shown as
    `unknown`, and no upstream configured as `none`, as the baseline prints it.
    T101 adds the D14 lines."""
    lines = []
    for row in plan.rows:
        upstream = human_path(row["upstream"]) if row.get("upstream") else "none"
        ahead, behind = row.get("ahead"), row.get("behind")
        delta = "unknown" if ahead is None or behind is None else f"ahead={ahead}, behind={behind}"
        lines.append(f"{row['classification'].upper()}: {human_path(row.raw_path)} [{human_path(row['branch'])}] "
                     f"dirty={_shown(row.get('dirty'))}; upstream={upstream}; {delta}; "
                     f"merged={_shown(row.get('merged_into_target'))}")
        lines.append(f"  {row['recommendation']}")
    return lines


def ignored_suffix(row):
    """D18's `: N ignored; first: SAMPLE` of an ignored-local-files row,
    `at least N` when the probe stopped at its bound; empty with no sample."""
    samples = row.status["ignored_samples"] if row.status else [
        os.fsencode(sample["path"]) for sample in row.get("ignored_samples") or ()]
    if not samples or row.get("ignored_files") is None:
        return ""
    key = "ignored_suffix_truncated" if row.get("ignored_files_truncated") else "ignored_suffix"
    return TEXT[key].format(N=row["ignored_files"], SAMPLE=human_path(samples[0]))


def preview_lines(plan):
    """D18's preview layout (design.md D18; contracts/project-clean.md, "Human
    output"): `Selected (N):` and one `  remove PATH [BRANCH]` per selected row;
    `Excluded (M):` and, per reason in EXCLUDED_GROUP_ORDER, `  REASON (K):
    NEXT STEP` (next_step()) over one `    PATH [BRANCH]` per row, an
    ignored-local-files row adding its count and first sample; `No eligible
    worktrees` when a complete --all-safe plan that carries no refusal selects
    nothing; and the residual-window line when anything is selected. Rows go
    in raw path byte order. In mode single, P is the one selected row and the
    other eligible rows form the `not-requested` group."""
    lines = []
    selected = plan.selected or []
    if selected:
        lines.append(TEXT["selected_heading"].format(N=len(selected)))
        lines += [TEXT["selected_row"].format(PATH=human_path(row.raw_path), BRANCH=human_path(row["branch"]))
                  for row in selected]
    if plan.excluded:
        groups = {}
        for row, reason in plan.excluded:
            groups.setdefault(reason, []).append(row)
        order = [reason for reason in EXCLUDED_GROUP_ORDER if reason in groups]
        order += [reason for reason in groups if reason not in EXCLUDED_GROUP_ORDER]
        lines.append(TEXT["excluded_heading"].format(M=len(plan.excluded)))
        for reason in order:
            rows = groups[reason]
            lines.append(TEXT["excluded_group"].format(REASON=reason, K=len(rows),
                                                       NEXT_STEP=next_step(reason) or ""))
            for row in rows:
                suffix = ignored_suffix(row) if reason == "ignored-local-files" else ""
                lines.append(TEXT["excluded_row"].format(PATH=human_path(row.raw_path),
                                                         BRANCH=human_path(row["branch"])) + suffix)
    if plan.mode == "all-safe" and not selected and plan.completeness == "complete" and not plan.refusals:
        lines.append(TEXT["empty_line"])
    if selected:
        lines.append(TEXT["residual_window_line"])
    return lines
# endregion preview

# region apply
def confirm_removal(plan, run):
    """Accept the plan for removal (T054; FR-026; research.md R3; lead ruling
    R-56 Q-3): --yes accepts the fresh plan without asking; otherwise
    ask_removal(), looked up by its global name since T046 patches it there,
    asks D18's question under raising_signals(), swapped in around the
    question alone, with the clock paused, and only `yes`, its surrounding
    whitespace stripped, accepts. Returns None when the plan is accepted. Any
    other answer records `cancelled`, with the baseline's message, through
    refuse() and returns 2, never raising. End of input and a signal at the
    question pass to main() (EOFError, KeyboardInterrupt, Terminated). The
    pipeline then reads the slot, sets phase `apply` and calls
    apply_removals()."""
    if getattr(run.args, "yes", False):
        return None
    if ask_removal(plan, run).strip() == "yes":
        return None
    return refuse(plan, Refused("Cancelled; no command was run.", code="cancelled"), run)


def ask_removal(plan, run):
    """The removal question (T054; FR-026, design D18; research.md R3): write
    D18's question for the plan's selected targets, `question_one` for one, to
    the human stream (run.human, standard error under --apply --json) through
    say(), which flushes it; then read one line by input() given no prompt, so
    that standard output never carries the question; and return that line as
    read, which confirm_removal() strips and compares with `yes`.

    The question alone runs under raising_signals() (D1, D15; research.md R4)
    with the Invocation's clock paused (run.pause(), FR-031): SIGINT raises
    KeyboardInterrupt and SIGTERM or SIGHUP Terminated, and end of input
    raises EOFError, each passing to main(), which prints `Cancelled.` and
    exits 130, 143 or 129, with no JSON document. A question that could not be
    written (say() recorded the failed write) is not answered: nothing is read
    and "" is returned, so the plan is not accepted, and the pipeline's check
    after the question ends the run as `internal-error` (lead ruling R-55).
    confirm_removal() looks this function up by its global name, so a test
    patches it there (T046; lead ruling R-56)."""
    count = len(plan.selected)
    question = TEXT["question_one"] if count == 1 else TEXT["question"].format(N=count)
    run.pause()
    try:
        with raising_signals():
            say(run, question)
            if getattr(run, "write_error", None) is not None:
                return ""
            return input()
    finally:
        run.resume()


class Target(dict):
    """One selected target of the apply phase (data-model.md, "Target result
    and reconciliation record"): as a dict, the target result's values in
    TARGET_RESULT_KEYS's order as project keeps them, `path_valid_utf8` aside,
    which result_document() derives: `path`, the registry's raw path bytes;
    `branch` and `planned_sha`, the planned row's branch and head; `stage`,
    `pending` until it is final, and its `reason`; `notes`, codes; `command`,
    the planned argument vector, git_argv("removal", removal_args), held
    whether or not anything ran; `exit_status`; `probes_performed`; and
    `reconciliation`, the record, or None while none was read. As attributes,
    what no document writes: `row`, the plan's selected WorktreeRow;
    `removal_args`, its removal's arguments (region dispatcher, Plan); `root`,
    the command directory; and `identity`, the plan's repository identity
    {root, common_dir, dev, ino}, which the rescan re-establishes first."""

    row = removal_args = root = identity = None


def make_target(plan, row):
    """The pending Target of row, one of plan.selected (T056; design D9): its
    command is the plan's own argument vector, git_argv("removal",
    row.removal_args), the vector operation.argv shows (lead ruling R-56)."""
    target = Target(path=row.raw_path, branch=row["branch"], planned_sha=row["head"], stage="pending",
                    reason=None, notes=[], command=git_argv("removal", row.removal_args), exit_status=None,
                    probes_performed=0, reconciliation=None)
    target.row, target.removal_args, target.root = row, list(row.removal_args), plan.root
    target.identity = None if plan.evidence is None else plan.evidence["identity"]
    return target


# The planned values revalidate() compares on the re-read row (T055): the
# baseline signature fields (cleanup_signature(), project:494-497 at 961c405)
# and `locked` (design D7).
REVALIDATED_FIELDS = ("path", "branch", "head", "present", "dirty", "ignored_files", "upstream", "ahead",
                      "behind", "remote_present", "merged_into_target", "current", "classification",
                      "locked")
IDENTITY_FIELDS = ("root", "common_dir", "dev", "ino")


def reconciliation_record(registry_entry_present, path_present, branch_present, branch_sha):
    """A reconciliation record in RECONCILIATION_KEYS's order (data-model.md,
    "Target result and reconciliation record"): each value true, false or
    null, null meaning not established; `reconciled` is true only when the
    three presence fields are non-null and `branch_sha` is non-null whenever
    `branch_present` is true. A pure function."""
    reconciled = (None not in (registry_entry_present, path_present, branch_present)
                  and (branch_sha is not None or not branch_present))
    return {"registry_entry_present": registry_entry_present, "path_present": path_present,
            "branch_present": branch_present, "branch_sha": branch_sha, "reconciled": reconciled}


def path_presence(raw):
    """Whether the planned path is present, by one lstat through fs_call()
    (design D6; data-model.md, "Target result and reconciliation record"):
    true when it succeeds, false only on ENOENT or ENOTDIR, and null on any
    other error or when the call is cut at its budget."""
    try:
        found = fs_call(os.lstat, raw)
    except OSError as exc:
        found = exc
    if isinstance(found, DriverOutcome):
        return None
    return presence_from_lstat(found)[0]


def _branch_ref(target):
    return b"refs/heads/" + target["branch"].encode("utf-8", "surrogateescape")


def _branch_evidence(target, refs):
    """(branch_present, branch_sha) of target's branch in refs, RefParser's
    records, or (None, None) when the listing did not run or failed."""
    if refs is None:
        return None, None
    for ref in refs:
        if ref["refname"] == _branch_ref(target):
            return True, ref["objectname"]
    return False, None


def revalidate(plan, target, run):
    """Revalidate target after the confirmation, before its removal (T055,
    this phase's body; design D7, FR-046; lead ruling R-56 Q-13): read the
    repository afresh through the evidence model, inspect_repository(root,
    run, refresh=True), never its memo, which would hand back the planned
    evidence, and rebuild the target's row by worktree_rows(); then compare
    the repository identity, the merge target {name, source, sha} and the
    row's REVALIDATED_FIELDS with the plan's. A re-read that fails, a row that
    is gone, and any difference refuse the target with `state-changed`. T084
    replaces this body with D7's targeted check and its other reasons.

    Sets target["probes_performed"], the Git children this revalidation ran,
    and returns None when nothing differs, or (reason, reconciliation): the
    record from that same re-read, its registry and branch fields null where
    the listing did not run or the repository identity differs, and the
    path's presence the re-read row's, or one lstat of the planned path where
    no row was rebuilt."""
    before = run.probes
    raw = target["path"]
    repo = inspect_repository(plan.root, run, refresh=True)
    planned = None if plan.evidence is None else plan.evidence["identity"]
    identity = repo["identity"]
    same_repository = (identity is not None and planned is not None
                       and all(identity[key] == planned[key] for key in IDENTITY_FIELDS))
    records = repo["records"] if same_repository else None
    matches = [record for record in records or () if record["path"] == raw]
    rows = worktree_rows(repo, run, records=matches[:1]) if matches else []
    row = rows[0] if rows else None
    merge_target = repo["merge_target"]
    changed = (not same_repository or bool(repo["errors"]) or repo["merge_target_refusal"] is not None
               or merge_target is None or plan.merge_target is None
               or any(merge_target[key] != plan.merge_target[key] for key in MERGE_TARGET_KEYS)
               or row is None or any(row.get(field) != target.row.get(field) for field in REVALIDATED_FIELDS))
    target["probes_performed"] = run.probes - before
    if not changed:
        return None
    registry_entry_present = None if records is None else bool(matches)
    path_present = row["present"] if row is not None else path_presence(raw)
    branch_present, branch_sha = _branch_evidence(target, repo["refs"] if same_repository else None)
    return "state-changed", reconciliation_record(registry_entry_present, path_present, branch_present,
                                                  branch_sha)


def removal_exit_status(outcome):
    """A removal's `exit_status` (T045, T056; data-model.md, "Target result and
    reconciliation record"; plan review M12) from its DriverOutcome: None
    unless the child was spawned and reaped; Git's own status when it exited;
    and 128 plus the signal number when a signal ended it, whoever sent it
    (128 minus Popen's negative return code), so 137 for a child killed at the
    ceiling, as execute() reports a delegate's."""
    status = outcome.status
    if status is None:
        return None
    return status if status >= 0 else 128 - status


def run_removal(target, run):
    """Spawn target's removal and wait for it (T056; design D2 and D9,
    FR-012): a ChildHandle of kind `removal` running git_argv("removal",
    target.removal_args), the plan's own argument vector, `-C ROOT worktree
    remove PATH` with PATH the registry's raw bytes and never --force, from
    the command directory, through run_bounded(), which counts it among
    `operations`, gives it no budget, never signals it before its ceiling,
    and waits for it. Sets target["exit_status"] (removal_exit_status()) and
    returns the DriverOutcome; one that could not be spawned is outcome
    `failed` with no status."""
    outcome = run_bounded(("removal", target.removal_args, target.root), None, run)
    target["exit_status"] = removal_exit_status(outcome)
    return outcome


def rescan(target, run):
    """The rescan after target's removal child is reaped (T056; design D7;
    data-model.md, "Revalidation step and probes_performed"): it first
    re-establishes the repository identity, the identity probe (row 3) in the
    command directory and the realpath and lstat of the common directory it
    names, compared with the plan's {root, common_dir, dev, ino}; then the
    registry listing (row 4, WorktreeListParser), the ref listing (row 6,
    RefParser) and an lstat of the planned path, each through run_bounded()
    or fs_call(). Returns the reconciliation record: whether the registry
    still lists the planned path, whether the path is present, and the
    branch's presence and SHA, a value not established null. Where the
    identity cannot be re-established or differs, every field is null and
    `reconciled` false (T085 decides the stage of such a target)."""
    unknown = reconciliation_record(None, None, None, None)
    root = os.fsencode(target.root)
    values, error = identity_probe(root, run)
    planned = target.identity
    if error is not None or planned is None:
        return unknown
    try:
        found = [fs_call(os.path.realpath, values[0]), fs_call(os.path.realpath, values[1])]
        if not isinstance(found[1], DriverOutcome):
            found.append(fs_call(os.lstat, found[1]))
    except OSError:
        return unknown
    if any(isinstance(value, DriverOutcome) for value in found):
        return unknown
    toplevel, common_dir, common = found
    if (toplevel, common_dir, common.st_dev, common.st_ino) != tuple(planned[key] for key in IDENTITY_FIELDS):
        return unknown
    listing = run_bounded(("probe", ["-C", root, "worktree", "list", "--porcelain", "-z"], None),
                          WorktreeListParser(), run)
    registry_entry_present = None
    if listing.name == "complete":
        registry_entry_present = any(record["path"] == target["path"] for record in listing.result)
    refs = run_bounded(("probe", ["-C", root, "for-each-ref", "--format=" + REF_FORMAT, "refs/heads",
                                  "refs/remotes"], None), RefParser(), run)
    branch_present, branch_sha = _branch_evidence(target, refs.result if refs.name == "complete" else None)
    return reconciliation_record(registry_entry_present, path_presence(target["path"]), branch_present,
                                 branch_sha)


def decide_stage(target, outcome, reconciliation):
    """The final stage of a spawned target (T056; design D9, D15 and D19;
    data-model.md, "Target stages"), a pure function of its removal's
    DriverOutcome and the rescan's reconciliation record; returns (stage,
    reason, notes). target is the Target, whose planned branch and head the
    branch-after-removal reasons read (T085).

    - Not spawned (outcome `failed` with no status): `failed`, `spawn-error`.
    - Exited on its own, signal or not: nonzero is `failed`, `git-refused` for
      128 and `git-failed` for any other status, whatever the slot holds; 0
      is `removed` with reason null when the registry entry and the path are
      both gone, and otherwise `unknown` with `unconfirmed-removal`.
    - Cut at its ceiling, or its exit not observed (outcome `timeout`, design
      D9): the rescan alone decides, `removed` when the entry and the path are
      both gone, otherwise `unknown`, each with `removal-ceiling`, and the
      note `partially-removed` while the entry or the path remains. T092
      adds the wait around it; this function is total over the outcomes
      run_bounded() gives a removal handle."""
    gone = reconciliation["registry_entry_present"] is False and reconciliation["path_present"] is False
    if outcome.name == "timeout":
        if gone:
            return "removed", "removal-ceiling", []
        remains = reconciliation["registry_entry_present"] or reconciliation["path_present"]
        return "unknown", "removal-ceiling", ["partially-removed"] if remains else []
    if outcome.status is None:
        return "failed", "spawn-error", []
    if outcome.status != 0:
        return "failed", "git-refused" if outcome.status == 128 else "git-failed", []
    if gone:
        return "removed", None, []
    return "unknown", "unconfirmed-removal", []


def apply_removals(plan, run):
    """Remove the plan's selected worktrees (T057; design D7, D9 and D19;
    contracts/project-clean.md, "Order of a run", step 8): called in phase
    `apply`, which the pipeline sets, never this function (lead ruling R-56).
    Per selected row, in canonical order: its Target (make_target()); its
    revalidation (revalidate()), a difference refusing it; otherwise its
    removal child, spawned and waited for (run_removal()), the rescan
    (rescan()) and its stage (decide_stage()). The batch stops after the
    first target that is not a plain `removed` (reason null), and every later
    target is `not-attempted` with `batch-stopped` and no reconciliation.
    Each target's progress line prints at its final stage (print_progress()),
    then the result (print_result()), every human line through say() to
    run.human, standard error under --apply --json; under --apply --json the
    apply result record then goes to standard output through
    write_document(). After the apply phase begins every write is
    best-effort (lead ruling R-55): a failed one is recorded, never raised,
    and never changes the exit. Returns apply_exit_status(targets,
    run.signal), D19's table, whose first row reads the slot. T093 adds the
    slot's seams, the reserve and the handling of an exception; T084 and T085
    the targeted revalidation and rescan."""
    targets = [make_target(plan, row) for row in plan.selected or ()]
    stopped = False
    for target in targets:
        if stopped:
            target.update(stage="not-attempted", reason="batch-stopped", reconciliation=None)
        else:
            refused = revalidate(plan, target, run)
            if refused is not None:
                reason, reconciliation = refused
                target.update(stage="refused", reason=reason, reconciliation=reconciliation)
            else:
                outcome = run_removal(target, run)
                reconciliation = rescan(target, run)
                stage, reason, notes = decide_stage(target, outcome, reconciliation)
                target.update(stage=stage, reason=reason, notes=list(notes), reconciliation=reconciliation)
            stopped = not (target["stage"] == "removed" and target["reason"] is None)
        print_progress(target, run)
    status = apply_exit_status(targets, run.signal)
    print_result(plan, targets, run)
    if getattr(run.args, "json", False):
        estimated = getattr(plan, "planning_probes", 0) + 5 * len(targets) + 3
        write_document(result_document(
            targets, status, repository=getattr(plan, "repository", None), merge_target=plan.merge_target,
            plan_digest=plan.digest, probes={"estimated": estimated, "performed": run.probes},
            operations={"estimated": len(targets), "performed": run.operations}))
    return status
# endregion apply

# region result
# The end of an apply (T045, T057; design D18 and D19; data-model.md, "Target
# stages", "Exit statuses" and "Apply result record"; contracts/project-clean.md,
# "Human output", "Apply result record" and "Exit statuses"; lead ruling R-56
# Q-8 to Q-10). A target is a mapping of the values a target result holds
# (region apply, Target): these functions read it and never mutate it.

# The reasons that send a run with --apply to D19's second row, exit 1: the
# deadline stopping work after the apply phase began, and the hard ceiling.
EXIT_ONE_REASONS = ("deadline-exceeded", "removal-ceiling")


def apply_exit_status(targets, signum):
    """The exit status of a run with --apply by D19's table (FR-037; lead
    ruling R-56 Q-8), its first matching row: signum, the slot's first
    signal, gives 128 plus its number (130, 143 or 129); then 1 when any
    target is `unknown`, or its reason is `removal-ceiling` or, on a
    `not-attempted` target, `deadline-exceeded`; then the status of the first
    target `failed` with `git-refused` or `git-failed`, Git's own, passed
    through even when it equals one of project's (OQ-25); then 2 for a
    `refused` target, a `removed` one with a branch-after-removal reason, or
    `failed` with `spawn-error`; then 0 when every target is `removed` with
    reason null, or none was selected. A list no row matches, which the apply
    phase never builds (a target still `pending`, or `not-attempted` with
    nothing that stopped the run), fails closed with 2."""
    if signum is not None:
        return 128 + int(signum)
    if any(target["stage"] == "unknown" or target["reason"] in EXIT_ONE_REASONS for target in targets):
        return 1
    for target in targets:
        if (target["stage"] == "failed" and target["reason"] in ("git-refused", "git-failed")
                and target["exit_status"] is not None):
            return target["exit_status"]
    if all(target["stage"] == "removed" and target["reason"] is None for target in targets):
        return 0
    return 2


def json_argv(argv):
    """An argument vector as a document writes it: each str as it is, and each
    path (bytes or a path object) through json_path(), as text."""
    return [arg if isinstance(arg, str) else json_path(arg)[0] for arg in argv]


def target_document(target):
    """One target result in TARGET_RESULT_KEYS's order (data-model.md, "Target
    result and reconciliation record"): `path` through json_path() with
    `path_valid_utf8` beside it, `command` through json_argv(), and
    `reconciliation` null on a `not-attempted` target and an object in
    RECONCILIATION_KEYS's order on every other, every field null and
    `reconciled` false where none was read."""
    path, valid = json_path(target["path"])
    reconciliation = None
    if target["stage"] != "not-attempted":
        record = target["reconciliation"] or {key: None for key in RECONCILIATION_KEYS}
        reconciliation = {key: record[key] for key in RECONCILIATION_KEYS}
        reconciliation["reconciled"] = bool(reconciliation["reconciled"])
    values = dict(target, path=path, path_valid_utf8=valid, notes=list(target["notes"]),
                  command=json_argv(target["command"]), reconciliation=reconciliation)
    return {key: values[key] for key in TARGET_RESULT_KEYS}


def result_document(targets, exit_code, *, repository, merge_target, plan_digest, probes, operations):
    """The apply result record (contracts/project-clean.md, "Apply result
    record"; data-model.md, "Apply result record"), in APPLY_RESULT_KEYS's
    order, written by write_document() as the one document of --apply --json
    once the apply phase has begun: `schema_version` 1; `observed_at`, now,
    when reconciliation finished; `repository`, `merge_target` and
    `plan_digest`, the plan's, as its envelope writes them; `probes` and
    `operations`, {estimated, performed}; one target_document() per target,
    in canonical order; `exit_code`, the run's exit status (apply_exit_status());
    and `completeness`, `complete` when every target whose reconciliation is
    an object has `reconciled: true`, else `incomplete`."""
    documents = [target_document(target) for target in targets]
    complete = all(document["reconciliation"]["reconciled"] for document in documents
                   if document["reconciliation"] is not None)
    values = {"schema_version": 1, "observed_at": observed_at(), "repository": repository,
              "merge_target": merge_target, "plan_digest": plan_digest, "probes": probes,
              "operations": operations, "targets": documents, "exit_code": exit_code,
              "completeness": "complete" if complete else "incomplete"}
    return {key: values[key] for key in APPLY_RESULT_KEYS}


def progress_line(target):
    """A target's one progress line, at its final stage (lead ruling R-56
    Q-10; `pending` is never printed): `  STAGE PATH`, or `  STAGE PATH
    (REASON)` when it has a reason, PATH through human_path()."""
    path = human_path(target["path"])
    if target["reason"] is None:
        return TEXT["progress_line"].format(STAGE=target["stage"], PATH=path)
    return TEXT["progress_line_reason"].format(STAGE=target["stage"], PATH=path, REASON=target["reason"])


def print_progress(target, run):
    """Print target's progress line through say() once it is final; the apply
    phase calls it for each target in canonical order as it ends."""
    say(run, progress_line(target))


def print_result(plan, targets, run):
    """The human result of an apply (design D18; lead ruling R-56 Q-9), after
    every target's progress line, through say(), so standard error under
    --apply --json and a failed write recorded, never raised: when every
    target is `removed` with reason null, `Removed N; branches kept: B1,
    B2.`; otherwise D18's stop block at the first target that is not, its
    `Not attempted:` naming the `not-attempted` targets (`none` when there is
    none, a case D18 leaves open), its `Next:` command naming plan.root, then
    `Branches kept: B1, B2.`; and in both cases the residual-window line.
    Each list of kept branches names every selected target's branch in
    canonical order, since the apply phase deletes no branch; paths and
    branches print through human_path(), the command's root in its command
    form."""
    branches = ", ".join(human_path(target["branch"]) for target in targets)
    stop = next((target for target in targets
                 if not (target["stage"] == "removed" and target["reason"] is None)), None)
    if stop is None:
        say(run, TEXT["success_line"].format(N=len(targets), BRANCHES=branches))
    else:
        skipped = [human_path(target["path"]) for target in targets if target["stage"] == "not-attempted"]
        say(run, TEXT["stop_block"].format(
            PATH=human_path(stop["path"]), REASON=stop["reason"],
            K=sum(target["stage"] == "removed" for target in targets), N=len(targets),
            NOT_ATTEMPTED=", ".join(skipped) or "none", ROOT=human_path(plan.root, command=True)))
        say(run, TEXT["branches_kept_line"].format(BRANCHES=branches))
    say(run, TEXT["residual_window_line"])
# endregion result

# region push
def push_or_delete(repo, run):
    """Push a branch or delete a merged one (T076 fills; FR-010; research.md R1,
    R4 and R5): called in phase `planning`, which it keeps, with run.plan the
    plan the pipeline built; it swaps in default_signals() around confirm()
    alone, and returns the run's exit status, the child's own, or raises a
    refusal to main(). A signal recorded meanwhile ends the run by the
    pipeline's last slot read. First body: the baseline (project:680-706 and
    :723-743 at 961c405, the --branch checks moved to
    check_clean_arguments())."""
    args, root, report = run.args, repo["root"], run.plan.report
    rows = report["worktrees"]
    if args.action == "push":
        matches = [row for row in rows if row.get("branch") == args.branch]
        if len(matches) != 1:
            raise Refused(f"No unique linked worktree found for branch {args.branch}")
        row = matches[0]
        if row.get("branch") == report["target_branch"]:
            raise Refused("The default branch is protected; use its normal repository workflow.")
        if row.get("dirty") is not False:
            raise Refused(f"Cannot push {args.branch}; its worktree is dirty, missing, or unreadable.")
        if row.get("branch") == "detached":
            raise Refused("Cannot push a detached worktree; name the branch first.")
        if row.get("classification") in ("diverged", "remote-ahead", "review-required"):
            raise Refused(f"Cannot push {args.branch}; reconcile its remote state first.")
        if row.get("upstream"):
            remote, separator, remote_branch = row["upstream"].partition("/")
            if not separator or not remote or not remote_branch:
                raise Refused(f"Unsupported upstream mapping for {args.branch}: {row['upstream']}")
            command = ["git", "-C", str(root), "push", remote, f"{args.branch}:{remote_branch}"]
        else:
            if not git_text(root, "remote", "get-url", "origin"):
                raise Refused("Cannot publish a branch without an origin remote.")
            command = ["git", "-C", str(root), "push", "-u", "origin", args.branch]
        print(f"Cleanup action: push branch {args.branch}")
        expected = {"target_branch": report["target_branch"], "signature": cleanup_signature(report, row)}
        action_target = {"branch": args.branch}
    else:
        matches = [row for row in rows if row.get("branch") == args.branch]
        if args.branch == report["target_branch"]:
            raise Refused("The default branch is protected and cannot be deleted.")
        if matches and any(row.get("present") and row.get("branch") == args.branch for row in matches):
            raise Refused("Remove the linked worktree first; branch deletion is a separate action.")
        if ancestor(root, git_text(root, "rev-parse", "--verify", f"refs/heads/{args.branch}"), report["target_branch"]) is not True:
            raise Refused(f"Branch {args.branch} is not verified as merged into {report['target_branch']}.")
        branch_head = git_text(root, "rev-parse", "--verify", f"refs/heads/{args.branch}")
        command = ["git", "-C", str(root), "branch", "-d", args.branch]
        print(f"Cleanup action: delete verified merged local branch {args.branch}")
    show_plan([command], root)
    with default_signals():
        confirm(args.yes)
    if args.action == "delete-branch":
        require_unchanged_cleanup_state(root, args.action, {"target_branch": report["target_branch"]},
                                        branch=args.branch, branch_head=branch_head)
    else:
        require_unchanged_cleanup_state(root, args.action, expected, **action_target)
    return execute(command)
# endregion push


def repo_state(root):
    top = git_text(root, "rev-parse", "--show-toplevel")
    if not top or Path(top).resolve() != root.resolve():
        return {"path": str(root), "present": False}
    status = git(root, "status", "--porcelain=v1", "--untracked-files=normal")
    if status.returncode:
        raise Refused(f"Cannot inspect {root}: {status.stderr.strip()}")
    branch = git_text(root, "symbolic-ref", "--quiet", "--short", "HEAD")
    head = git_text(root, "rev-parse", "--verify", "HEAD")
    upstream = git_text(root, "rev-parse", "--abbrev-ref", "@{upstream}")
    delta = git_text(root, "rev-list", "--left-right", "--count", "HEAD...@{upstream}") if upstream else None
    ahead, behind = map(int, delta.split()) if delta else (None, None)
    worktrees = []
    current = {}
    active_path = Path.cwd().resolve()
    for line in (git_text(root, "worktree", "list", "--porcelain") or "").splitlines():
        if line.startswith("worktree "):
            current = {"path": line[9:], "present": Path(line[9:]).is_dir()}
            worktrees.append(current)
        elif line.startswith("HEAD "):
            current["head"] = line[5:]
        elif line.startswith("branch "):
            current["branch"] = line[7:].removeprefix("refs/heads/")
        elif line == "detached":
            current["branch"] = "detached"
        elif line.startswith("prunable "):
            current["prunable"] = True
    for tree in worktrees:
        tree_path = Path(tree["path"])
        if not tree["present"]:
            tree["classification"] = "stale-worktree"
            tree["recommendation"] = "Review the stale worktree metadata before pruning it manually."
            continue
        tree_status = git(tree_path, "status", "--porcelain=v1", "--untracked-files=normal")
        tree["dirty"] = bool(tree_status.stdout) if tree_status.returncode == 0 else None
        ignored_status = git(tree_path, "status", "--porcelain=v1", "--ignored=matching")
        tree["ignored_files"] = (sum(line.startswith("!! ") for line in ignored_status.stdout.splitlines())
                                 if ignored_status.returncode == 0 else None)
        resolved_tree = tree_path.resolve()
        tree["current"] = active_path == resolved_tree or active_path.is_relative_to(resolved_tree)
        tree["upstream"] = None
        tree["ahead"] = tree["behind"] = None
        if tree.get("branch") and tree["branch"] != "detached":
            tree["upstream"] = git_text(tree_path, "rev-parse", "--abbrev-ref", "@{upstream}")
            if tree["upstream"]:
                delta = git_text(tree_path, "rev-list", "--left-right", "--count", "HEAD...@{upstream}")
                if delta:
                    tree["ahead"], tree["behind"] = map(int, delta.split())
    return {"path": str(root), "present": True, "branch": branch or "detached",
            "head": head, "dirty": bool(status.stdout), "upstream": upstream,
            "ahead": ahead, "behind": behind, "tracking_freshness": "local refs only; no fetch",
            "worktrees": worktrees}


def default_branch(root, declared=None):
    """Return the local branch used as the cleanup merge target."""
    candidates = [declared, git_text(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD"),
                  "main", "master"]
    for candidate in candidates:
        if not isinstance(candidate, str) or not candidate:
            continue
        candidate = candidate.removeprefix("origin/")
        if git(root, "show-ref", "--verify", "--quiet", f"refs/heads/{candidate}").returncode == 0:
            return candidate
    return None


def ancestor(root, commit, branch):
    if not commit or not branch:
        return None
    result = git(root, "merge-base", "--is-ancestor", commit, f"refs/heads/{branch}")
    return True if result.returncode == 0 else False if result.returncode == 1 else None


def cleanup_report(root):
    """The report of `project clean ROOT` on the evidence model (T033;
    research.md R9): the baseline document {root, target_branch,
    tracking_freshness, worktrees}, its rows from worktree_rows() with the six
    added fields. It reads afresh every time (refresh), since
    require_unchanged_cleanup_state() revalidates through it. Refusals keep
    their baseline messages: `Cannot inspect Git repository at ROOT` for a
    ROOT that is not a worktree toplevel of a repository whose main worktree
    can be named, or whose repository-wide probes failed; the manifest's own;
    and `no-merge-target`."""
    run = current_invocation()
    repo = inspect_repository(root, run, refresh=True)
    identity = repo["identity"]
    try:
        toplevel = identity is not None and _realpath(os.fsencode(root)) == repo["toplevel"]
    except EvidenceError:
        toplevel = False
    if not toplevel or identity["root"] is None:
        raise Refused(f"Cannot inspect Git repository at {root}")
    if repo["merge_target_refusal"] is not None:
        raise repo["merge_target_refusal"]
    if repo["errors"]:
        raise Refused(f"Cannot inspect Git repository at {root}")
    return {"root": str(root), "target_branch": repo["merge_target"]["name"],
            "tracking_freshness": "local refs only; remote information is as of the last fetch; no fetch performed",
            "worktrees": worktree_rows(repo, run)}


def print_clean_report(report, as_json):
    if as_json:
        print(json.dumps(report, indent=2))
        return
    print(f"Cleanup plan for {report['root']}")
    print(f"Merge target: {report['target_branch']}")
    print(f"Freshness: {report['tracking_freshness']}")
    for row in report["worktrees"]:
        branch = row.get("branch", "unknown")
        upstream = row.get("upstream") or "none"
        delta = "unknown" if row.get("ahead") is None else f"ahead={row['ahead']}, behind={row['behind']}"
        print(f"{row['classification'].upper()}: {row['path']} [{branch}] "
              f"dirty={row.get('dirty', 'unknown')}; upstream={upstream}; {delta}; "
              f"merged={row.get('merged_into_target', 'unknown')}")
        print(f"  {row['recommendation']}")


def cleanup_signature(report, row):
    fields = ("path", "branch", "head", "present", "dirty", "ignored_files", "upstream",
              "ahead", "behind", "remote_present", "merged_into_target", "current", "classification")
    return report["target_branch"], tuple((field, row.get(field)) for field in fields)


def matching_worktree(report, *, branch=None, path=None):
    if branch is not None:
        rows = [row for row in report["worktrees"] if row.get("branch") == branch]
    else:
        rows = [row for row in report["worktrees"] if Path(row["path"]).resolve() == path]
    return rows[0] if len(rows) == 1 else None


def require_unchanged_cleanup_state(root, action, expected, *, branch=None, path=None, branch_head=None):
    refreshed = cleanup_report(root)
    if action == "delete-branch":
        current_head = git_text(root, "rev-parse", "--verify", f"refs/heads/{branch}")
        if (refreshed["target_branch"] != expected["target_branch"] or current_head != branch_head or
                ancestor(root, current_head, refreshed["target_branch"]) is not True):
            raise Refused("Cleanup state changed after confirmation; no command was run.")
        return
    current = matching_worktree(refreshed, branch=branch) if branch else matching_worktree(refreshed, path=path)
    if not current or cleanup_signature(refreshed, current) != expected["signature"]:
        raise Refused("Cleanup state changed after confirmation; no command was run.")


def clean(args):
    """`project clean`: the fixed pipeline (T047), frozen. Later tasks fill its
    stages and never reorder them (contracts/project-clean.md, "Order of a
    run"; research.md R4 and R6; lead rulings R-55 and R-56).

    One signal scope covers the run from the argument checks to its last write
    (plan review M1), and its Invocation is the CleanRun: main()'s, or the
    scope's own when clean() is called directly (region dispatcher). The
    stages run in order: check_clean_arguments(), require_git() and
    resolve_clean_target(), which raise their refusals to main(); then
    build_plan(), check_plan() and print_plan(), where a plan, select or
    confirm refusal is recorded on the plan and the plan printed once, after
    the decision, then `REFUSED:` on standard error in human output; then
    push_or_delete(), in phase `planning`, or confirm_removal(), then the slot
    read, phase `apply` and apply_removals(), with nothing in between.

    The slot is read after build_plan(), before the question, before the
    phase change, and once the scope has ended while still in `planning`: a
    signal recorded before the apply phase ends the run by FR-036 (Interrupted:
    probe groups reaped, `Cancelled.`, 130, 143 or 129, no document), and an
    exception that leaves the scope with the slot set in `planning` becomes
    Interrupted. A failed write before the apply phase ends the run as
    `internal-error`, exit 2 (check_writes(); R-55)."""
    run = None
    try:
        with signal_scope() as scope:
            run = scope.invocation
            json_output = getattr(args, "json", False)
            run.args, run.mode, run.action = args, clean_mode(args), clean_action(args)
            run.human = sys.stderr if getattr(args, "apply", False) and json_output else sys.stdout
            run.plan = run.status = run.write_error = None
            check_clean_arguments(args)
            require_git(run)
            repo = resolve_clean_target(args, run)
            plan = run.plan = build_plan(repo, run)
            read_slot(run)
            run.status = check_plan(plan, run)
            if run.status is None and plan.refusals:
                run.status = 2  # a plan that carries a refusal never goes on
            if run.status is None and not getattr(args, "apply", False):
                run.status = 0  # nor does a report or a preview
            print_plan(plan, run)
            check_writes(run)
            if run.status is None:
                read_slot(run)
                if run.action in ("push", "delete-branch"):
                    run.status = push_or_delete(repo, run)
                else:
                    run.status = confirm_removal(plan, run)
                    check_writes(run)
                    if run.status is None:
                        read_slot(run)
                        run.phase = "apply"
                        run.status = apply_removals(plan, run)
                    else:
                        print_plan(plan, run)  # where the run stops at the question
                        check_writes(run)
            if run.phase == "planning" and plan.refusals and not json_output:
                read_slot(run)
                say(run, f"REFUSED: {plan.refusals[0]}", sys.stderr)
    except Exception as exc:
        if run is not None and run.phase == "planning" and run.signal is not None:
            raise Interrupted(run.signal) from exc
        raise
    finally:
        settle_streams()
    if run.phase == "planning":
        read_slot(run)
    return run.status


def profile(root):
    path = root / ".project.json"
    if not path.is_file():
        return {}
    data = read_json(path)
    if data.get("schema_version") != 1:
        raise Refused(f"Unsupported profile schema in {path}; expected schema_version 1")
    for field in ("bench", "type", "container"):
        if field in data and (not isinstance(data[field], str) or not data[field]):
            raise Refused(f"Invalid {field} in {path}")
    return {field: data[field] for field in ("schema_version", "bench", "type", "container") if field in data}


def github_repository_identity(value):
    if not isinstance(value, str):
        return None
    match = re.fullmatch(r"([A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)/([A-Za-z0-9][A-Za-z0-9_.-]*)", value)
    return value if match else None


def remote_repository_identity(remote):
    match = re.fullmatch(r"(?:https?://github\.com/|(?:ssh://)?(?:git@)?github\.com[:/])"
                         r"([^/]+/[^/]+?)(?:\.git)?/?", remote)
    return github_repository_identity(match.group(1)) if match else None


def handoff(root, data):
    """Read only the matching workspace record; parking remains extension-owned."""
    config_path = Path.home() / ".agents/workspace.yaml"
    override = os.environ.get("SPECKIT_WORKSPACE_PATH")
    if not config_path.is_file() and not override:
        return {"state": "workspace not configured"}
    config = read_yaml(config_path) if config_path.is_file() else {}
    remote = git_text(root, "remote", "get-url", "origin") or ""
    repository = remote_repository_identity(remote)
    for leg in data.get("legs", []):
        if isinstance(leg, dict) and leg.get("role") == "assembly":
            repository = github_repository_identity(leg.get("repository")) or repository
    if not repository:
        return {"state": "no GitHub repository identity to match a parked record"}
    org = repository.split("/", 1)[0]
    orgs = config.get("orgs", {})
    if not isinstance(orgs, dict):
        raise Refused(f"Invalid orgs mapping in {config_path}")
    specific = orgs.get(org, {})
    if not isinstance(specific, dict):
        raise Refused(f"Invalid organization entry in {config_path}")
    path = override or specific.get("path") or config.get("path")
    if not isinstance(path, str) or not path:
        return {"state": "workspace path not configured"}
    workspace = Path(path).expanduser()
    if not workspace.is_absolute():
        raise Refused(f"Workspace path must be absolute or home-relative in {config_path}")
    records = workspace / "workspaces" / org
    if not records.is_dir():
        return {"state": "workspace records not available locally"}
    matches = []
    for record in sorted(records.glob("*.yaml")):
        document = read_yaml(record)
        if document.get("kind") != "workspace-manifest":
            continue
        entries = document.get("projects", [])
        if not isinstance(entries, list):
            raise Refused(f"Invalid projects list in {record}")
        for entry in entries:
            if not isinstance(entry, dict) or entry.get("repository") != repository:
                continue
            if not isinstance(entry.get("features", []), list):
                raise Refused(f"Invalid features list in {record}")
            matches.append({"record": str(record), "parked_at": str(entry.get("parked_at", "unknown")),
                            "active_feature": entry.get("active_feature"),
                            "features": len(entry.get("features", []))})
    return {"state": "recorded" if matches else "no matching parked record", "records": matches,
            "freshness": "local workspace records only"}


def snapshot(root, visited=None):
    visited = set() if visited is None else visited
    if root.resolve() in visited:
        raise Refused(f"Cyclic estate membership at {root}")
    visited.add(root.resolve())
    kind, data = manifest(root)
    result = {"name": data.get("name", root.name), "kind": kind, "root": str(root),
              "repository": repo_state(root), "profile": profile(root), "children": [],
              "workflow": (root / ".specify/extensions/git").is_dir(),
              "devcontainer": (root / ".devcontainer").is_dir(),
              "tracking_branch": data.get("tracking_branch"),
              "park_ready": all(os.access(root / ".specify/extensions/git/scripts/bash" / f"{verb}.sh", os.X_OK)
                                for verb in ("park", "resume"))}
    entries = data.get("legs" if kind == "project-manifest" else "members", [])
    if not isinstance(entries, list):
        raise Refused(f"Expected a list of legs/members in {root}")
    for entry in entries:
        if not isinstance(entry, dict):
            raise Refused(f"Invalid leg/member in {root}")
        if kind == "project-manifest":
            if entry.get("role") == "assembly" and entry.get("path") == ".":
                continue
            child = inside(root, entry.get("path"))
            result["children"].append({"role": entry.get("role", "leg"),
                                       "tracking_branch": data.get("tracking_branch", "main"),
                                       **repo_state(child)})
        elif kind == "family-manifest":
            name = entry.get("project") or entry.get("name")
            if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", name):
                raise Refused(f"Invalid family member name in {root}")
            child = inside(root.parent, name)
            if child.is_dir() and (child / "project.yaml").is_file():
                result["children"].append({"role": "member", **snapshot(child, visited)})
            else:
                result["children"].append({"role": "member", "path": str(child), "present": False})
    try:
        result["handoff"] = handoff(root, data)
    except Refused as exc:
        result["handoff"] = {"state": "unavailable", "error": str(exc)}
    container = result["profile"].get("container")
    if container:
        response = probe(["docker", "inspect", "--type", "container", "--format", "{{.State.Status}}", container])
        result["container"] = {"name": container, "state": response.stdout.strip() if not response.returncode else "unavailable"}
    else:
        result["container"] = {"state": "not declared; set container in .project.json"}
    return result


def nested_snapshot(item):
    """Whether a child has the complete snapshot shape used for recursion."""
    return (isinstance(item, dict) and isinstance(item.get("repository"), dict)
            and isinstance(item.get("kind"), str))


def check_rows(report):
    rows = []
    def add(level, name, detail):
        rows.append({"level": level, "check": name, "detail": detail})
    def walk(item):
        state = item["repository"]
        add("ok" if state["present"] else "warning", item["root"],
            "Git checkout present" if state["present"] else "No Git checkout; initialize through the project workflow")
        if state.get("dirty"):
            add("warning", item["root"], "Uncommitted work; preserve it before updates")
        if item["handoff"].get("error"):
            add("warning", "handoff", item["handoff"]["error"])
        if item["kind"] != "family-manifest":
            add("ok" if item["workflow"] else "warning", "workflow", "overlay present" if item["workflow"] else
                f"Install workflow with: setup-openspeckit --repo {shlex.quote(item['root'])}")
        if item["kind"] == "project-manifest" and not item["park_ready"]:
            add("warning", "park/resume", "Overlay scripts are missing or not executable; refresh setup-openspeckit")
        for child in item["children"]:
            if nested_snapshot(child):
                walk(child)
            elif not child.get("present"):
                add("error", child["path"], "Missing checkout; use the estate's bootstrap/siblings command")
            elif child.get("dirty"):
                add("warning", child["path"], "Uncommitted work in leg")
        if item["container"].get("name"):
            add("ok" if item["container"]["state"] == "running" else "warning", "container", str(item["container"]))
    walk(report)
    for command in ("git", "bash", "make", "openRepoShape", "park", "resume", "setup-openspeckit", "docker"):
        found = shutil.which(command)
        add("ok" if found else "warning", command, found or "Not on PATH; install through workBenches as needed")
    return rows


def print_report(report, as_json):
    if as_json:
        print(json.dumps(report, indent=2))
        return
    def walk(item, indent=""):
        state = item["repository"]
        print(f"{indent}{item['name']} ({item['kind']}) — {item['root']}")
        print(f"{indent}  Git: {state.get('branch', 'missing')}; dirty={state.get('dirty', 'unknown')}; "
              f"ahead={state.get('ahead')}, behind={state.get('behind')} (local refs)")
        for tree in state.get("worktrees", []):
            print(f"{indent}  Worktree: {tree['path']} [{tree.get('branch', 'unknown')}]")
        print(f"{indent}  Bench: {item['profile'].get('bench', 'not declared')}; container: {item['container']['state']}")
        print(f"{indent}  Handoff: {item['handoff']['state']}")
        for record in item["handoff"].get("records", []):
            print(f"{indent}    Parked {record['parked_at']}; {record['features']} feature(s); {record['record']}")
        for child in item["children"]:
            if nested_snapshot(child):
                walk(child, indent + "  ")
            else:
                print(f"{indent}  {child['role']}: {child['path']} — {child.get('branch', 'missing')}; dirty={child.get('dirty', 'unknown')}")
    walk(report)
    for row in report.get("checks", []):
        print(f"{row['level'].upper()} {row['check']}: {row['detail']}")
    for row in report.get("updates", []):
        print(f"{row['component']}: {row['detail']}")


def inspect_project(args):
    report = snapshot(discover(args.target))
    if args.command == "doctor":
        checks = check_rows(report)
        wb = workbenches(args.workbenches, required=False)
        checks.append({"level": "ok" if wb else "warning", "check": "workBenches", "detail": str(wb) if wb else "Not found; set WORKBENCHES_ROOT"})
        declared = report["profile"].get("bench")
        if wb and declared:
            entry = bench_definition(wb, bench_registry(wb), declared)
            available = bool(entry and entry[1].is_dir())
            checks.append({"level": "ok" if available else "error", "check": "bench", "detail": declared + (" available" if available else " missing")})
        # Presence only: never read credentials or imply that a login is valid.
        report["ai_tools"] = {name: bool(shutil.which(name)) for name in ("claude", "codex", "gemini", "copilot")}
        report["credential_configuration"] = {
            "verification": "presence only; authentication not tested",
            "claude": (Path.home() / ".claude/.credentials.json").is_file() or bool(os.environ.get("ANTHROPIC_API_KEY")),
            "codex": (Path.home() / ".codex/auth.json").is_file() or bool(os.environ.get("OPENAI_API_KEY")),
            "gemini": (Path.home() / ".gemini/oauth_creds.json").is_file() or bool(os.environ.get("GEMINI_API_KEY")),
        }
        if args.validate:
            def validate(item):
                root = Path(item["root"])
                names = ("validate-family.py",) if item["kind"] == "family-manifest" else (
                    ("validate-manifest.py", "validate-pins.py") if item["kind"] == "project-manifest" else ())
                if not names:
                    checks.append({"level": "warning", "check": "validators", "detail": "No shape validators apply to this single repository"})
                for name in names:
                    script = root / "scripts" / name
                    if script.is_file():
                        response = probe([sys.executable, str(script)], cwd=root)
                        checks.append({"level": "ok" if response.returncode == 0 else "error", "check": name,
                                       "detail": (response.stdout + response.stderr).strip(), "exit_code": response.returncode})
                    else:
                        checks.append({"level": "error", "check": name, "detail": f"Required shape validator missing: {script}"})
                for child in item["children"]:
                    if nested_snapshot(child):
                        validate(child)
            validate(report)
        report["checks"] = checks
    print_report(report, args.json)
    return int(any(r["level"] == "error" or (args.strict and r["level"] == "warning")
                   for r in report.get("checks", [])))


def update_child_states(item):
    """Yield every child checkout state, including nested family members."""
    for child in item["children"]:
        if not nested_snapshot(child):
            yield child
            continue
        state = {**child["repository"], "path": child["root"],
                 "tracking_branch": child.get("tracking_branch") or "main"}
        yield state
        yield from update_child_states(child)


def update(args):
    root = discover(args.target)
    report = snapshot(root)
    report["updates"] = [
        {"component": "shape", "detail": "Use openRepoShape update-shape.py check/apply; --shape-source selects its checkout"},
        {"component": "workflow", "detail": "Refresh through setup-openspeckit --repo PATH"},
        {"component": "bench", "detail": "Refresh project configuration through the profile's exact registered update-TYPE generator"},
        {"component": "tools", "detail": "Open workBenches setup for explicit tool/environment selection"},
    ]
    if not args.apply:
        print_report(report, args.json)
        return 0
    if args.json:
        raise Refused("--json is for inspection; omit it when applying updates.")
    if not args.component:
        raise Refused("--apply requires --component shape|workflow|bench|tools")
    if args.component in ("shape", "bench"):
        state = report["repository"]
        tracking = report.get("tracking_branch") or (git_text(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or "origin/main").removeprefix("origin/")
        if not state.get("present") or state.get("dirty") or state.get("branch") != tracking:
            raise Refused("Project updates require a clean tracking checkout; preserve feature work first.")
        for child in update_child_states(report):
            if not child.get("present"):
                raise Refused(f"Child checkout is missing: {child.get('path')}")
            expected = child.get("tracking_branch") or "main"
            if child.get("dirty") or child.get("branch") in (None, "detached") or child.get("branch") != expected:
                raise Refused(f"Child has work to preserve: {child.get('path')}")
    if args.component == "shape":
        if report["kind"] == "single":
            raise Refused("This project has no shape manifest.")
        if not args.shape_source:
            raise Refused("Shape updates require --shape-source PATH to an openRepoShape checkout.")
        source = Path(args.shape_source).expanduser().resolve() / "update-shape.py"
        if not source.is_file():
            raise Refused(f"Missing shape updater: {source}")
        if not args.at or not re.fullmatch(r"[0-9a-f]{40}", args.at):
            raise Refused("Shape updates require --at with a full commit SHA.")
        commands = [[sys.executable, str(source), "check", "--root", str(root), "--at", args.at],
                    [sys.executable, str(source), "apply", "--root", str(root), "--at", args.at,
                     "--branch", args.branch or f"shape/update-{args.at[:12]}"]]
    elif args.component == "workflow":
        commands = [["setup-openspeckit", "--repo", str(root)]]
    else:
        wb = workbenches(args.workbenches)
        if args.component == "bench":
            # Exact target adapter avoids the old updater's fuzzy folder search.
            if report["kind"] != "single":
                raise Refused("Bench updates require a single application checkout, not an assembly/family root.")
            selected = report["profile"]
            definition = bench_definition(wb, bench_registry(wb), selected.get("bench"))
            if not definition:
                raise Refused("The selected bench is not registered; use the bench's own updater.")
            _, _, scripts = definition
            candidates = [(item, script) for item, script in scripts
                          if item["name"] == "update-" + selected.get("type", "")]
            if len(candidates) != 1:
                raise Refused("No exact updater registered for this .project.json bench/type; use the bench's own updater.")
            script = candidates[0][1]
            if not script.is_file():
                raise Refused(f"Registered updater is missing: {script}")
            commands = [["bash", str(script), str(root)]]
        else:
            commands = [["bash", str(wb / "setup.sh")]]
    show_plan(commands, root)
    if args.dry_run:
        return 0
    if args.component == "shape":
        check = execute(commands.pop(0), cwd=root)
        # update-shape check exits 1 when differences are available.
        if check not in (0, 1):
            return check
        # The owner retains its own confirmation prompt, even if this coordinator
        # received --yes for a different update component.
        return execute(commands[0], cwd=root)
    confirm(args.yes)
    for command in commands:
        code = execute(command, cwd=root)
        if code:
            return code
    return 0


def parser():
    result = argparse.ArgumentParser(description="Create, inspect and maintain projects through their owning tools.")
    result.add_argument("--version", action="version", version="openRepoProject (sha256 " + hashlib.sha256(Path(__file__).read_bytes()).hexdigest()[:12] + ")")
    commands = result.add_subparsers(dest="command", required=True)
    creation = commands.add_parser("new", help="Create using a bench generator or openRepoShape")
    creation.add_argument("name", nargs="?")
    creation.add_argument("parent", nargs="?", help="Legacy parent directory")
    creation.add_argument("--into", help="Parent directory")
    creation.add_argument("--bench")
    creation.add_argument("--type", help="Generator name from project benches")
    creation.add_argument("--description", help="Local keyword recommendation; never uploaded")
    creation.add_argument("--shape", action="store_true")
    creation.add_argument("--org")
    creation.add_argument("--visibility", choices=("public", "private", "internal"))
    creation.add_argument("--family")
    creation.add_argument("--elected-by")
    creation.add_argument("--workflow", action="store_true", help="Run setup-openspeckit after creation")
    listing = commands.add_parser("benches", help="List configured generators and availability")
    listing.add_argument("--json", action="store_true")
    for command in ("status", "doctor", "update"):
        sub = commands.add_parser(command)
        sub.add_argument("target", nargs="?", help="Project path or name; defaults to current project")
        sub.add_argument("--json", action="store_true")
        sub.add_argument("--workbenches", help="workBenches checkout")
        sub.add_argument("--strict", action="store_true", help="Doctor warnings cause nonzero exit")
        if command == "doctor":
            sub.add_argument("--validate", action="store_true", help="Run project-owned validators (may access upstream)")
        if command == "update":
            sub.add_argument("--component", choices=("shape", "workflow", "bench", "tools"))
            sub.add_argument("--apply", action="store_true")
            sub.add_argument("--shape-source")
            sub.add_argument("--at")
            sub.add_argument("--branch")
            sub.add_argument("--yes", action="store_true")
            sub.add_argument("--dry-run", action="store_true")
    cleaning = commands.add_parser("clean", help="Audit and explicitly clean Git worktrees")
    cleaning.add_argument("target", nargs="?", help="Project path or name; defaults to current project")
    cleaning.add_argument("--json", action="store_true", help="Print the read-only cleanup plan as JSON")
    cleaning.add_argument("--apply", action="store_true", help="Apply one explicitly selected cleanup action")
    cleaning.add_argument("--action", choices=("push", "remove", "delete-branch"),
                          help="Action to apply; requires --apply")
    cleaning.add_argument("--branch", help="Branch target for push or delete-branch")
    cleaning.add_argument("--worktree", help="Worktree path target for remove")
    cleaning.add_argument("--yes", action="store_true", help="Confirm the selected cleanup action")
    cleaning.add_argument("--all-safe", action="store_true",
                          help="Plan every worktree that passes every gate; with --apply, remove them")
    cleaning.add_argument("--expect-plan", metavar="D",
                          help="With --all-safe --apply: refuse unless the fresh plan's digest is D")
    for sub in (creation, listing):
        sub.add_argument("--workbenches", help="workBenches checkout")
    creation.add_argument("--yes", action="store_true", help="Confirm bench creation; shape prompts are retained")
    creation.add_argument("--dry-run", action="store_true")
    return result


def main(argv=None):
    args = parser().parse_args(argv)
    with Invocation(args.command) as invocation:  # fresh per call (lead ruling R-44 (1))
        try:
            if args.command == "new":
                return new(args)
            if args.command == "benches":
                rows = registry(workbenches(args.workbenches))
                if args.json:
                    print(json.dumps(rows, indent=2))
                else:
                    for row in rows:
                        print(f"{row['bench']}:{row['type']} — {'available' if row['available'] else 'missing'} — {row['description']}")
                return 0
            if args.command == "update":
                return update(args)
            if args.command == "clean":
                return run_clean(args)
            return inspect_project(args)
        except (Refused, OSError) as exc:
            if args.command == "clean" and args.json:
                write_document(error_document(exc, args))
            elif getattr(args, "json", False):
                print(json.dumps({"error": str(exc)}))
            else:
                advise(f"REFUSED: {exc}")  # best-effort (R-54 X-3, R-55)
            return 2
        except (Interrupted, Terminated) as exc:
            # The first signal decides the status, 128 plus its number (FR-036, R-45 (6)).
            advise("Cancelled.")
            return 128 + int(exc.signum or invocation.signal or signal.SIGINT)
        except (KeyboardInterrupt, EOFError):
            advise("Cancelled.")
            return 130


if __name__ == "__main__":
    sys.exit(main())
