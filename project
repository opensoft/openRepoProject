    # it TRACE2_OFF as it gives every kind: Q9 B says every Git child, and
    # trace output changes nothing about where a push reaches.
    "push": (False, (), False, ("GIT_ALLOW_PROTOCOL",)),
}


def git_env(kind):
    """A copy of project's environment for a Git child of KIND: GIT_SCRUB's
    names removed but those KIND keeps, TRACE2_OFF set for every kind, and
    GIT_OPTIONAL_LOCKS=0 for a read-only probe."""
    read_only, _, _, kept = GIT_KINDS[kind]
    env = {name: value for name, value in os.environ.items()
           if name not in GIT_SCRUB or name in kept}
    env.update(TRACE2_OFF)
    if read_only:
        env["GIT_OPTIONAL_LOCKS"] = "0"
    return env


def git_argv(kind, args):
    """The argument vector of a Git child of KIND; ARGS pass through unchanged."""
    _, pins, pinned, _ = GIT_KINDS[kind]
    return ["git", *pins, *(PROTOCOL_PINS if pinned else ()), *args]
# endregion git environment

# region runner
# Every Git child but the push child runs as a D2 child handle: design D1 and D2
# as lead ruling R-30 amends them (research.md R4, R5 and R14; data-model.md,
# "Child handle"). A handle never blocks: terminate_group() sends SIGTERM and
# returns, and whoever drives the handle calls advance() on every tick, which
# sends SIGKILL at the kill deadline and then reaps or abandons the child. A
# child is observed only through Popen.poll() (R14). The grace and the reap wait
# are read from TIMING when each step starts, never passed in (R-29, M16).

# Every live handle of a read-only kind, so that kill_live_probes() reaches it
# on any exit path (D1). A removal or delegate handle is never here, since
# nothing signals it before its ceiling (D9; research.md R4). A reaped handle
# leaves; an abandoned one stays, so its group is killed again on exit.
LIVE_PROBES = set()

# The head of a child's standard error kept for its row's message (D1); the
# rest is counted and dropped.
STDERR_HEAD_BYTES = 4096


class ChildHandle:
    """One spawned Git child other than the push child (D2; data-model.md,
    "Child handle"). It holds the Popen, its kind (a key of GIT_KINDS), its
    process ID, which is also its process group ID, its start time, its budget
    end and a removal's ceiling end (set by whoever drives it; None for none),
    its kill and reap deadlines once set, and the first 4 KiB of its standard
    error. It reads nothing itself: the driver reads both descriptors.

    States: `running` from start(); `terminating` once SIGTERM went to its
    group; `killing` once SIGKILL went to its group; then `reaped` when
    Popen.poll() returns a status, or `abandoned` at the reap deadline, which
    records `probe-timeout` and is never waited on again."""

    def __init__(self, process, kind):
        self.process = process
        self.kind = kind
        self.probe = GIT_KINDS[kind][0]  # read-only: a probe handle (D2)
        self.pid = process.pid  # also its process group ID (start_new_session)
        self.started = time.monotonic()
        self.state = "running"
        self.budget_end = None
        self.ceiling_end = None
        self.kill_at = None
        self.reap_at = None
        self.error = None
        self.stderr_head = bytearray()
        self.stderr_bytes = 0

    @classmethod
    def start(cls, argv, cwd, kind):
        """Spawn argv in cwd as a Git child of kind (D2): standard input from
        /dev/null, both outputs piped and non-blocking, close_fds, a new session
        and so a process group of its own (start_new_session, never
        process_group=0 or preexec_fn; C4), and git_env(kind), which sets
        GIT_OPTIONAL_LOCKS=0 for the read-only kinds only. A probe handle is
        registered in LIVE_PROBES. Raises OSError when argv cannot be spawned."""
        if kind == "push":
            raise ValueError("the push child runs through execute(), never as a handle (R1)")
        process = subprocess.Popen(argv, cwd=cwd, env=git_env(kind), stdin=subprocess.DEVNULL,
                                   stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   close_fds=True, start_new_session=True)
        handle = cls(process, kind)
        for stream in (process.stdout, process.stderr):
            os.set_blocking(stream.fileno(), False)
        if handle.probe:
            LIVE_PROBES.add(handle)
        return handle

    @property
    def finished(self):
        return self.state in ("reaped", "abandoned")

    def keep_stderr(self, chunk):
        """Keep the first 4 KiB of standard error and count every byte (D1)."""
        room = STDERR_HEAD_BYTES - len(self.stderr_head)
        if room > 0:
            self.stderr_head += chunk[:room]
        self.stderr_bytes += len(chunk)

    def due(self):
        """The next time this handle needs its driver: the kill deadline while
        terminating, the reap deadline while killing, else the earlier of its
        budget end and ceiling end; None when nothing is due."""
        if self.state == "terminating":
            return self.kill_at
        if self.state == "killing":
            return self.reap_at
        if self.state == "running":
            ends = [end for end in (self.budget_end, self.ceiling_end) if end is not None]
            return min(ends) if ends else None
        return None

    def reap(self):
        """The child's exit status, observed without blocking (Popen.poll(),
        R14), or None while it runs. A running child that has exited is reaped
        here; a terminating or killing one only through advance(); an abandoned
        one is never polled again."""
        if self.state == "abandoned":
            return None
        if self.state == "reaped":
            return self.process.returncode
        status = self.process.poll()
        if status is not None and self.state == "running":
            self._finish("reaped")
        return status

    def terminate_group(self):
        """Send SIGTERM to the child's process group, set the kill deadline from
        TIMING["term_grace"] as it stands now, and return at once (R-30). Only a
        running handle starts the sequence; a later state is left as it is."""
        if self.state != "running":
            return
        self._signal(signal.SIGTERM)
        self.state = "terminating"
        self.kill_at = time.monotonic() + TIMING["term_grace"]

    def advance(self, now):
        """Take a terminating or killing handle one step on; the driver loop
        calls it on every tick (R-30). At the kill deadline, or as soon as the
        leader has exited, SIGKILL goes to the group, which also sweeps any member
        left, and the reap deadline is set from TIMING["reap_wait"]; the handle is
        reaped when Popen.poll() returns a status, and abandoned at the reap
        deadline. Returns True once the handle is reaped or abandoned."""
        if self.state == "terminating" and (now >= self.kill_at or self.process.poll() is not None):
            self._signal(signal.SIGKILL)
            self.state = "killing"
            self.reap_at = now + TIMING["reap_wait"]
        if self.state == "killing":
            if self.process.poll() is not None:
                self._finish("reaped")
            elif now >= self.reap_at:
                self._finish("abandoned")
        return self.finished

    def close(self):
        """Close both pipes; the driver unregisters them from its selector first."""
        for stream in (self.process.stdout, self.process.stderr):
            if stream is not None:
                try:
                    stream.close()
                except OSError:
                    pass

    def _signal(self, signum):
        try:
            os.killpg(self.pid, signum)
        except (ProcessLookupError, PermissionError):
            pass  # the group is gone, or holds only processes past signalling

    def _finish(self, state):
        self.state = state
        if state == "reaped":
            LIVE_PROBES.discard(self)
        else:
            self.error = "probe-timeout"  # abandoned: it stays in LIVE_PROBES


def kill_live_probes():
    """Stop every live probe group at once, on any exit path (D1, R-30):
    SIGTERM to each running group and SIGKILL again to each abandoned one, then
    all of them advanced together on the tick until each is reaped or abandoned.
    The whole stop takes at most the grace plus the reap wait in force, however
    many handles run. Each handle stopped here has its pipes closed."""
    handles = list(LIVE_PROBES)
    for handle in handles:
        if handle.state == "abandoned":
            handle._signal(signal.SIGKILL)  # killed again, never waited on
        else:
            handle.terminate_group()
    pending = [handle for handle in handles if not handle.finished]
    while pending:
        pending = [handle for handle in pending if not handle.advance(time.monotonic())]
        if pending:
            due = min(handle.due() for handle in pending)
            time.sleep(max(0.0, min(TIMING["selector_tick"], due - time.monotonic())))
    for handle in handles:
        handle.close()


# Signals (design D1 and D15; research.md R4; data-model.md, "Signal slot").
# The first of these a run receives decides its exit status, 128 plus its
# number: 130, 143 and 129.
SCOPED_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


class Interrupted(BaseException):
    """A recorded signal stopped the work: the slot read set while planning, or
    a second SIGINT while reconciling (D1, D15; lead ruling R-44). Not an
    Exception, so no `except Exception` catches it (plan review M2). signum is
    the first signal recorded, which decides the exit status."""

    def __init__(self, signum=None):
        super().__init__(signum)
        self.signum = signum


class Terminated(BaseException):
    """SIGTERM or SIGHUP under raising_signals(), as SIGINT raises
    KeyboardInterrupt there (D1; research.md R4): main() maps it to 143 or 129.
    Not an Exception (plan review M2)."""

    def __init__(self, signum):
        super().__init__(signum)
        self.signum = signum


# Module state, innermost last: the invocations in force, and the signal scopes
# in force (signal_scope, raising_signals and default_signals frames).
_invocations = []
_signal_frames = []


class Invocation:
    """The state of one run of project (lead ruling R-44 (1)): made fresh by
    each main() call and entered around its dispatch, so that nothing carries
    from one in-process main() call to the next. command is the subcommand's
    name. It carries:

    - the phase, `planning` by default, then `apply`, then `reconciling`
      (R-44 (3)), and the signal slot: `signal`, the first SIGINT, SIGTERM or
      SIGHUP recorded, and `second_interrupt`, a later SIGINT received while
      reconciling;
    - the clock: under `clean`, `work_end` 50 s and `reserve_end` 60 s after
      the start in the real table (both None for any other command), paused
      while the removal question waits (pause() and resume());
    - the per-child budget (child_budget()): 5 s under `clean`, within the
      time left, and 15 s otherwise (plan review M10);
    - the counters: `probes`, every Git child other than a removal, and
      `operations`, the removals (research.md R8; lead ruling R-27);
    - the memos: `version`, the version check's result, and `common_dirs`,
      the evidence memoized per common directory.

    Every timing value is read from TIMING when the invocation is made or a
    method is called (R-29)."""

    def __init__(self, command=None):
        self.command = command
        self.phase = "planning"
        self.signal = None
        self.second_interrupt = False
        self.started = time.monotonic()
        self.work_end = self.reserve_end = None
        if command == "clean":
            self.reserve_end = self.started + TIMING["invocation_deadline"]
            self.work_end = self.reserve_end - TIMING["reconciliation_reserve"]
        self._paused_at = None
        self.probes = 0
        self.operations = 0
        self.version = None
        self.common_dirs = {}

    def now(self):
        """The clock's time: monotonic, held still while paused."""
        return time.monotonic() if self._paused_at is None else self._paused_at

    def pause(self):
        """Stop the clock while the removal question waits: that time does not
        count, and both deadlines move later by it (FR-031's question; D15)."""
        if self._paused_at is None:
            self._paused_at = time.monotonic()

    def resume(self):
        if self._paused_at is not None:
            waited = time.monotonic() - self._paused_at
            self._paused_at = None
            if self.work_end is not None:
                self.work_end += waited
                self.reserve_end += waited

    def work_remaining(self):
        """Seconds of work left before the work deadline; None without one."""
        return None if self.work_end is None else self.work_end - self.now()

    def reserve_remaining(self):
        """Seconds left before the reserve ends; None without a deadline."""
        return None if self.reserve_end is None else self.reserve_end - self.now()

    def child_budget(self, kind):
        """(seconds, limit) for the next Git child of kind, or a filesystem call
        (kind "probe"): under a deadline, min(probe budget, work remaining), or
        min(probe budget, reserve remaining) while reconciling, with limit
        `deadline` when the time left is the smaller, else `timeout`; without
        one, the 15 s budget. A removal or delegate child gets no budget (None):
        a removal has its own ceiling (D9), and a delegate is unbounded (D-W)."""
        if kind in ("removal", "delegate"):
            return None, "timeout"
        if self.work_end is None:
            return TIMING["inspect_budget"], "timeout"
        left = self.reserve_remaining() if self.phase == "reconciling" else self.work_remaining()
        budget = TIMING["probe_budget"]
        if left < budget:
            return max(0.0, left), "deadline"
        return budget, "timeout"

    def count_child(self, kind):
        """Count one spawned Git child: a removal in `operations`, any other in
        `probes` (research.md R8)."""
        if kind == "removal":
            self.operations += 1
        else:
            self.probes += 1

    def __enter__(self):
        _invocations.append(self)
        return self

    def __exit__(self, *exc_info):
        _invocations.remove(self)
        return False

    def record_signal(self, signum):
        """The slot (data-model.md, "Signal slot"): the first signal is kept and
        decides the exit status; a later SIGINT counts only while reconciling."""
        if self.signal is None:
            self.signal = signum
        elif signum == signal.SIGINT and self.phase == "reconciling":
            self.second_interrupt = True

    def interrupting(self):
        """Whether a driver stops its probe and raises Interrupted now: the slot
        set while planning, or a second SIGINT while reconciling (R-44 (3);
        data-model.md, "Signal slot"). In the apply phase no driver stops: the
        seams read the slot before each revalidation and each spawn (D15), and
        a revalidation reads it before each read it starts (slot_set(); lead
        ruling R-95 (a))."""
        if self.phase == "planning":
            return self.signal is not None
        return self.phase == "reconciling" and self.second_interrupt


def current_invocation():
    """The invocation in force; outside any, a fresh default: the 15 s budget
    per Git child, no deadline, and no signal handler recording into it (plan
    review M10; lead ruling R-44 (1))."""
    return _invocations[-1] if _invocations else Invocation()


def _install_handlers(handlers):
    """Install {signum: handler} and return the handlers replaced; a handler not
    installed from Python (None) is kept as SIG_DFL. A signal ignored when this
    is called (SIG_IGN, as nohup leaves SIGHUP and a non-interactive shell's
    `&` job leaves SIGINT) stays ignored, and nothing is saved for it, so no
    scope catches or restores it (lead ruling R-101 (b), F2). On failure, what
    was installed is put back."""
    saved = {}
    try:
        for signum, handler in handlers.items():
            if signal.getsignal(signum) == signal.SIG_IGN:
                continue
            previous = signal.signal(signum, handler)
            saved[signum] = signal.SIG_DFL if previous is None else previous
    except BaseException:
        _restore_handlers(saved)
        raise
    return saved


def _restore_handlers(saved):
    for signum, handler in saved.items():
        signal.signal(signum, handler)


def _in_main_thread():
    """Handlers and the wakeup descriptor can change only in the main thread."""
    return threading.current_thread() is threading.main_thread()


class signal_scope:
    """D1's record-only handlers (research.md R4): for SIGINT, SIGTERM and
    SIGHUP, each one not ignored on entry (_install_handlers()), a handler
    that stores the signal in the slot of the invocation in force when the
    scope is entered (one entered for the scope's own span when none is), and
    does nothing else; and a non-blocking wakeup pipe, set with
    warn_on_full_buffer=False, so that a signal wakes the driver's select() at
    once; `wake` is its read end. On every exit, BaseException included, every
    live probe group is first killed and reaped (kill_live_probes()), and then
    the handlers and wakeup descriptor in force when entered are restored."""

    def __init__(self):
        self.wake = None
        self.invocation = None
        self._own = False
        self._saved = {}
        self._pipe = None
        self._previous_wakeup = None

    def __enter__(self):
        self._own = not _invocations
        self.invocation = current_invocation()
        if self._own:
            self.invocation.__enter__()
        try:
            if _in_main_thread():
                self._pipe = os.pipe()
                for fd in self._pipe:
                    os.set_blocking(fd, False)
                record = self.invocation.record_signal

                def handler(signum, frame):
                    record(signum)

                self._saved = _install_handlers({signum: handler for signum in SCOPED_SIGNALS})
                self._previous_wakeup = signal.set_wakeup_fd(self._pipe[1], warn_on_full_buffer=False)
                self.wake = self._pipe[0]
        except BaseException:
            self._release()
            raise
        _signal_frames.append(self)
        return self

    def __exit__(self, *exc_info):
        try:
            kill_live_probes()
        finally:
            _signal_frames.remove(self)
            self._release()
        return False

    def _release(self):
        if self._previous_wakeup is not None:
            signal.set_wakeup_fd(self._previous_wakeup)
            self._previous_wakeup = None
        _restore_handlers(self._saved)
        self._saved = {}
        if self._pipe is not None:
            for fd in self._pipe:
                os.close(fd)
            self._pipe = self.wake = None
        if self._own:
            self._own = False
            self.invocation.__exit__(None, None, None)


def _raised(signum):
    return KeyboardInterrupt() if signum == signal.SIGINT else Terminated(signum)


class raising_signals:
    """The handlers of the removal question (D1, D15; research.md R4), for its
    own span: SIGINT raises KeyboardInterrupt, and SIGTERM or SIGHUP raises
    Terminated, each after recording the signal in the slot, so that input()
    is not resumed after a Ctrl-C. A signal already in the slot when the scope
    is entered raises at once. The handlers in force when entered are restored
    on every exit; the wakeup descriptor is left as it stands. No child runs
    under these handlers."""

    wake = None

    def __init__(self):
        self._saved = {}

    def __enter__(self):
        invocation = current_invocation()

        def handler(signum, frame):
            invocation.record_signal(signum)
            raise _raised(signum)

        if _in_main_thread():
            self._saved = _install_handlers({signum: handler for signum in SCOPED_SIGNALS})
        _signal_frames.append(self)
        if invocation.signal is not None:
            self.__exit__(None, None, None)
            raise _raised(invocation.signal)
        return self

    def __exit__(self, *exc_info):
        _signal_frames.remove(self)
        _restore_handlers(self._saved)
        self._saved = {}
        return False


class default_signals:
    """The handlers the process started with (research.md R4), around confirm()
    for push and delete-branch and before update's confirm() and delegates, so
    that they behave as before this change: the handlers, and the wakeup
    descriptor, in force before the outermost scope in force was entered (as
    they stand, when no scope is in force). The handlers and descriptor in
    force when entered are restored on every exit."""

    wake = None

    def __init__(self):
        self._saved = {}
        self._previous_wakeup = None

    def __enter__(self):
        if _signal_frames and _in_main_thread():
            first = _signal_frames[0]
            scope = next((frame for frame in _signal_frames
                          if isinstance(frame, signal_scope) and frame._previous_wakeup is not None), None)
            self._saved = _install_handlers(dict(first._saved))
            if scope is not None:
                try:
                    self._previous_wakeup = signal.set_wakeup_fd(scope._previous_wakeup)
                except BaseException:
                    _restore_handlers(self._saved)
                    self._saved = {}
                    raise
        _signal_frames.append(self)
        return self

    def __exit__(self, *exc_info):
        _signal_frames.remove(self)
        if self._previous_wakeup is not None:
            signal.set_wakeup_fd(self._previous_wakeup, warn_on_full_buffer=False)
            self._previous_wakeup = None
        _restore_handlers(self._saved)
        self._saved = {}
        return False


def signal_wakeup():
    """The read end of the innermost scope's wakeup pipe, or None when that
    scope records nothing (raising or default handlers) or none is in force."""
    return _signal_frames[-1].wake if _signal_frames else None


# The one-wide driver (design D1 and D2; data-model.md, "Driver outcome").

# The row error of each outcome (plan review M17); `interrupted` raises
# Interrupted instead of returning.
OUTCOME_ERRORS = {
    "complete": None,
    "complete-at-bound": None,
    "failed": "probe-failed",
    "timeout": "probe-timeout",
    "deadline": "deadline-exceeded",
}


class RawOutput:
    """The parser of a child read whole, as probe() reads it: no format and no
    bound. finish() returns the bytes."""

    bound_reached = False

    def __init__(self):
        self.data = bytearray()

    def feed(self, chunk):
        self.data += chunk

    def finish(self):
        return bytes(self.data)


class DriverOutcome:
    """What run_bounded() returns for one child: `name`, one of `complete`,
    `complete-at-bound`, `failed`, `timeout` and `deadline`; the parser's
    `result` (None when the child was cut or its stream did not parse); the
    exit `status` (None when none was observed); the first 4 KiB of standard
    error and `stderr_bytes`, the whole count; the child's `pid`; the argument
    vector; and `detail`, why it failed when no exit status says so. `error` is
    the outcome's row error (OUTCOME_ERRORS)."""

    def __init__(self, argv, name, result=None, status=None, stderr=b"", stderr_bytes=0,
                 pid=None, detail=None):
        self.argv = argv
        self.name = name
        self.result = result
        self.status = status
        self.stderr = bytes(stderr)
        self.stderr_bytes = stderr_bytes
        self.pid = pid
        self.detail = detail

    @property
    def error(self):
        return OUTCOME_ERRORS[self.name]

    def completed_process(self):
        """The outcome as git() returned it before the driver: a CompletedProcess
        with text streams decoded as subprocess's text mode decodes them (UTF-8,
        newlines translated; an undecodable byte kept by surrogateescape), its
        standard error the 4 KiB head. A child cut at its budget or deadline, one
        abandoned, or one never spawned gives status 2 and a message, as
        probe() gives for a timeout or an OSError."""
        if self.name in ("timeout", "deadline") or self.status is None:
            message = self.detail or f"git was stopped ({self.error})"
            return subprocess.CompletedProcess(self.argv, 2, "", message)
        return subprocess.CompletedProcess(self.argv, self.status, _process_text(self.result or b""),
                                           _process_text(self.stderr))

    def __repr__(self):
        return f"DriverOutcome({self.name!r}, status={self.status!r}, detail={self.detail!r})"


def _process_text(data):
    return data.decode("utf-8", "surrogateescape").replace("\r\n", "\n").replace("\r", "\n")


def git_refusal(run):
    """After the invocation's version check failed, or a configuration path
    failed D11's test in its place (hold_git_for_config_paths(); LQ-15), the
    CompletedProcess that git() returns without spawning anything (FR-053,
    plan review M10), its message the code's own, or None while Git may run."""
    version = run.version
    if version is None or version.code is None:
        return None
    if version.code == "git-too-old":
        message = TEXT["git_too_old"].format(VERSION=version.text)
    elif version.code == "relative-config-path":
        message = version.detail  # D18's lines, one per variable that failed
    else:
        message = TEXT["git_unavailable"].format(DETAIL=version.detail)
    return subprocess.CompletedProcess(["git"], 2, "", message)


def _drain(fd):
    while True:
        try:
            if not os.read(fd, 4096):
                return
        except (BlockingIOError, InterruptedError):
            return


def _settle(handle):
    """After an exception in the driver: a probe handle is stopped now; a
    removal or delegate handle is waited for, never signalled before a removal's
    ceiling (D1, D9; research.md R4). Either way it ends reaped or abandoned."""
    if handle.probe:
        handle.terminate_group()
    while not handle.finished:
        now = time.monotonic()
        if handle.state == "running":
            if handle.ceiling_end is not None and now >= handle.ceiling_end:
                handle.terminate_group()
            elif handle.reap() is None:
                try:
                    handle.process.wait(TIMING["selector_tick"])
                except subprocess.TimeoutExpired:
                    pass
            continue
        if not handle.advance(now):
            time.sleep(max(0.0, min(TIMING["selector_tick"], handle.due() - time.monotonic())))


def run_bounded(spec, parser, run):
    """Run one Git child through D1's loop and return its DriverOutcome.

    spec is (kind, args, cwd): the child is git_argv(kind, args) in cwd, a
    ChildHandle of that kind. parser is an incremental parser of standard
    output (feed(), finish(), bound_reached), or None to read it whole. run is
    the Invocation, which gives the budget (child_budget()), counts the child
    and holds the signal slot.

    One selector holds both pipes, non-blocking, and the read end of the
    innermost signal scope's wakeup pipe; its timeout is the least of the tick
    and the handle's next due time. Standard error is drained whenever readable
    and its first 4 KiB kept. On every tick a terminating or killing handle is
    advanced (R-30). The outcomes: `complete` when the child exits 0, its
    streams end and its stream parses; `failed` when it exits nonzero or by a
    signal, cannot be spawned, or its stream does not parse (a truncated or
    malformed last record, ParseError); `complete-at-bound` when the parser
    reaches its bound, the child then stopped; `timeout` when its budget, or a
    removal's ceiling, passes, or the handle is abandoned; `deadline` when the
    time left was the budget's limit, or none was left to spawn it. A probe
    child is stopped, and Interrupted raised, when the slot says so
    (Invocation.interrupting()); a removal or delegate child never is. On any
    exception a probe child is stopped and a removal or delegate child waited
    for before the exception goes on."""
    kind, args, cwd = spec
    argv = git_argv(kind, args)
    probe = GIT_KINDS[kind][0]
    if probe and run.interrupting():
        raise Interrupted(run.signal)
    budget, limit = run.child_budget(kind)
    if budget is not None and budget <= 0:
        return DriverOutcome(argv, "deadline", detail="no time was left to start it")
    if parser is None:
        parser = RawOutput()
    tick = getattr(parser, "tick", None)  # a removal's wait line (T092; lead ruling R-83, P-1)
    try:
        handle = ChildHandle.start(argv, cwd, kind)
    except OSError as exc:
        return DriverOutcome(argv, "failed", detail=f"cannot run {argv[0]}: {exc}")
    run.count_child(kind)
    if budget is not None:
        handle.budget_end = handle.started + budget
    if kind == "removal":
        handle.ceiling_end = handle.started + TIMING["removal_ceiling"]
    out, err = handle.process.stdout.fileno(), handle.process.stderr.fileno()
    streams = {out, err}
    selector = name = None
    try:
        # Set up inside the protected path, so that a failure here (EMFILE,
        # say) once the child runs still settles it: a removal is waited for.
        selector = selectors.DefaultSelector()
        for fd in streams:
            selector.register(fd, selectors.EVENT_READ)
        wake = signal_wakeup()
        if wake is not None:
            selector.register(wake, selectors.EVENT_READ)
        while not handle.finished:
            if tick is not None:
                tick(run)
            now = time.monotonic()
            if handle.advance(now):
                break
            if name is None:
                due = handle.due()
                if probe and run.interrupting():
                    name = "interrupted"
                elif due is not None and now >= due:
                    name = limit if handle.budget_end is not None and now >= handle.budget_end else "timeout"
                elif not streams and handle.reap() is not None:
                    break
                if name is not None:
                    handle.terminate_group()
                    continue
            due = handle.due()
            timeout = TIMING["selector_tick"] if due is None else min(TIMING["selector_tick"], due - now)
            timeout = max(0.0, timeout)
            if not streams:
                try:
                    handle.process.wait(timeout)
                except subprocess.TimeoutExpired:
                    pass
                continue
            for key, _ in selector.select(timeout):
                if key.fd == wake:
                    _drain(wake)
                    continue
                try:
                    chunk = os.read(key.fd, 65536)
                except (BlockingIOError, InterruptedError):
                    continue
                except OSError:
                    chunk = b""
                if not chunk:
                    selector.unregister(key.fd)
                    streams.discard(key.fd)
                elif key.fd == err:
                    handle.keep_stderr(chunk)
                    if hasattr(parser, "feed_stderr"):
                        parser.feed_stderr(chunk)
                elif name is None:
                    parser.feed(chunk)
                    if parser.bound_reached:
                        name = "complete-at-bound"
                        selector.unregister(out)
                        streams.discard(out)
                        handle.terminate_group()
    except BaseException:
        _settle(handle)
        raise
    finally:
        if selector is not None:
            selector.close()
        handle.close()
    if name == "interrupted":
        raise Interrupted(run.signal)
    status = handle.process.returncode if handle.state == "reaped" else None
    result = detail = None
    if handle.state == "abandoned":
        name, detail = "timeout", "the child did not end after SIGKILL"
    elif name is None or name == "complete-at-bound":
        try:
            result = parser.finish()
        except ParseError as exc:
            name, detail = "failed", str(exc)
        else:
            if name is None:
                name = "complete" if status == 0 else "failed"
    return DriverOutcome(argv, name, result, status, handle.stderr_head, handle.stderr_bytes,
                         handle.pid, detail)


def fs_call(fn, *args, budget=None):
    """Call fn(*args), a filesystem call (lstat, realpath, a read of `.git`,
    `gitdir`, a reflog or the manifest), on a daemon thread, abandoned at its
    budget (design D6; the project-clean delta's bounds): return its value,
    re-raise what it raised, an OSError among them, or, at the budget, return a
    DriverOutcome `timeout` (or `deadline` when the time left was the limit)
    while the thread stays blocked. budget defaults to the invocation's
    per-child budget. Never a concurrent.futures pool, whose shutdown waits for
    a stuck thread. A probe's interruption rule applies while it waits."""
    run = current_invocation()
    limit = "timeout"
    if budget is None:
        budget, limit = run.child_budget("probe")
    if budget <= 0:
        return DriverOutcome(None, limit, detail="no time was left to start it")
    box = []
    done = threading.Event()

    def call():
        try:
            box.append((True, fn(*args)))
        except BaseException as exc:
            box.append((False, exc))
        finally:
            done.set()

    threading.Thread(target=call, name="project fs_call", daemon=True).start()
    end = time.monotonic() + budget
    while not done.wait(max(0.0, min(TIMING["selector_tick"], end - time.monotonic()))):
        if run.interrupting():
            raise Interrupted(run.signal)
        if time.monotonic() >= end:
            return DriverOutcome(None, limit, detail=f"no answer within {budget:g} s")
    returned, value = box[0]
    if returned:
        return value
    raise value


class GitVersion:
    """The version check's result (FR-053; data-model.md, "Driver outcome"):
    `code`, None, `git-too-old` or `git-unavailable`; `version`, the numbers
    read, as (major, minor, patch); `text`, what followed `git version `; and
    `detail`, the git-unavailable detail as TEXT words it. Status, doctor and
    update memoize one with code `relative-config-path` in the check's place
    when a configuration path fails D11's test, so that no Git child starts,
    `git --version` included; its `detail` is then D18's lines
    (hold_git_for_config_paths(); Brett Heap's ruling LQ-15; lead ruling
    R-131 (b))."""

    def __init__(self, code, version=None, text=None, detail=None):
        self.code = code
        self.version = version
        self.text = text
        self.detail = detail

    def __repr__(self):
        return f"GitVersion({self.code!r}, {self.text!r}, detail={self.detail!r})"


GIT_VERSION_LINE = re.compile(r"git version ((\d+)\.(\d+)(?:\.(\d+))?.*)")


def git_version(run):
    """`git --version` once per invocation, memoized on run (FR-053, D17):
    `git-too-old` below GIT_FLOOR, `git-unavailable` for no git, a nonzero exit
    or a death by signal, a timeout, or a line it cannot parse; any outcome but
    `complete` is `git-unavailable`. The child is a probe, scrubbed and
    pinned."""
    if run.version is None:
        outcome = run_bounded(("probe", ["--version"], None), None, run)
        run.version = _read_git_version(outcome)
    return run.version


def _read_git_version(outcome):
    if outcome.name in ("timeout", "deadline"):
        return GitVersion("git-unavailable", detail=TEXT["git_unavailable_timed_out"])
    if outcome.status is None:
        return GitVersion("git-unavailable", detail=TEXT["git_unavailable_not_found"])
    if outcome.name != "complete":
        status = outcome.status if outcome.status >= 0 else 128 - outcome.status
        return GitVersion("git-unavailable", detail=TEXT["git_unavailable_exit"].format(N=status))
    lines = outcome.result.decode("utf-8", "replace").splitlines()
    match = GIT_VERSION_LINE.match(lines[0].strip()) if lines else None
    if not match:
        return GitVersion("git-unavailable", detail=TEXT["git_unavailable_unparseable_version"])
    version = (int(match[2]), int(match[3]), int(match[4] or 0))
    code = "git-too-old" if version[:2] < GIT_FLOOR else None
    return GitVersion(code, version, match[1].strip())
# endregion runner

# region parsers
class ParseError(ValueError):
    """A Git output stream that ended inside a record, or held one that is not
    in its format: the driver's outcome is then `failed` (design D2)."""


OBJECT_NAME = re.compile(rb"[0-9a-f]{40}|[0-9a-f]{64}")
UPSTREAM_TRACK = re.compile(rb"(?:ahead ([0-9]+))?(, )?(?:behind ([0-9]+))?")
INDEX_ENTRY = re.compile(rb"([A-Za-z]) ([0-7]{6}) ([0-9a-f]{40}|[0-9a-f]{64}) ([0-3])\t(.+)",
                         re.DOTALL)


def object_name(value):
    if not OBJECT_NAME.fullmatch(value):
        raise ParseError(f"not an object name: {value[:80]!r}")
    return value.decode("ascii")


class RecordStream:
    """The incremental parser of design D2: byte chunks go in through feed(),
    are split at `terminator` and handed to _take() one record at a time. It
    does no I/O, holds at most one partial record and exposes `bound_reached`.
    feed() never raises: a record not in the format becomes the failure that
    finish() raises, and every byte after it, or after the bound, is ignored.
    finish() returns the records, or raises ParseError for a truncated last
    record, unless the bound was reached first."""

    terminator = b"\0"

    def __init__(self):
        self.bound_reached = False
        self._partial = bytearray()
        self._failure = None

    def feed(self, chunk):
        if self.bound_reached or self._failure is not None:
            return
        buffer = self._partial
        scanned = len(buffer)
        buffer += chunk
        start = 0
        while (end := buffer.find(self.terminator, max(start, scanned))) >= 0:
            try:
                self._take(bytes(buffer[start:end]))
            except ParseError as exc:
                self._failure = exc
            start = end + 1
            if self.bound_reached or self._failure is not None:
                self._partial = bytearray()
                return
        del buffer[:start]

    def finish(self):
        if self._failure is not None:
            raise self._failure
        if not self.bound_reached and (self._partial or self._open()):
            raise ParseError(f"{type(self).__name__}: the last record is truncated")
        return self._result()

    def _open(self):
        return False


class StatusParser(RecordStream):
    """`status --porcelain=v1 -z`: two status letters, a space and a path, NUL
    terminated; a rename or copy (R or C in either column) is followed by its
    source path, which is not counted (design D2). `dirty` is true once a
    record other than an ignored one (`!!`) arrives, and false once an ignored
    record arrives first or the stream ends with none. The bound is the 65th
    ignored record or the 4,097th record of any kind, from LIMITS when the
    parser is made; the record that reaches it is not read. The first 8
    ignored paths are kept as raw bytes. `deletions_only` is D4's flag: true
    when every record read other than an ignored one is a tracked file deleted
    in the working tree (` D`), and at least one was read.

    finish() returns {dirty, ignored_files, ignored_files_truncated,
    ignored_samples, records, deletions_only}; `ignored_files` is null when
    the bound came before any ignored record (FR-056, D2, D4)."""

    LETTERS = b" MTADRCU?!"

    def __init__(self):
        super().__init__()
        self._ignored_bound = LIMITS["ignored_entries"]
        self._record_bound = LIMITS["status_records"]
        self._sample_bound = LIMITS["ignored_samples"]
        self.records = 0
        self.ignored = 0
        self.samples = []
        self.dirty = None
        self._deleted = None
        self._source_due = None

    def _take(self, field):
        if self._source_due is not None:
            if not field:
                raise ParseError("a rename or copy record has an empty source path")
            status, self._source_due = self._source_due, None
            self._read(status, None)
        elif (len(field) < 4 or field[2:3] != b" " or field[0] not in self.LETTERS
                or field[1] not in self.LETTERS):
            raise ParseError(f"not a status record: {field[:80]!r}")
        elif field[0] in b"RC" or field[1] in b"RC":
            self._source_due = field[:2]
        else:
            self._read(field[:2], field[3:])

    def _read(self, status, path):
        ignored = status == b"!!"
        if self.records >= self._record_bound or (ignored and self.ignored >= self._ignored_bound):
            self.bound_reached = True
            return
        self.records += 1
        if ignored:
            self.ignored += 1
            if self.dirty is None:
                self.dirty = False
            if len(self.samples) < self._sample_bound:
                self.samples.append(path)
        else:
            self.dirty = True
            self._deleted = self._deleted is not False and status == b" D"

    def _open(self):
        return self._source_due is not None

    def _result(self):
        return {"dirty": False if self.dirty is None and not self.bound_reached else self.dirty,
                "ignored_files": None if self.bound_reached and not self.ignored else self.ignored,
                "ignored_files_truncated": self.bound_reached,
                "ignored_samples": list(self.samples),
                "records": self.records,
                "deletions_only": self._deleted is True}


class WorktreeListParser(RecordStream):
    """`worktree list --porcelain -z`: NUL-terminated attributes, an empty one
    ending each entry (design D2). finish() returns one dict per entry, in
    order: `path` (bytes); `head` (hex text, None for a bare entry); `branch`
    (the full refname as bytes, or None); `bare`, `detached`, `locked` and
    `prunable`; and `locked_reason` and `prunable_reason` (bytes, or None when
    Git printed no reason). An attribute it does not know is skipped, as Git
    may add some. No bound."""

    def __init__(self):
        super().__init__()
        self.entries = []
        self._entry = None

    def _take(self, field):
        entry = self._entry
        if entry is None:
            if not field.startswith(b"worktree ") or len(field) == 9:
                raise ParseError(f"a registry entry must start with its path: {field[:80]!r}")
            self._entry = {"path": field[9:], "head": None, "branch": None, "bare": False,
                           "detached": False, "locked": False, "locked_reason": None,
                           "prunable": False, "prunable_reason": None}
            return
        name, space, value = field.partition(b" ")
        if not field:
            self.entries.append(entry)
            self._entry = None
        elif field in (b"bare", b"detached"):
            entry[field.decode()] = True
        elif name == b"HEAD":
            entry["head"] = object_name(value)
        elif name == b"branch":
            if not value:
                raise ParseError("a registry entry names an empty branch")
            entry["branch"] = value
        elif name in (b"locked", b"prunable"):
            entry[name.decode()] = True
            entry[name.decode() + "_reason"] = value if space else None

    def _open(self):
        return self._entry is not None

    def _result(self):
        return list(self.entries)


class RefParser(RecordStream):
    """Design D6 row 6: `%(refname)`, `%(objectname)`, `%(symref)`,
    `%(upstream)`, `%(upstream:short)` and `%(upstream:track,nobracket)`,
    NUL-separated, a line feed ending each record. finish() returns one dict
    per ref, in order: `refname`, `symref`, `upstream` and `upstream_short`
    (bytes, None when empty); `objectname` (hex text); and from the track,
    `remote_present` (None without an upstream, false when it is `gone`) and
    `ahead` and `behind` (ints; None without an upstream or when it is gone).
    No bound."""

    terminator = b"\n"

    def __init__(self):
        super().__init__()
        self.refs = []

    def _take(self, line):
        fields = line.split(b"\0")
        if len(fields) != 6 or not fields[0]:
            raise ParseError(f"not a ref record: {line[:160]!r}")
        refname, objectname, symref, upstream, short, track = fields
        if bool(upstream) != bool(short) or (track and not upstream):
            raise ParseError(f"an upstream without its short name or track: {line[:160]!r}")
        present = ahead = behind = None
        if upstream:
            present = track != b"gone"
            if present:
                match = UPSTREAM_TRACK.fullmatch(track)
                if not match or bool(match[2]) != bool(match[1] and match[3]):
                    raise ParseError(f"not an upstream track: {track[:80]!r}")
                ahead, behind = int(match[1] or 0), int(match[3] or 0)
        self.refs.append({"refname": refname, "objectname": object_name(objectname),
                          "symref": symref or None, "upstream": upstream or None,
                          "upstream_short": short or None, "remote_present": present,
                          "ahead": ahead, "behind": behind})

    def _result(self):
        return list(self.refs)


class MergedSetParser(RecordStream):
    """Design D6 row 7: one refname per line, the local branches merged into the
    merge target. finish() returns them as a frozenset of bytes. No bound."""

    terminator = b"\n"

    def __init__(self):
        super().__init__()
        self.refnames = set()

    def _take(self, line):
        if not line:
            raise ParseError("an empty refname in the merged set")
        self.refnames.add(line)

    def _result(self):
        return frozenset(self.refnames)


class HiddenStateParser(RecordStream):
    """`ls-files -v --stage -z`: a tag letter, a space, the mode, the object
    name and the stage, a tab and the path, NUL-terminated (design D2). The
    bound is the first entry of mode 160000, a gitlink, which sets `gitlink`;
    before it, a lowercase tag (assume-unchanged) or `S` (skip-worktree) sets
    `hidden`. finish() returns {gitlink, hidden, entries}, `entries` counting
    the entries read before the bound."""

    def __init__(self):
        super().__init__()
        self.entries = 0
        self.gitlink = False
        self.hidden = False

    def _take(self, field):
        match = INDEX_ENTRY.fullmatch(field)
        if not match:
            raise ParseError(f"not an index entry: {field[:160]!r}")
        if match[2] == b"160000":
            self.gitlink = self.bound_reached = True
            return
        self.entries += 1
        if match[1].islower() or match[1] == b"S":
            self.hidden = True

    def _result(self):
        return {"gitlink": self.gitlink, "hidden": self.hidden, "entries": self.entries}
# endregion parsers

# region escaping
# FR-039 to FR-041. A code point of these general categories, as this
# interpreter's unicodedata reports them, never reaches a terminal or a JSON
# document raw. The escaping_ and ESCAPING_ names are this region's helpers.
ESCAPING_CATEGORIES = frozenset(("Cc", "Cf", "Zl", "Zp"))


def escaping_decode(raw):
    """Return (text, valid): raw decoded as strict UTF-8 and True, or, when
    raw is not valid UTF-8, decoded with each undecodable byte as one lone
    surrogate U+DC80 to U+DCFF (surrogateescape) and False. raw is the path's
    bytes; a str or path object is taken as os.fsencode() gives its bytes."""
    if isinstance(raw, (bytes, bytearray, memoryview)):
        raw = bytes(raw)
    else:
        raw = os.fsencode(raw)
    try:
        return raw.decode("utf-8"), True
    except UnicodeDecodeError:
        return raw.decode("utf-8", "surrogateescape"), False


def escaping_byte(char):
    """The undecodable byte that surrogateescape held as char, as \\xHH."""
    return f"\\x{ord(char) - 0xDC00:02x}"


def json_path(raw):
    """Return (text, path_valid_utf8) for a path in a JSON document.

    Valid UTF-8 gives the exact text, which json.dumps, with its default
    ensure_ascii, writes with every Cc, Cf, Zl and Zp code point as an escape.
    Any other path gives each undecodable byte as the four characters \\xHH
    in lower case and each literal backslash doubled, so the text maps back
    to the bytes and holds no surrogate; its flag is False."""
    text, valid = escaping_decode(raw)
    if valid:
        return text, True
    out = []
    for char in text:
        if 0xDC80 <= ord(char) <= 0xDCFF:
            out.append(escaping_byte(char))
        elif char == "\\":
            out.append("\\\\")
        else:
            out.append(char)
    return "".join(out), False


def human_path(raw, command=False):
    """Return a path as human output prints it.

    A valid UTF-8 path with no Cc, Cf, Zl or Zp code point prints verbatim
    in prose and shlex.quote()d in a command. Any other path prints in the
    $'...' form in both: \\xHH for an undecodable byte, \\uXXXX, or
    \\UXXXXXXXX above U+FFFF, for a code point to escape, all in lower case;
    each backslash doubled and each single quote written \\'."""
    text, valid = escaping_decode(raw)
    if valid and not any(unicodedata.category(char) in ESCAPING_CATEGORIES for char in text):
        return shlex.quote(text) if command else text
    out = []
    for char in text:
        point = ord(char)
        if not valid and 0xDC80 <= point <= 0xDCFF:
            out.append(escaping_byte(char))
        elif char == "\\":
            out.append("\\\\")
        elif char == "'":
            out.append("\\'")
        elif unicodedata.category(char) in ESCAPING_CATEGORIES:
            out.append(f"\\u{point:04x}" if point <= 0xFFFF else f"\\U{point:08x}")
        else:
            out.append(char)
    return "$'" + "".join(out) + "'"
# endregion escaping

# region evidence
# The one evidence model of a repository (design D4, D6, D7 and D8;
# data-model.md, "Repository identity", "Merge target", "Worktree row",
# "Worktree identity and registration", "Branch evidence" and
# "Classification"; FR-006, FR-007 and FR-053 to FR-061).

# The ladder's text, verbatim from cleanup_report() at 961c405 (project:566-616):
# the recommendation of each class, and the second text of the two classes that
# have a second rung (:580 and :613).
RECOMMENDATIONS = {
    "stale-worktree": "Review and prune stale worktree metadata manually.",
    "protected-default": "Keep the default branch; use the repository's normal push or PR process.",
    "inspection-error": "Preserve this worktree; Git could not establish its clean state.",
    "dirty": "Preserve or commit the working changes before cleanup.",
    "ignored-local-files": "Preserve or relocate ignored local files before cleanup.",
    "detached": "Preserve the detached commit or attach it to a named branch before cleanup.",
    "unpublished": "Push or otherwise preserve the branch before removing its worktree.",
    "remote-gone": "Confirm the branch should be republished before removing local work.",
    "review-required": "Remote tracking state could not be established from local refs; preserve it for review.",
    "diverged": "Reconcile the diverged branch through the normal Git workflow before cleanup.",
    "remote-ahead": "Fetch and reconcile the newer remote branch before cleanup.",
    "unpushed": "Use an explicit clean push, then continue through the normal review process.",
    "merged-removable": "This clean, merged, non-current worktree may be removed explicitly.",
    "merged-current": "The branch is merged, but this is the current checkout; switch away before removal.",
    "pushed-unmerged": "Continue through the repository's normal pull-request or merge process.",
}
SECOND_RECOMMENDATIONS = {
    "inspection-error": "Preserve this worktree; Git could not establish its ignored-file state.",
    "review-required": "Merge state could not be established from local refs; preserve it for review.",
}


def classify(row, merge_target):
    """The ladder (D6, FR-007; data-model.md, "Classification"): a pure
    function of a worktree row's fields and the merge target's name, returning
    (classification, recommendation). It runs no child and reads no file.

    First, a row whose evidence could not be established is `inspection-error`
    whatever its branch, so that a failed probe on the merge target's checkout
    is never `protected-default` (D-A): `present` null, any row error, or a
    present row with no `dirty`, whose registration disagreed or whose status
    probe failed. Then the first rung that holds, in the baseline's order with
    its one reorder (Brett Heap's ruling on open question 1): a row whose
    configured upstream's remote-tracking ref is gone is `merged-removable`, or
    `merged-current` when current, if it is merged into the target, and
    `remote-gone` otherwise. `review-required` stays a defensive rung that no
    row of the evidence model reaches, and so does the second
    `inspection-error` rung, for an unknown ignored-file count."""
    present = row.get("present")
    if present is None or row.get("errors") or (present and row.get("dirty") is None):
        return "inspection-error", RECOMMENDATIONS["inspection-error"]
    branch = row.get("branch", "detached")
    merged = row.get("merged_into_target")
    if not present:
        name = "stale-worktree"
    elif branch == merge_target:
        name = "protected-default"
    elif row.get("dirty") is None:
        name = "inspection-error"
    elif row.get("dirty"):
        name = "dirty"
    elif row.get("ignored_files") is None:
        return "inspection-error", SECOND_RECOMMENDATIONS["inspection-error"]
    elif row.get("ignored_files"):
        name = "ignored-local-files"
    elif branch == "detached":
        name = "detached"
    elif not row.get("upstream"):
        name = "unpublished"
    elif row.get("remote_present") is False:
        if merged is True:
            name = "merged-current" if row.get("current") else "merged-removable"
        else:
            name = "remote-gone"
    elif row.get("ahead") is None or row.get("behind") is None:
        name = "review-required"
    elif row["ahead"] > 0 and row["behind"] > 0:
        name = "diverged"
    elif row["behind"] > 0:
        name = "remote-ahead"
    elif row["ahead"] > 0:
        name = "unpushed"
    elif merged is True and not row.get("current"):
        name = "merged-removable"
    elif merged is True:
        name = "merged-current"
    elif merged is None:
        return "review-required", SECOND_RECOMMENDATIONS["review-required"]
    else:
        name = "pushed-unmerged"
    return name, RECOMMENDATIONS[name]


def partial_removal_note(row, status, main):
    """D4's row notes, added after the ladder by this separate function (OQ-28,
    FR-009): ["partially-removed"] for a linked worktree (main false) that is
    present and `dirty`, whose status records read, other than ignored ones,
    are all tracked files deleted in the working tree (` D`, StatusParser's
    `deletions_only`), judged on the records read when the stream stopped at
    its bound; [] otherwise. status is the combined probe's result, which only
    a present, registration-verified row has (None otherwise). The note changes
    no class, rung or gate."""
    if main or status is None or row.get("present") is not True or row.get("dirty") is not True:
        return []
    return ["partially-removed"] if status["deletions_only"] else []


def declared_tracking_branch(root):
    """The merge target's first candidate (D8, FR-018, FR-060; T108): the
    manifest's `tracking_branch` at root, the main worktree (bytes or str), or
    None without a manifest or the key. The manifest is the first of
    `project.yaml` and `family.yaml` that is a regular file, as manifest()
    picks it, and each is examined by one bounded filesystem call (fs_call()):
    a stat, then, only for a regular file of at most LIMITS["manifest_bytes"]
    (1 MiB) by `st_size`, a read that asks for at most 1 MiB, the size checked
    again by fstat on the opened file (lead ruling R-4). It is parsed from the
    bytes read; read_yaml() is never called, so it reads nothing unbounded.

    Every refusal is `manifest-invalid`: over 1 MiB, TEXT
    `manifest_invalid_size`, with nothing read; otherwise the baseline
    messages of read_yaml() and manifest() (lead ruling R-45 (6)): `Cannot
    read PATH: ...` for an OSError, a call cut at its budget or a parse
    error, `Expected a mapping in PATH`, `Unexpected kind in PATH; expected
    KIND`, and read_yaml()'s own message when PyYAML is missing. A parse
    error is anything safe_load() raises, not only YAMLError and
    UnicodeError: PyYAML raises ValueError for an impossible date such as
    `released: 2021-02-30`, KeyError for `!!bool maybe`, AttributeError for
    a malformed `!!timestamp` and RecursionError for deep nesting, so every
    caller treats such a manifest as one that does not parse: clean refuses
    it, status, doctor and update report on (lane 3's US7/US9 M-1). The
    signal exceptions are not Exceptions and pass. A refusal carries no
    context; the resolution adds the repository (lead ruling R-53, P-12)."""
    limit = LIMITS["manifest_bytes"]
    base = Path(os.fsdecode(root))

    def examine(path):
        # ("absent", None) where Path.is_file() is false, ("over", None) past
        # the cap by st_size or fstat, else ("read", at most `limit` bytes).
        try:
            found = os.stat(path)
        except OSError as exc:
            if exc.errno in (errno.ENOENT, errno.ENOTDIR, errno.EBADF, errno.ELOOP):
                return "absent", None
            raise
        if not stat.S_ISREG(found.st_mode):
            return "absent", None
        if found.st_size > limit:
            return "over", None
        with open(path, "rb") as stream:
            if os.fstat(stream.fileno()).st_size > limit:
                return "over", None
            return "read", stream.read(limit)

    for filename, kind in (("project.yaml", "project-manifest"), ("family.yaml", "family-manifest")):
        path = base / filename
        try:
            found = fs_call(examine, str(path))
        except OSError as exc:
            raise Refused(f"Cannot read {human_path(os.fsencode(path))}: {exc}", code="manifest-invalid") from exc
        if isinstance(found, DriverOutcome):
            raise Refused(f"Cannot read {human_path(os.fsencode(path))}: {found.detail}", code="manifest-invalid")
        state, data = found
        if state == "absent":
            continue
        if state == "over":
            raise Refused(TEXT["manifest_invalid_size"].format(PATH=human_path(os.fsencode(path))),
                          code="manifest-invalid")
        try:
            import yaml
        except ImportError as exc:
            raise Refused("YAML inspection needs PyYAML; use a workBench with python3-yaml installed.",
                          code="manifest-invalid") from exc
        try:
            value = yaml.safe_load(data.decode("utf-8"))
        except Exception as exc:  # any failure to load it, a YAMLError or not, is a parse error
            raise Refused(f"Cannot read {human_path(os.fsencode(path))}: {exc}", code="manifest-invalid") from exc
        if not isinstance(value, dict):
            raise Refused(f"Expected a mapping in {human_path(os.fsencode(path))}", code="manifest-invalid")
        if value.get("kind") != kind:
            raise Refused(f"Unexpected kind in {human_path(os.fsencode(path))}; expected {kind}", code="manifest-invalid")
        return value.get("tracking_branch")
    return None


def resolve_merge_target(refs, declared):
    """The merge target (D8, FR-018; data-model.md, "Merge target") over row
    6's refs (RefParser's records): the first candidate that exists as a local
    branch, in this order: declared, the manifest's `tracking_branch`, less a
    leading `origin/` (source `manifest`); the symref of
    `refs/remotes/origin/HEAD`, less `refs/remotes/origin/` (`origin-head`);
    `main`; `master`. Returns {name, source, sha, notes}, sha that branch's
    head. notes holds the `merge-target-conflict` note, a {code, message}
    object from TEXT `note_merge_target_conflict`, when the manifest's
    candidate and the `origin/HEAD` one both exist as local branches and
    differ: the manifest wins (T108; lead ruling R-56, settling P-13), and
    build_plan() moves the note to the plan's notes; it is empty otherwise.
    With no candidate it refuses `no-merge-target` with the baseline message
    (project:551 at 961c405)."""
    heads = {ref["refname"]: ref["objectname"] for ref in refs}

    def head(name):
        return heads.get(b"refs/heads/" + name.encode("utf-8", "surrogateescape")) if name else None

    candidates = []
    if isinstance(declared, str):
        candidates.append((declared.removeprefix("origin/"), "manifest"))
    origin = b"refs/remotes/origin/"
    for ref in refs:
        if ref["refname"] == origin + b"HEAD" and (ref["symref"] or b"").startswith(origin):
            candidates.append((ref["symref"][len(origin):].decode("utf-8", "surrogateescape"), "origin-head"))
    candidates += [("main", "main"), ("master", "master")]
    for name, source in candidates:
        sha = head(name)
        if sha:
            target = {"name": name, "source": source, "sha": sha, "notes": []}
            break
    else:
        raise Refused(TEXT["no_merge_target"], code="no-merge-target")
    if target["source"] == "manifest":
        for other, source in candidates:
            if source == "origin-head" and other != target["name"] and head(other):
                shown = [human_path(value.encode("utf-8", "surrogateescape")) for value in (target["name"], other)]
                target["notes"].append({"code": "merge-target-conflict", "message": TEXT[
                    "note_merge_target_conflict"].format(NAME=shown[0], OTHER=shown[1])})
    return target


# The probes (D6, D7 and D8; FR-055 to FR-057). Every Git child runs through
# run_bounded() with its parser, and every filesystem call through fs_call();
# a failed driver outcome becomes a row error by OUTCOME_ERRORS as built (plan
# review M17), its message the contract's text for its code (lead ruling R-45
# (4)). Paths stay bytes until a document writes them.
#
# Each evidence step is split in two (lead ruling R-54 X-1): a reader, which
# makes the step's filesystem calls and Git children in D6's order and stops
# where a value already decides, and a pure decider over the values read,
# which runs no child and makes no filesystem call, so that another driver
# (feature 005's overview) can feed it values it read itself:
# presence_from_lstat(), registration_verdict(), main_worktree_decision(),
# shared_identities() and row_evidence(). The functions the other regions
# call, main_worktree(), verify_registration(), inspect_repository() and
# worktree_rows(), are those readers, each ending in its decider.

# Row 3's options, in the order Git prints their values (D6).
IDENTITY_OPTIONS = ("--show-toplevel", "--git-common-dir", "--show-superproject-working-tree")
# Row 6's format (D6): NUL-separated fields, a line feed ending each record.
REF_FORMAT = ("%(refname)%00%(objectname)%00%(symref)%00%(upstream)%00%(upstream:short)"
              "%00%(upstream:track,nobracket)")
# The combined status probe of a worktree, after its `-C PATH` (D6, D11).
STATUS_PROBE = ("status", "--porcelain=v1", "-z", "--untracked-files=normal", "--ignored=matching")
# The most read of a `.git` file or an admin `gitdir` file, each one path.
GITFILE_BYTES = 65536
# A branch named HEAD. For refs/heads/HEAD, row 6's `for-each-ref` prints the
# upstream and track of the branch that HEAD names where it runs, whatever
# `branch.HEAD.*` says (checked on Git 2.43.0), so no upstream evidence of such
# a branch is read from row 6 (lead ruling R-61 (b)).
HEAD_BRANCH_REF = b"refs/heads/HEAD"


class WorktreeRow(dict):
    """One worktree row (data-model.md, "Worktree row"). As a dict it holds
    what a document writes, in WORKTREE_ROW_KEYS's order, `prunable` only on a
    stale row whose registry record says so (plan review M11). As attributes it
    holds the evidence no document writes: `raw_path`, the path's bytes (the
    registry's, or the main worktree's realpath where the first record is the
    common directory); `main`; the worktree identity `dev`, `ino` and
    `admin_id` (D7), None until established; `registered`, the two-way
    registration (None when it was not read); `upstream_oid`, the upstream's
    object, None when it is gone or none is configured; `status`, the combined
    probe's result, None when it did not run or failed; and `unprobed`, the
    marker that a read not finished within its filesystem budget sets (T066;
    analyze M6), never serialized and unset here."""

    raw_path = None
    main = False
    dev = ino = admin_id = None
    registered = None
    upstream_oid = None
    status = None
    unprobed = False


class EvidenceError(Exception):
    """A filesystem call of the evidence model that gave no value: `error`,
    its row error object, and `errno`, the OSError's number, or None for a call
    cut at its budget. Caught inside this region; never a refusal."""

    def __init__(self, error, number=None):
        super().__init__(error["message"])
        self.error = error
        self.errno = number


def _evidence_text(raw):
    return raw.decode("utf-8", "surrogateescape")


def git_operation(subcommand):
    """OPERATION of a Git child's row error: `git SUBCOMMAND`."""
    return TEXT["row_error_git_operation"].format(SUBCOMMAND=subcommand)


def unparseable_error(subcommand):
    """The row error {code, message} of a `git SUBCOMMAND` child whose output
    gives no usable value: `probe-failed`, DETAIL `unparseable output`."""
    return {"code": "probe-failed", "message": TEXT["row_error_probe_failed"].format(
        OPERATION=git_operation(subcommand), DETAIL=TEXT["row_error_probe_failed_unparseable"])}


def probe_error(outcome, operation, budget):
    """The row error object {code, message} of a failed driver outcome, or
    None for a complete one (data-model.md, "Driver outcome"): the code by
    OUTCOME_ERRORS, as built (M17), and the contract's message for it
    (contracts/project-clean.md, "Codes"). operation is OPERATION; budget the
    seconds the child or call was given, S of `probe-timeout`."""
    code = outcome.error
    if code is None:
        return None
    if code == "probe-failed":
        status = outcome.status
        if status is None:
            match = re.search(r"\[Errno (\d+)\]", outcome.detail or "")
            reason = os.strerror(int(match[1])) if match else (outcome.detail or "")
            detail = TEXT["row_error_probe_failed_cannot_spawn"].format(STRERROR=reason)
        elif status < 0:
            detail = TEXT["row_error_probe_failed_signal"].format(N=-status)
        elif status > 0:
            detail = TEXT["row_error_probe_failed_exit"].format(N=status)
        else:
            detail = TEXT["row_error_probe_failed_unparseable"]
        message = TEXT["row_error_probe_failed"].format(OPERATION=operation, DETAIL=detail)
    elif code == "probe-timeout":
        message = TEXT["row_error_probe_timeout"].format(OPERATION=operation, S=f"{budget:g}")
    else:
        message = TEXT["row_error_deadline_exceeded"].format(OPERATION=operation)
    return {"code": code, "message": message}


def os_error(operation, exc):
    """The `os-error` row error {code, message} of the OSError exc that a
    filesystem call raised; operation is OPERATION: lstat, realpath or read."""
    return {"code": "os-error",
            "message": TEXT["row_error_os_error"].format(OPERATION=operation, STRERROR=exc.strerror or str(exc))}


def _fs(operation, fn, *args):
    """fn(*args) through fs_call() (D6): its value. An OSError raises
    EvidenceError with an `os-error` and the error number; a call past its
    budget raises EvidenceError with `probe-timeout` or `deadline-exceeded`.
    operation is OPERATION: lstat, realpath or read."""
    budget, _ = current_invocation().child_budget("probe")
    try:
        value = fs_call(fn, *args)
    except OSError as exc:
        raise EvidenceError(os_error(operation, exc), exc.errno) from None
    if isinstance(value, DriverOutcome):
        raise EvidenceError(probe_error(value, operation, budget))
    return value


def _direct(operation, fn, *args):
    """fn(*args) called at once, as _fs() calls it but with no fs_call() of
    its own: for reads that already run together inside one fs_call() (its
    one thread and one budget; _identity_now()). An OSError raises
    EvidenceError with its `os-error` for operation and its error number."""
    try:
        return fn(*args)
    except OSError as exc:
        raise EvidenceError(os_error(operation, exc), exc.errno) from None


def _lstat(path):
    """The lstat of path through fs_call(): its value, or the EvidenceError of
    a call that gave none, for presence_from_lstat()."""
    try:
        return _fs("lstat", os.lstat, path)
    except EvidenceError as exc:
        return exc


def presence_from_lstat(result):
    """The presence of a registered path (D6, FR-055; lead ruling R-36), a
    pure decider over what its lstat gave: (present, error). result is the
    lstat's value, or the OSError or EvidenceError of a call that gave none.
    A value is (True, None); ENOENT or ENOTDIR, the path gone or a parent no
    longer a directory, is (False, None); any other failure, a call cut at
    its budget included, is (None, its row error), an OSError's being its
    `os-error` for OPERATION lstat."""
    if isinstance(result, EvidenceError):
        number, error = result.errno, result.error
    elif isinstance(result, OSError):
        number, error = result.errno, os_error("lstat", result)
    else:
        return True, None
    if number in (errno.ENOENT, errno.ENOTDIR):
        return False, None
    return None, error


def _read_head(path, limit):
    with open(path, "rb") as stream:
        return stream.read(limit)


def _realpath(path, fs=_fs):
    return fs("realpath", os.path.realpath, path)


def _git(run, directory, args, subcommand, parser=None, kind="probe"):
    """One Git child, `-C directory ARGS` of kind, through run_bounded():
    (outcome, error), error the row error of a failed outcome, else None."""
    budget, _ = run.child_budget(kind)
    outcome = run_bounded((kind, ["-C", directory, *args], None), parser, run)
    return outcome, probe_error(outcome, git_operation(subcommand), budget)


def identity_probe(directory, run):
    """Row 3 in directory (D6): `rev-parse --path-format=absolute` with
    IDENTITY_OPTIONS, which prints one value per line and has no NUL form. Two
    lines are a checkout's toplevel and common directory; any other count, a
    submodule's third line or a value holding a line feed, is read again one
    option per child, each child's output one value. Returns ((toplevel,
    common_dir, superproject), None) as raw bytes, superproject None where Git
    printed none, or (None, error) when a child failed."""
    outcome, error = _git(run, directory, ["rev-parse", "--path-format=absolute", *IDENTITY_OPTIONS],
                          "rev-parse")
    if error is not None:
        return None, error
    lines = outcome.result.split(b"\n")
    if lines[-1] == b"":
        lines.pop()
    if len(lines) == 2 and all(lines):
        return (lines[0], lines[1], None), None
    values = []
    for option in IDENTITY_OPTIONS:
        outcome, error = _git(run, directory, ["rev-parse", "--path-format=absolute", option], "rev-parse")
        if error is not None:
            return None, error
        value = outcome.result
        values.append((value[:-1] if value.endswith(b"\n") else value) or None)
    if values[0] is None or values[1] is None:
        return None, unparseable_error("rev-parse")
    return tuple(values), None


def gitdir_line(content):
    """The value of a `.git` file's gitdir line, read as Git reads one: the
    content, less its trailing line ends, starting `gitdir: ` with a value
    after it; None otherwise. A pure function of the bytes read."""
    content = content.rstrip(b"\r\n")
    if not content.startswith(b"gitdir: ") or content == b"gitdir: ":
        return None
    return content[len(b"gitdir: "):]


def _gitfile(path, fs=_fs):
    """The realpath that `<path>/.git` names when it is a gitfile: a regular
    file holding a gitdir line (gitdir_line()), a relative value resolved
    against path. None when `.git` is missing, not a regular file, or holds no
    gitdir line; any other failed read raises EvidenceError. fs makes each
    read: _fs(), or _direct() inside one fs_call()."""
    dotgit = os.path.join(path, b".git")
    try:
        mode = fs("lstat", os.lstat, dotgit).st_mode
    except EvidenceError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return None
        raise
    if not stat.S_ISREG(mode):
        return None
    value = gitdir_line(fs("read", _read_head, dotgit, GITFILE_BYTES))
    return None if value is None else _realpath(os.path.join(path, value), fs)


def _admin_gitdir(admin, fs=_fs):
    """The realpath that the `gitdir` file of the admin directory admin names,
    a relative value resolved against admin; None when that file is missing
    or holds nothing. Any other failed read raises EvidenceError. fs as for
    _gitfile()."""
    try:
        back = fs("read", _read_head, os.path.join(admin, b"gitdir"), GITFILE_BYTES).rstrip()
    except EvidenceError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return None
        raise
    return _realpath(os.path.join(admin, back), fs) if back else None


def _admin_commondir(admin, fs=_fs):
    """The realpath of the common directory that the admin directory admin's
    `commondir` file names, as Git's get_common_dir_noenv() reads it
    (setup.c:301-325 at 2.36.6, :316-340 at 2.43.7; lead ruling R-125;
    change 1 as amended at 93f3194): the file's trailing line feeds and
    carriage returns removed, a relative value resolved against admin. With
    no such file Git takes admin as its own common directory, and so does
    this. Any other failed read raises EvidenceError. fs as for _gitfile()."""
    try:
        value = fs("read", _read_head, os.path.join(admin, b"commondir"), GITFILE_BYTES).rstrip(b"\r\n")
    except EvidenceError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return admin
        raise
    return _realpath(os.path.join(admin, value), fs)


def main_worktree_decision(identity, records, core_worktree, candidate_gitfiles):
    """The main worktree (D8, FR-055; analyze H4, lead rulings R-36, R-42 and
    R-51 (a)), a pure decider over values already read: (path, None), or
    (None, cause) where none can be named; never a refusal. records is row
    4's. identity holds `common_dir`, row 3's realpath of the common
    directory, and the first registry record's `first_present`
    (presence_from_lstat()) and `first_realpath`. core_worktree is the
    realpath that `core.worktree` names (row 4b), a relative value resolved
    against the git directory, or None where it is unset; candidate_gitfiles
    maps each candidate toplevel, in order, to the realpath its `.git` file
    names, or None.

    D8's order after its submodule step, which is the resolution's: no
    record gives `missing`; a first record that is `bare`, `bare`; one not
    present, `missing`; one whose presence is unknown, or whose realpath was
    not read, `unreadable`; one whose realpath is not the common directory is
    the main worktree; otherwise, the gitfile layout, core_worktree, or else
    the first candidate whose `.git` file names the common directory, and
    else `unnamed`. A value an earlier step decides without is not read by
    main_worktree() and may be None here."""
    if not records:
        return None, "missing"
    if records[0]["bare"]:
        return None, "bare"
    present, path = identity["first_present"], identity["first_realpath"]
    if present is False:
        return None, "missing"
    if present is None or path is None:
        return None, "unreadable"
    if path != identity["common_dir"]:
        return path, None
    if core_worktree is not None:
        return core_worktree, None
    for candidate, named in candidate_gitfiles.items():
        if named == identity["common_dir"]:
            return candidate, None
    return None, "unnamed"


def main_worktree(identity, records, run):
    """The main worktree's realpath (D8, FR-055; analyze H4, lead rulings R-42
    and R-51 (a)): (path, None), or (None, cause) where none can be named. It
    never refuses: the resolution refuses (T107), while a reader that reports
    such a repository reports it. identity holds `common_dir` and `toplevel`,
    row 3's realpaths, and `directory`, where row 3 ran; records is row 4's.

    D8's order after its submodule step, which is the resolution's: a first
    registry record that is `bare` gives cause `bare`; one that does not exist
    gives `missing`; one whose realpath is the common directory (a main
    checkout whose `.git` is a file) is named by the realpath of
    `core.worktree` (row 4b, run where row 3 ran), a relative value resolved
    against the git directory (lead ruling R-36), or where that is unset by
    the candidate toplevel whose `.git` file names the common directory, and
    else gives `unnamed`; any other first record is named by its realpath. A
    read that fails gives `unreadable`.

    The reader of main_worktree_decision(): it reads, in that order, only
    what the decision has not yet settled, the toplevel being the one
    candidate, and decides there."""
    common_dir = identity["common_dir"]
    facts = {"common_dir": common_dir, "first_present": None, "first_realpath": None}
    core_worktree, candidate_gitfiles = None, {}
    try:
        if records and not records[0]["bare"]:
            first = records[0]["path"]
            facts["first_present"], _ = presence_from_lstat(_lstat(first))
            if facts["first_present"]:
                facts["first_realpath"] = _realpath(first)
                if facts["first_realpath"] == common_dir:
                    outcome, error = _git(run, identity["directory"], ["config", "--get", "core.worktree"],
                                          "config")
                    if error is None:
                        value = outcome.result[:-1] if outcome.result.endswith(b"\n") else outcome.result
                        if value:
                            core_worktree = _realpath(os.path.join(common_dir, value))
                    elif outcome.status != 1:  # 1 is `config --get`'s answer for an unset key
                        return None, "unreadable"
                    candidate = identity["toplevel"]
                    if core_worktree is None and candidate is not None:
                        candidate_gitfiles[candidate] = _gitfile(candidate)
    except EvidenceError:
        return None, "unreadable"
    return main_worktree_decision(facts, records, core_worktree, candidate_gitfiles)


def registration_verdict(main, common_dir, named, worktrees=None, back=None, dotgit=None, shared=False,
                         commondir=None):
    """The two-way registration of a present worktree (D7, FR-055; lead
    rulings R-57 L3, R-59 D5 and R-125), a pure decider over realpaths
    already read: (True, admin_id) when it holds, (False, None) when it
    disagrees.

    - shared: another entry of the registry names the row's path too
      (shared_paths()), or another present row built with it has its
      realpath or its admin id (shared_identities(); lead ruling R-67 (c)):
      it disagrees, whatever else was read.
    - named: the realpath that `<path>/.git` names when it is a gitfile
      (_gitfile()), else None.
    - main: the main worktree has no admin directory; it holds when named,
      or else dotgit, the realpath of `<path>/.git`, is common_dir, with
      admin_id None.
    - Otherwise it holds when named's parent is worktrees, the realpath of
      `<common_dir>/worktrees`, back, the realpath that named's `gitdir`
      file names (None when that file is missing or empty), is dotgit, and
      commondir, the common directory that named's `commondir` file names
      (_admin_commondir(); named itself when there is none), is common_dir,
      since Git takes the worktree's common directory, and so the
      configuration row 4c reads, from that file (R-125); admin_id is
      named's last component.

    A value the verdict does not reach may be None: verify_registration()
    reads in this order and stops at the first value that decides."""
    if shared:
        return False, None
    if main:
        return (named if named is not None else dotgit) == common_dir, None
    if (named is None or os.path.dirname(named) != worktrees or back is None or back != dotgit
            or commondir != common_dir):
        return False, None
    return True, os.path.basename(named)


def verify_registration(path, common_dir, main, fs=_fs):
    """The two-way registration of a present worktree (D7, FR-055), between
    realpaths: (True, admin_id) when it holds, (False, None) when it
    disagrees; a failed read other than a missing file raises EvidenceError.
    A linked worktree: `<path>/.git` is a regular file whose gitdir line names
    `<common_dir>/worktrees/<admin_id>`, that directory's `gitdir` file
    names `<path>/.git`, and its `commondir` file names `<common_dir>`
    (lead ruling R-125), relative values resolved against the directory
    holding the file. The main worktree has no admin directory: its `.git` is
    the common directory itself, or a gitfile naming it; admin_id None. This
    check alone passes both of two registry entries naming one path, since
    the registry's porcelain output does not name an entry's admin
    directory, and both of two entries naming one worktree under two
    spellings, with one admin id, since both read one `.git` file;
    worktree_rows() fails both kinds closed (lead rulings R-57 L3 and R-67
    (c)). It reads what registration_verdict() needs, in its order, and
    decides there. fs makes each read: _fs(), each its own bounded call, or
    _direct() inside one fs_call() (_identity_now())."""
    dotgit = os.path.join(path, b".git")
    named = _gitfile(path, fs)
    if main:
        return registration_verdict(main, common_dir, named, dotgit=_realpath(dotgit, fs) if named is None else None)
    worktrees = back = real_dotgit = commondir = None
    if named is not None:
        worktrees = _realpath(os.path.join(common_dir, b"worktrees"), fs)
        if os.path.dirname(named) == worktrees:
            back = _admin_gitdir(named, fs)
            if back is not None:
                real_dotgit = _realpath(dotgit, fs)
                if back == real_dotgit:
                    commondir = _admin_commondir(named, fs)
    return registration_verdict(main, common_dir, named, worktrees, back, real_dotgit, commondir=commondir)


def status_warned(outcome):
    """Whether a status probe's standard error says the worktree's state was
    not established (lane 3's US2 M-1; lead ruling R-101 (e)), a pure
    function of the outcome: any byte past the 4 KiB head the runner keeps,
    or any line of that head other than Git's advice lines, `hint:` alone or
    `hint: TEXT`.

    The rule comes from Git's output (Git 2.43.0): on a clean run the probe
    prints nothing to standard error; for a directory it cannot open it
    prints `warning: could not open directory 'D/': Permission denied`, and
    for an unreadable `.gitignore` `warning: unable to access ...`, and
    exits 0 with what it could not read left out of its records. Git
    translates its `warning: ` and `error: ` prefixes under a localized
    message catalogue (`Warnung: ` in German), so the rule reads no prefix
    but the advice prefix; a translated advice line counts, which fails
    closed."""
    if outcome.stderr_bytes > len(outcome.stderr):
        return True
    return any(line and line != b"hint:" and not line.startswith(b"hint: ")
               for line in outcome.stderr.split(b"\n"))


def status_probe(path, run):
    """The combined status probe in the worktree at path (D6, D11; FR-056,
    FR-057): STATUS_PROBE with `-C path`, a `status` child (the two status
    pins and GIT_OPTIONAL_LOCKS=0), read by StatusParser. Returns (outcome,
    error): outcome.result is the parser's result for a complete outcome, one
    stopped at its bound included; error the row error of a failed one. A
    complete outcome whose standard error status_warned() names has not
    established the worktree's state either: its error is `probe-failed`,
    DETAIL `unparseable output`, so the row is inspection-error with `dirty`
    null (pcl:121-125), and revalidation reads it as state-changed."""
    outcome, error = _git(run, path, list(STATUS_PROBE), "status", StatusParser(), kind="status")
    if error is None and status_warned(outcome):
        error = unparseable_error("status")
    return outcome, error


# A linked worktree's effective-work-tree probe, after its `-C WORKTREE` (D7, LQ-11).
WORK_TREE_PROBE = ("rev-parse", "--path-format=absolute", "--show-toplevel")


def worktree_config(common_dir, directory, run):
    """Row 4c (design D6 and D7; Brett Heap's ruling LQ-11; R-102 (b); change
    1 as amended at addd346): the repository's `extensions.worktreeConfig`,
    read as Git's own format check reads it, from the common directory's own
    `config` file alone and without includes, by `git config --file
    <common_dir>/config --type=bool --get extensions.worktreeConfig` in
    directory. Only where it is true does Git apply a `core.worktree` or
    `core.bare` to a linked worktree. False when Git prints `false` or exits
    1, the key not being set; True when it prints `true`, and for any other
    outcome, a failure, a timeout or other output, which fails closed."""
    outcome, error = _git(run, directory, ["config", "--file", os.path.join(common_dir, b"config"), "--type=bool",
                                           "--get", "extensions.worktreeConfig"], "config")
    if error is None:
        return outcome.result.strip() != b"false"
    return outcome.status != 1


def effective_work_tree(raw, run, strict=False):
    """Whether the linked worktree at raw has raw as its effective work tree,
    the work tree a Git command run in it uses (design D7; LQ-11; change 1
    as amended at addd346): WORK_TREE_PROBE in raw, a `probe` child.
    Returns (holds, error): holds True when it prints exactly one line whose
    realpath is raw's realpath; False when it prints another, fails (Git
    exits 128 under `core.bare=true`, `fatal: this operation must be run in
    a work tree`) or prints other than one non-empty line; None with error,
    the row error, when the probe timed out or met the work deadline or a
    realpath read failed. strict, at revalidation, keeps False for the one
    decided value, another toplevel, and gives a probe that fails or prints
    other than one non-empty line None with its row error too, since it
    decided nothing (the lead's R-171; #19 at 4485678, D7). A pure reader:
    the caller decides."""
    outcome, error = _git(run, raw, list(WORK_TREE_PROBE), "rev-parse")
    if error is not None:
        return (False, None) if error["code"] == "probe-failed" and not strict else (None, error)
    lines = outcome.result.split(b"\n")
    if lines[-1] == b"":
        lines.pop()
    if len(lines) != 1 or not lines[0]:
        return (None, unparseable_error("rev-parse")) if strict else (False, None)
    try:
        return _realpath(lines[0]) == _realpath(raw), None
    except EvidenceError as exc:
        return None, exc.error


def inspect_repository(directory, run, refresh=False, *, repeat_identity_at_root=True):
    """The repository-wide evidence of the repository holding directory (D6,
    D8; FR-055, FR-056): rows 3, 4, 4b, 5, 4c, 6 and 7 through run_bounded() and
    their parsers, memoized on run, the Invocation (`common_dirs`), by the
    device and inode of the common directory (lead ruling R-54 X-1), so that
    another directory of one repository runs only row 3. refresh reads afresh
    and replaces the memo; the retired cleanup_report() always did (lead ruling
    R-51 (d)), and so does require_unchanged_cleanup_state() after confirmation
    (T076). repeat_identity_at_root, on by default, runs row 5, row 3 again at
    the main worktree where row 3 ran in another worktree, and names no root
    when that common directory differs; off, row 5 is not run, and the memo
    keeps such a result apart from the default's (R-54 X-1). Never refuses;
    Interrupted passes. Returns a dict:

    - `identity`: {root, common_dir, dev, ino}, the realpaths of the main
      worktree and the common directory and the common directory's device and
      inode, by lstat; root None where main_worktree() names none, with its
      cause in `main_cause`, or where row 5 did not confirm it; None itself
      when row 3 failed;
    - `main_path`, main_worktree()'s path as named before row 5 runs, kept
      where row 5 then fails, so that the resolution still names the main
      worktree as the command directory (plan review F2); None where
      main_worktree() names none or row 4 failed;
    - `directory`, where row 3 and row 4 ran; `toplevel` and `superproject`,
      what row 3 printed (toplevel as a realpath);
    - `probe_dir`, where rows 6 and 7 ran: root, or, where root is null, the
      common directory for a bare repository and otherwise where row 3 ran
      (FR-055; lead ruling R-42);
    - `records`, row 4's entries, and `first_is_common_dir`;
    - `worktree_config`, row 4c (worktree_config(), run in probe_dir before
      row 6; Brett Heap's ruling LQ-11): True or False, None where an
      earlier probe failed and it was not read, which worktree_rows() reads
      as True, failing closed;
    - `refs`, row 6's records; `merge_target`, resolve_merge_target()'s
      result, or None with the refusal in `merge_target_refusal`; `merged`,
      row 7's refnames;
    - `errors`, the row errors of the repository-wide probes that failed;
      what needs a failed probe's answer is not run."""
    directory = os.fsencode(directory)
    repo = {"identity": None, "directory": directory, "toplevel": None, "superproject": None,
            "main_cause": None, "main_path": None, "probe_dir": directory, "records": None,
            "first_is_common_dir": False, "worktree_config": None, "refs": None, "merge_target": None,
            "merge_target_refusal": None, "merged": None, "errors": []}
    values, error = identity_probe(directory, run)
    if error is not None:
        repo["errors"].append(error)
        return repo
    toplevel, common, superproject = values
    try:
        common_dir = _realpath(common)
        found = _fs("lstat", os.lstat, common_dir)
        toplevel = _realpath(toplevel)
    except EvidenceError as exc:
        repo["errors"].append(exc.error)
        return repo
    key = (found.st_dev, found.st_ino) if repeat_identity_at_root else (found.st_dev, found.st_ino, "no row 5")
    if not refresh and key in run.common_dirs:
        return run.common_dirs[key]
    run.common_dirs[key] = repo
    identity = {"root": None, "common_dir": common_dir, "dev": found.st_dev, "ino": found.st_ino}
    repo.update(identity=identity, toplevel=toplevel, superproject=superproject)
    outcome, error = _git(run, directory, ["worktree", "list", "--porcelain", "-z"], "worktree list",
                          WorktreeListParser())
    if error is not None:
        repo["errors"].append(error)
        return repo
    records = repo["records"] = outcome.result
    root, repo["main_cause"] = main_worktree(
        {"common_dir": common_dir, "toplevel": toplevel, "directory": directory}, records, run)
    repo["main_path"] = root  # kept where row 5 then fails (plan review F2)
    try:
        if records and not records[0]["bare"]:
            repo["first_is_common_dir"] = _realpath(records[0]["path"]) == common_dir
        if repeat_identity_at_root and root is not None and root != toplevel:  # row 5: row 3 ran elsewhere
            values, error = identity_probe(root, run)
            if error is not None:
                repo["errors"].append(error)
                return repo
            if _realpath(values[1]) != common_dir:
                root, repo["main_cause"] = None, "unnamed"
    except EvidenceError as exc:
        repo["errors"].append(exc.error)
        return repo
    identity["root"] = root
    if root is not None:
        repo["probe_dir"] = root
    elif records and records[0]["bare"]:
        repo["probe_dir"] = common_dir
    probe_dir = repo["probe_dir"]
    repo["worktree_config"] = worktree_config(common_dir, probe_dir, run)  # row 4c (LQ-11)
    outcome, error = _git(run, probe_dir, ["for-each-ref", "--format=" + REF_FORMAT, "refs/heads", "refs/remotes"],
                          "for-each-ref", RefParser())
    if error is not None:
        repo["errors"].append(error)
        return repo
    refs = repo["refs"] = outcome.result
    try:
        declared = None if root is None else declared_tracking_branch(root)
        repo["declared"] = declared  # the manifest's raw tracking_branch, None for none: revalidated as written (R-77)
        target = repo["merge_target"] = resolve_merge_target(refs, declared)
    except Refused as exc:
        repo["merge_target_refusal"] = exc
        return repo
    outcome, error = _git(run, probe_dir, ["for-each-ref", "--merged=" + target["sha"], "--format=%(refname)",
                                           "refs/heads"], "for-each-ref", MergedSetParser())
    if error is not None:
        repo["errors"].append(error)
        return repo
    repo["merged"] = outcome.result
    return repo


def shared_paths(registry):
    """The registry paths that more than one entry of registry names, as the
    raw bytes listed (lead rulings R-57 L3 and R-59 D5): a pure function of
    row 4's records."""
    seen, shared = set(), set()
    for record in registry:
        (shared if record["path"] in seen else seen).add(record["path"])
    return frozenset(shared)


def shared_identities(reads):
    """The positions in reads, the reads of the rows that one worktree_rows()
    call builds (_read_row()), of the present rows whose realpath, or whose
    admin id, another present row among them has too (lead ruling R-67
    (c)): each is registration-mismatch, as a shared registry path is. Two
    spellings of one worktree both pass the two-way check, with one admin id,
    since both read one `.git` file. A pure function of the values read: a
    row not present, or whose realpath was not read, is compared by neither
    (lead ruling R-57 L2), and only a registration that held has an admin
    id, the main worktree's being None and never compared."""
    groups = {}
    for at, read in enumerate(reads):
        if read["present"] is not True or read["tree"] is None:
            continue
        groups.setdefault(("realpath", read["tree"]), []).append(at)
        if read["registered"] and read["admin_id"] is not None:
            groups.setdefault(("admin_id", read["admin_id"]), []).append(at)
    return frozenset(at for group in groups.values() if len(group) > 1 for at in group)


def _registry_entries(registry, records):
    """(index, record) for each registry entry worktree_rows() builds a row
    for: every entry of registry, in its order, when records is None; else
    each of records, in the order given, with its index in registry, found by
    identity or, for a copy, by value. A record that is no entry of registry
    raises ValueError."""
    if records is None:
        return list(enumerate(registry))
    at = {id(entry): index for index, entry in enumerate(registry)}
    return [(at[id(record)] if id(record) in at else registry.index(record), record) for record in records]


def row_evidence(record, raw, main, read, refs, merged, target):
    """One worktree row assembled from evidence already read (D6, D7;
    FR-006, FR-042, FR-055 to FR-057; lead ruling R-54 X-1): a pure function
    returning the WorktreeRow, its document fields in WORKTREE_ROW_KEYS's
    order with `prunable` only on a stale row whose record says so (M11),
    then classify()'s class and partial_removal_note()'s notes. classify()'s
    recommendation stands but in two cases (lane 3's W52 F-6 and F-10): the
    main worktree's row, where the ladder says merged-removable or
    merged-current, takes TEXT's `recommendation_main_worktree`, since no
    removal of it can succeed, and a locked stale row takes
    `recommendation_stale_locked`, since `git worktree prune` keeps a locked
    entry. The class is unchanged in both. record is
    the row's registry record; raw the row's path bytes; main whether it is
    the main worktree; refs row 6's records by refname; merged row 7's set,
    or None where row 7 did not run; target the merge target's name, or None.

    read holds the row's own reads, None where a value was not read: the
    `present` of presence_from_lstat(), with `dev` and `ino` from the lstat of
    a present row; `active` and `tree`, the realpaths of the working directory
    and of the row, `current` being null unless both were read (the working
    directory inside the row, as the baseline reads it); `registered` and
    `admin_id`, registration_verdict()'s answer; `status`, the combined
    probe's result; and `errors`, the row errors of the reads that failed, in
    the order read, which the row copies.

    Branch evidence comes from refs for a present row only: a deleted
    upstream keeps its short name with `ahead` and `behind` null, and a
    branch named HEAD (HEAD_BRANCH_REF) takes none, its `upstream`,
    `remote_present`, `ahead` and `behind` staying null while its row gains
    a `probe-failed` error for `git for-each-ref`, so it is inspection-error
    (lead ruling R-61 (b)); `merged_into_target` is membership of merged."""
    row = WorktreeRow()
    row.raw_path, row.main = raw, main
    row.dev, row.ino = read["dev"], read["ino"]
    row.registered, row.admin_id = read["registered"], read["admin_id"]
    status = row.status = read["status"]
    present = read["present"]
    errors = list(read["errors"])
    active, tree = read["active"], read["tree"]
    current = None if active is None or tree is None else (
        active == tree or tree == b"/" or active.startswith(tree + b"/"))
    branch_ref = record["branch"]
    branch = "detached" if branch_ref is None else _evidence_text(branch_ref.removeprefix(b"refs/heads/"))
    upstream = remote_present = ahead = behind = merged_into_target = None
    ref = refs.get(branch_ref) if present and branch_ref is not None else None
    if ref is not None:
        if branch_ref == HEAD_BRANCH_REF:
            errors.append(unparseable_error("for-each-ref"))
        elif ref["upstream_short"] is not None:
            upstream = _evidence_text(ref["upstream_short"])
            remote_present, ahead, behind = ref["remote_present"], ref["ahead"], ref["behind"]
            tracked = refs.get(ref["upstream"])
            row.upstream_oid = tracked["objectname"] if remote_present and tracked else None
        if merged is not None:
            merged_into_target = branch_ref in merged
    text, valid = json_path(raw)
    values = {
        "path": text, "present": present, "branch": branch, "head": record["head"],
        "upstream": upstream, "remote_present": remote_present, "ahead": ahead, "behind": behind,
        "dirty": None if status is None else status["dirty"],
        "ignored_files": None if status is None else status["ignored_files"],
        "current": current, "merged_into_target": merged_into_target, "locked": record["locked"],
        "ignored_files_truncated": None if status is None else status["ignored_files_truncated"],
        "ignored_samples": None if status is None else [
            dict(zip(("path", "path_valid_utf8"), json_path(sample))) for sample in status["ignored_samples"]],
        "path_valid_utf8": valid, "errors": errors,
    }
    values["classification"], values["recommendation"] = classify(values, target)
    if main and values["classification"] in ("merged-removable", "merged-current"):
        values["recommendation"] = TEXT["recommendation_main_worktree"]  # W52 F-6: never removed
    elif values["classification"] == "stale-worktree" and values["locked"]:
        values["recommendation"] = TEXT["recommendation_stale_locked"]  # W52 F-10: prune keeps a locked entry
    values["notes"] = partial_removal_note(values, status, main)
    if present is False and record["prunable"]:
        values["prunable"] = True
    row.update((key, values[key]) for key in WORKTREE_ROW_KEYS if key in values)
    return row


def _read_row(raw, main, common_dir, active, active_error, shared):
    """The reads of one worktree row for row_evidence() before its status
    probe, in D6's order: the lstat; for a present row, its realpath, the
    working directory's failure (active_error) if it failed, and the
    registration, a shared path's verdict taken with nothing read (lead
    rulings R-57 L2 and L3). A failed read becomes an entry of `errors`, and
    what follows it in the same step is not read. _read_status() runs the
    probe once worktree_rows() has compared the rows (shared_identities())
    and read the row's identity again (_identity_unchanged())."""
    read = {"present": None, "dev": None, "ino": None, "active": active, "tree": None,
            "registered": None, "admin_id": None, "status": None, "errors": []}
    errors = read["errors"]
    found = _lstat(raw)
    read["present"], error = presence_from_lstat(found)
    if error is not None:
        errors.append(error)
    if not read["present"]:
        return read
    read["dev"], read["ino"] = found.st_dev, found.st_ino
    try:
        read["tree"] = _realpath(raw)
        if active_error is not None:
            errors.append(active_error)
        if shared:
            read["registered"], read["admin_id"] = registration_verdict(main, common_dir, None, shared=True)
        else:
            read["registered"], read["admin_id"] = verify_registration(raw, common_dir, main)
    except EvidenceError as exc:
        errors.append(exc.error)
    return read


def _identity_now(raw, main, common_dir):
    """A row's identity read now, every read at once with _direct(), for one
    fs_call(): (dev, ino, realpath, (registered, admin_id)), the reads of
    _read_row() in its order; an OSError raises EvidenceError."""
    found = _direct("lstat", os.lstat, raw)
    return (found.st_dev, found.st_ino, _realpath(raw, _direct),
            verify_registration(raw, common_dir, main, fs=_direct))


def _identity_unchanged(read, raw, main, common_dir):
    """The second verification of a row's identity, made immediately before
    its status probe (the project-command delta, pc:124-126: a worktree probe
    runs "only after that worktree's identity has been verified immediately
    before"; lane 3's env H-1, lead ruling R-101 (e) and (j)). It makes the
    reads of _read_row() again, the lstat, the realpath and the two-way
    registration (verify_registration()), together in one bounded
    fs_call() (_identity_now()), and compares them with read, the row's
    first reads: True when the device, inode, realpath and admin id are the
    same and the registration still holds. Otherwise False, and the row gets
    no probe: a read that fails, or the call cut at its budget, appends its
    row error (OPERATION lstat for a cut call), a registration that now
    disagrees sets `registered` false (registration-mismatch), and any other
    change leaves the row present with no status, which classify() makes
    inspection-error."""
    budget, _ = current_invocation().child_budget("probe")
    try:
        value = fs_call(_identity_now, raw, main, common_dir)
    except EvidenceError as exc:
        read["errors"].append(exc.error)
        return False
    if isinstance(value, DriverOutcome):
        read["errors"].append(probe_error(value, "lstat", budget))
        return False
    dev, ino, tree, (registered, admin_id) = value
    if (dev, ino) != (read["dev"], read["ino"]) or tree != read["tree"]:
        return False
    if not registered:
        read["registered"], read["admin_id"] = False, None
        return False
    return admin_id == read["admin_id"]


def _work_tree_holds(read, raw, run):
    """Whether the linked row at raw, its identity verified, has raw as its
    effective work tree (effective_work_tree(); LQ-11), read after its
    identity and before its status probe in a repository whose row 4c read
    true. Otherwise False, and the row gets no probe: another work tree, a
    failed probe or other output sets `registered` false
    (registration-mismatch), and a probe that timed out or met the work
    deadline, or a failed realpath read, appends its row error."""
    holds, error = effective_work_tree(raw, run)
    if error is not None:
        read["errors"].append(error)
    elif not holds:
        read["registered"], read["admin_id"] = False, None
    return bool(holds)


def _read_status(read, raw, run):
    """The combined status probe of the row at raw whose reads are done
    (_read_row()), only when its registration holds and nothing failed: its
    result in read's `status`, or its row error appended to `errors`.
    worktree_rows() calls it only after _identity_unchanged()."""
    if read["registered"] and not read["errors"]:
        outcome, error = status_probe(raw, run)
        if error is not None:
            read["errors"].append(error)
        else:
            read["status"] = outcome.result
    return read


def worktree_rows(repo, run, records=None):
    """One WorktreeRow per registry entry of repo (inspect_repository()), in
    the registry's order; or, when records is given, one per entry of records,
    which are entries of repo's registry (`repo["records"]`), in the order
    given (lead ruling R-53 (d)). The bare entry, and a first entry that is the
    common directory when the main worktree cannot be named, are no rows (D8),
    and where it can, that row's path is the main worktree's realpath; the
    registry's first entry is the main worktree in any order given.

    Per row (D6, D7; FR-006, FR-055 to FR-057): presence by lstat, false on
    ENOENT or ENOTDIR and null with an `os-error` on any other failure (lead
    ruling R-36); for a present row, `current` (the working directory is
    inside it, as the baseline reads it), the two-way registration and, only
    when it holds, the combined status probe in that worktree. A row whose
    registry path another entry of the whole registry names too is
    registration-mismatch (`registered` false) with no registration read,
    since the two-way check cannot tell such entries apart; a row not
    present gets no registration or duplicate check (lead rulings R-57 L2
    and L3, R-59 D5). Among the present rows one call builds, rows with one
    realpath, or one admin id, are registration-mismatch too, two spellings
    of one worktree passing the two-way check with one admin id
    (shared_identities(); lead ruling R-67 (c)). They are compared once every
    row of the call is read and before any status probe, so that none of
    them gets one; an entry the call does not build is never read for it,
    so a row past the cap stays uninspected, while match_target() builds P's
    realpath twins among P's rows. Every other row's identity is verified
    again immediately before its own probe (_identity_unchanged(); pc:124-126,
    lead ruling R-101 (e) and (j)), since the probes of the rows before it
    may take their whole budgets: a row whose lstat, realpath or registration
    changed since its first read gets no probe and is inspection-error, in
    the same row order with the same budgets. Then, in a repository whose
    row 4c read true (or was not read), each linked row's effective work
    tree (_work_tree_holds(); Brett Heap's ruling LQ-11, change 1 as amended
    at addd346): another work tree, a failed probe or other output is
    registration-mismatch, unprobed. Once the work deadline has passed no
    probe starts, and such a row keeps its probe's own deadline-exceeded,
    unread again. Then the branch evidence from row 6; where
    row 6 gave no listing, because it or a probe before it failed, each
    present row on a branch carries that probe's row errors and is
    inspection-error, its upstream fields null as not established (plan
    review F3), while a detached row needs no ref. Otherwise a
    deleted upstream keeping its short name with `ahead` and `behind` null, and a
    branch named HEAD (HEAD_BRANCH_REF) taking none: its `upstream`,
    `remote_present`, `ahead` and `behind` stay null and its row carries a
    `probe-failed` error for `git for-each-ref`, so it is inspection-error
    (lead ruling R-61 (b)); `merged_into_target` from row 7; then classify()
    and partial_removal_note(). Each failed outcome or call becomes an entry
    of the row's `errors`. A value not established is null, and a stale or
    unreadable row carries no branch evidence, as the baseline gave none.

    The reader of row_evidence(): the working directory's realpath once;
    per row _read_row(); shared_identities() over those reads; then per row,
    in the same order, _identity_unchanged(), _read_status() and the assembly
    (lead ruling R-54 X-1)."""
    identity = repo["identity"]
    registry = repo["records"]
    if identity is None or not registry:
        return []
    common_dir = identity["common_dir"]
    target = repo["merge_target"]["name"] if repo["merge_target"] else None
    refs = {ref["refname"]: ref for ref in repo["refs"] or ()}
    # No ref listing (row 6 failed, or a probe before it did): no branch's
    # evidence is established, so each present row on a branch carries the
    # failed probe's error and is inspection-error (plan review F3).
    unlisted = [] if repo["refs"] is not None else (list(repo["errors"]) or [unparseable_error("for-each-ref")])
    redirectable = repo.get("worktree_config") is not False  # row 4c true, or not read (LQ-11)
    shared = shared_paths(registry)
    entries = _registry_entries(registry, records)
    try:
        active, active_error = _realpath(b"."), None
    except EvidenceError as exc:
        active, active_error = None, exc.error
    built = []
    for index, record in entries:
        raw = record["path"]
        if index == 0 and record["bare"]:
            continue
        if index == 0 and repo["first_is_common_dir"]:
            if identity["root"] is None:
                continue
            raw = identity["root"]
        built.append((index, record, raw,
                      _read_row(raw, index == 0, common_dir, active, active_error, record["path"] in shared)))
    twins = shared_identities([read for _, _, _, read in built])
    rows = []
    for at, (index, record, raw, read) in enumerate(built):
        if at in twins:  # registration-mismatch, as a shared path is (R-67 (c))
            read["registered"], read["admin_id"] = registration_verdict(
                index == 0, common_dir, None, shared=True)
        elif read["registered"] and not read["errors"] and (
                run.child_budget("status")[0] <= 0
                or (_identity_unchanged(read, raw, index == 0, common_dir)
                    and (index == 0 or not redirectable or _work_tree_holds(read, raw, run)))):
            # Verified again immediately before its probe (pc:124-126; R-101 (e)), and a
            # linked row's effective work tree read where row 4c read true (LQ-11).
            # With no work time left no probe starts, and the row keeps that probe's
            # own deadline-exceeded, as the work deadline's rows always have (T099).
            _read_status(read, raw, run)
        if unlisted and read["present"] is True and record["branch"] is not None:
            read["errors"].extend(dict(error) for error in unlisted)
        rows.append(row_evidence(record, raw, index == 0, read, refs, repo["merged"], target))
    return rows
