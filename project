def known_obstacles(name, parent):
    """The known Triad obstacles as D13 sentences, in the order name, openRepoShape, parent: three
    local facts, with no network and no subprocess (design D3). The parent fact is parent.is_dir()
    and, only when that is false, parent.exists() on the same path, which chooses the parent
    sentence: D13's for a parent that does not exist, or the second parent sentence, for a parent
    that exists but is not a directory (fix-parent-obstacle-wording design D1, D2)."""
    obstacles = []
    if not ASSEMBLY_NAME.fullmatch(name):
        obstacles.append(f"{name} cannot be a Triad name; a Triad name is a letter first, then letters and digits"
                         " only, such as MyApp.")
    if shutil.which("openRepoShape") is None:
        obstacles.append("openRepoShape is not on PATH. Install openRepoShape through workBenches first.")
    if not parent.is_dir():
        if parent.exists():
            obstacles.append(f"The parent {parent} exists but is not a directory; choose a parent that is a"
                             " directory.")
        else:
            obstacles.append(f"The parent directory {parent} does not exist; a Triad is created inside an existing"
                             " directory.")
    return obstacles


def print_creation_question(name, obstacles):
    """The creation question's lines on stdout, one line per known obstacle sentence (design D4, D13)."""
    print(f"How should {name} be created? Nothing is created until you confirm.")
    print("  1. Triad (default): an assembly root with a spec leg and a code leg, made by openRepoShape."
          " It is preferred, not required: it stays elective and confers nothing.")
    for sentence in obstacles:
        print(f"     Not possible here: {sentence}")
    print("  2. Single repository: fully supported, and no reason is asked."
          " single-repository.yaml is the ratified way to record staying single.")


def ask_twice(prompt, accept, retry, missed, ended):
    """Ask through ask(); accept returns the value of a recognised answer, else None. The first
    unrecognised answer prints retry and asks once more; a second refuses with missed, and end
    of input refuses with ended. An interrupt is left to main() (design D4)."""
    for attempt in range(2):
        try:
            answer = ask(prompt)
        except EOFError:
            raise Refused(ended) from None
        value = accept(answer)
        if value is not None:
            return value
        if not attempt:
            print(retry)
    raise Refused(missed)


def write_creation_advisory(name):
    """The two creation advisory lines on stderr only, through a guarded write that can neither
    reach stdout nor change the exit status (design D7, D13)."""
    if sys.stdout is not None:
        try:
            sys.stdout.flush()
        except (OSError, ValueError, AttributeError):
            pass
    stream = sys.stderr
    if stream is None:
        return
    text = (f"warning: {name} was created as a single repository. The Triad (an assembly root with a spec leg"
            " and a code leg) is preferred, not required: it stays elective and confers nothing.\n"
            "warning: openRepoShape's adopt-project.py converts a repository in place when a person deciding"
            " for this project runs it, and a project that stays single can say so in single-repository.yaml."
            " Nothing here changes.\n")
    try:
        try:
            descriptor = stream.fileno()
        except (OSError, ValueError, AttributeError):
            # No descriptor (an in-process StringIO): write the text to the stream itself.
            stream.write(text)
            return
        # A direct descriptor write leaves nothing buffered for the interpreter's final flush.
        data = text.encode("ascii", errors="replace")
        while data:
            data = data[os.write(descriptor, data):]
    except (OSError, ValueError, AttributeError):
        pass


def new(args):
    name = args.name or ask("Project name:")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", name):
        raise Refused("Project name must start with a letter or digit and contain letters, digits, _ or -.")
    if args.parent and args.into:
        raise Refused("Use either positional parent or --into.")
    if not (args.into or args.parent or projects_dirs()):  # no default parent under such a HOME (R-202)
        raise Refused(config_path_message(["HOME"]))
    parent = Path(args.into or args.parent or projects_dirs()[0]).expanduser().resolve()
    if args.family and not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", args.family):
        raise Refused("Family must be a single folder name.")
    destination = parent / name
    if args.shape and args.family:
        destination = (parent if parent.name == args.family else parent / args.family) / name
    if destination.exists() or destination.is_symlink():
        raise Refused(f"Destination already exists: {destination}")
    # One decision, computed once; the hoisted check, the question and the advisory read offer, and nothing re-derives terminal state (design D1, D2).
    workspace = bool(WORKSPACE_NAME.fullmatch(name))
    chosen = bool(args.shape or args.yes) or any(value is not None for value in (
        args.org, args.visibility, args.family, args.elected_by, args.bench, args.type, args.description))
    offer = not workspace and not chosen and person_at_terminal()
    # Hoisted for an asked invocation only; the later check keeps every other invocation's order (design D2, D8).
    if offer and args.workflow and shutil.which("setup-openspeckit") is None:
        raise Refused("--workflow requires setup-openspeckit on PATH.")
    if offer:
        obstacles = known_obstacles(name, parent)
        print_creation_question(name, obstacles)
        triad = ask_twice("Create it as a Triad? [Y/n or 1/2]:", lambda answer: TRIAD_ANSWERS.get(answer.lower()),
                          "Answer y or 1 for the Triad, n or 2 for a single repository; Enter takes the Triad.",
                          "No recognised answer to the Triad question; nothing was created.",
                          "No answer to the Triad question (end of input); nothing was created.") == "triad"
        if triad and obstacles:
            raise Refused("A Triad cannot be created here. " + " ".join(obstacles) + " Nothing was created.")
        if triad:
            # The answers set exactly the fields the flags would; the shape branch below re-checks them (design D2, D5).
            args.org = ask_twice("GitHub organization for the Triad:",
                                 lambda answer: answer if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*", answer) else None,
                                 "An organization name starts with a letter or digit and has only letters, digits and hyphens.",
                                 "Invalid GitHub organization name. Nothing was created.",
                                 "No GitHub organization was given (end of input); nothing was created.")
            args.visibility = ask_twice("Visibility (private, public or internal):",
                                        lambda answer: answer.lower() if answer.lower() in VISIBILITIES else None,
                                        "Type the visibility in full: private, public or internal.",
                                        "Visibility must be private, public or internal. Nothing was created.",
                                        "No visibility was given (end of input); nothing was created.")
            args.shape = True
            if args.visibility == "public":
                print(f"Triad {name} in organization {args.org}, visibility public: anyone can read the repositories.")
            else:
                print(f"Triad {name} in organization {args.org}, visibility {args.visibility}.")
    if args.shape:
        if args.bench or args.type or args.description:
            raise Refused("Shape creation has no bench generator adapter yet; omit --bench/--type/--description.")
        if not args.org or not args.visibility:
            raise Refused("Shape creation requires --org and --visibility.")
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]*", args.org):
            raise Refused("Invalid GitHub organization name.")
        if not parent.is_dir():
            raise Refused("Shape creation requires an existing --into parent directory.")
        if not shutil.which("openRepoShape"):
            raise Refused("Install openRepoShape through workBenches first.")
        command = ["openRepoShape", name, "--org", args.org, "--visibility", args.visibility,
                   "--into", str(parent)]
        if args.family:
            command += ["--family", args.family]
        if args.elected_by:
            command += ["--elected-by", args.elected_by]
        row = None
    else:
        if args.org or args.visibility or args.family or args.elected_by:
            raise Refused("--org, --visibility, --family and --elected-by require --shape.")
        row = choose(registry(workbenches(args.workbenches)), args)
        command = ["bash", row["script"], name, str(parent)]
    commands = [command]
    if args.workflow:
        if not shutil.which("setup-openspeckit"):
            raise Refused("--workflow requires setup-openspeckit on PATH.")
        commands.append(["setup-openspeckit", "--repo", str(destination)])
    print(f"Create: {destination}")
    show_plan(commands)
    if args.dry_run:
        return 0
    if not args.shape:
        confirm(args.yes)
        parent.mkdir(parents=True, exist_ok=True)
    # Shape's own confirmation is always retained, including with --yes here.
    code = execute(command, cwd=parent if args.shape else None)
    if code:
        return code
    if not destination.is_dir():
        raise Refused(f"Generator returned success but did not create {destination}")
    if row:
        profile = destination / ".project.json"
        if not profile.exists():
            with profile.open("x") as stream:
                json.dump({"schema_version": 1, "bench": row["bench"], "type": row["type"]}, stream, indent=2)
                stream.write("\n")
    if row and not offer and not workspace:
        write_creation_advisory(name)
    for followup in commands[1:]:
        code = execute(followup)
        if code:
            print(f"Project created at {destination}; workflow setup failed.", file=sys.stderr)
            return code
    print(f"Created: {destination}\nNext: project doctor {shlex.quote(str(destination))}")
    return 0


def manifest(root):
    for filename, kind in (("project.yaml", "project-manifest"), ("family.yaml", "family-manifest")):
        path = root / filename
        if path.is_file():
            data = read_yaml(path)
            if data.get("kind") != kind:
                raise Refused(f"Unexpected kind in {path}; expected {kind}")
            return kind, data
    return "single", {}


def discover(target=None):
    """The project directory of target, a path or a bare name, or of the
    working directory: a family holder, then the nearest manifest, then the
    repository's toplevel, then a `.project.json` or `.devcontainer` there.

    Before its Git step it runs the version check, memoized on the invocation
    (T118; research.md R2, FR-053, plan review M10): with Git 2.36 or later,
    `rev-parse --show-toplevel` runs through the driver; otherwise no Git child
    runs, and the nearest of the path and its ancestors holding a `.git` entry,
    by lstat, names the toplevel. A bare name's refusals carry their codes,
    `ambiguous-name` and `repository-not-found` (lead ruling R-53, P-10); the
    messages are the baseline's."""
    bare = False
    if target:
        path = expand_user(target)
        if path is None:  # `~` under a HOME that fails D11's test (lead ruling R-202)
            raise Refused(config_path_message(["HOME"]), code="relative-config-path")
        # Named estates prefer family holders over similarly named roots.
        if not path.is_absolute() and len(path.parts) == 1:
            bare = path.name not in (".", "..")
            families = [base / target / target for base in projects_dirs()
                        if (base / target / target / "family.yaml").is_file()]
            if len(families) > 1:
                raise Refused("Ambiguous project name; supply a path.", code="ambiguous-name")
            if families:
                return families[0].resolve()
            if not path.exists():
                matches = [p / target for p in projects_dirs() if (p / target).is_dir()]
                if len(matches) > 1:
                    raise Refused("Ambiguous project name; supply a path.", code="ambiguous-name")
                if matches:
                    path = matches[0]
        path = path.resolve()
    else:
        path = Path.cwd().resolve()
    not_found = "repository-not-found" if bare else None
    if not path.is_dir():
        raise Refused(f"Directory does not exist: {path}", code=not_found)
    holder = path / path.name
    if (holder / "family.yaml").is_file():
        return holder
    ancestors = [path, *path.parents]
    for candidate in ancestors:
        if (candidate / "project.yaml").is_file() or (candidate / "family.yaml").is_file():
            return candidate
    if git_version(current_invocation()).code is None:
        root = git_text(path, "rev-parse", "--show-toplevel")
        if root:
            return Path(root)
    else:
        for candidate in ancestors:
            try:
                found = fs_call(os.lstat, candidate / ".git")
            except OSError:
                continue  # no `.git` entry here
            if isinstance(found, DriverOutcome):
                break  # the lstat did not answer within its budget: name no toplevel
            return candidate
    if (path / ".project.json").is_file() or (path / ".devcontainer").is_dir():
        return path
    raise Refused(f"No project found at {path}; supply a path or name.", code=not_found)


