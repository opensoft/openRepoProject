# region guard
# The `internal-error` guard of `project clean` and the one writer of its JSON
# documents (research.md R6; contracts/project-clean.md, "Streams" and
# "Extended error object"; plan review M2, M6 and m12; lead rulings R-38, R-44
# and R-45). main() routes `clean` through run_clean() and prints a refusal of
# `clean --json` as error_document().


def clean_mode(args):
    """The plan mode of a `clean` invocation (data-model.md, "Plan"):
    `all-safe` for --all-safe, preview or apply; `single` for --apply with
    --action, since push and delete-branch take single mode's row cap and
    bounds; `report` otherwise. Arguments are read with getattr, so this holds
    before and after T047 adds --all-safe to parser()."""
    if getattr(args, "all_safe", False):
        return "all-safe"
    if getattr(args, "apply", False) and getattr(args, "action", None):
        return "single"
    return "report"


def observed_at():
    """Now, as RFC 3339 UTC to the second with `Z`, from time.gmtime()."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def internal_error(exc):
    """The refusal `internal-error` for an unexpected exception: its class
    name and its text, `TYPE: TEXT` (contracts/project-clean.md)."""
    return Refused(TEXT["internal_error"].format(TYPE=type(exc).__name__, TEXT=exc), code="internal-error")


def run_clean(args):
    """Run `clean` inside its guard (research.md R6; plan review M2, m12).
    Before the apply phase, any Exception but Refused becomes the refusal
    `internal-error`, which main() prints and ends with exit status 2.
    Refused, Interrupted, Terminated, KeyboardInterrupt and EOFError pass
    through unchanged, the same object, to keep their 2, 130, 143 and 129
    paths. Once the invocation main() entered is out of phase `planning`, the
    apply phase decides a failing target itself (T093) and the guard converts
    nothing, so the phase is read on that invocation (lead ruling R-44)."""
    invocation = current_invocation()
    try:
        return clean(args)
    except (Refused, EOFError):
        raise
    except Exception as exc:
        if invocation.phase != "planning":
            raise
        raise internal_error(exc) from exc


def _contract_object(value, keys):
    """value, an object of the contract, in the order of its key tuple; None
    while it is not established."""
    return None if value is None else {key: value[key] for key in keys}


def error_document(exc, args):
    """The extended error object of a refusal under `clean --json`
    (contracts/project-clean.md, "Extended error object"; plan review M6): the
    baseline {"error": MESSAGE} extended with `code`, `schema_version`,
    `observed_at`, `mode`, `repository` and `merge_target` (null unless the
    refusal's context establishes them), `completeness: "incomplete"`,
    `apply_allowed: false` and `refusals`, in EXTENDED_ERROR_KEYS's order. It
    is the document of `invalid-arguments`, `internal-error` and every resolve
    refusal; a plan, select or confirm refusal prints the plan envelope
    instead (T051, T053). An exception that is not a Refused is written as
    `internal-error`."""
    refusal = exc if isinstance(exc, Refused) else internal_error(exc)
    context = refusal.context or {}
    values = {
        "error": str(refusal),
        "code": refusal.code,
        "schema_version": 1,
        "observed_at": observed_at(),
        "mode": clean_mode(args),
        "repository": _contract_object(context.get("repository"), REPOSITORY_KEYS),
        "merge_target": _contract_object(context.get("merge_target"), MERGE_TARGET_KEYS),
        "completeness": "incomplete",
        "apply_allowed": False,
        "refusals": [refusal.as_object()],
    }
    return {key: values[key] for key in EXTENDED_ERROR_KEYS}


def write_document(doc):
    """Write doc to standard output as the one JSON document of a `clean
    --json` run: json.dumps(doc, indent=2, ensure_ascii=True) and one newline
    (plan review M6). ensure_ascii stays True, so every code point outside
    ASCII is written as an escape; research.md R12 keeps ensure_ascii=False for
    the digest's input alone (lead ruling R-38). A failed write, such as EPIPE
    from a reader that closed the pipe, never raises: it diverts standard
    output to /dev/null and is recorded on the invocation in force
    (write_failed(), region dispatcher; lead ruling R-55, T047), so there is
    no second traceback and no exit 120. Before the apply phase the
    pipeline's check after printing makes it `internal-error`; main() writing
    an error document keeps its own status. Standard output closed when
    project started (sys.stdout None, the stream say() skips) is such a
    failed write, EBADF, so that `clean --json` refuses with `internal-error`
    and exit 2 instead of a traceback (lead ruling R-101 (b), F3)."""
    if sys.stdout is None:
        write_failed(current_invocation(), None, OSError(errno.EBADF, os.strerror(errno.EBADF)))
        return
    try:
        sys.stdout.write(json.dumps(doc, indent=2, ensure_ascii=True) + "\n")
        sys.stdout.flush()
    except OSError as exc:
        write_failed(current_invocation(), sys.stdout, exc)
# endregion guard

# region dispatcher
# The frozen pipeline's own parts (T047; contracts/project-clean.md, "Order of
# a run"; research.md R4 and R6; lead rulings R-55 and R-56). clean() runs the
# stages in a fixed order, and later tasks fill the stages, never reorder them.
# Its CleanRun is the Invocation in force (R-56 Q-1 and Q-2: no subclass and no
# nested Invocation), which clean() gives these attributes: `args`, the parsed
# arguments, each read with getattr; `mode` (clean_mode()); `action`
# (clean_action()); `human`, the stream of human lines, standard error under
# --apply --json and standard output otherwise; `plan`, the Plan build_plan()
# returned; `status`, the exit status the run stops at, None while it goes on;
# and `write_error`, the first failed write (R-55). This region also declares
# the plan's shape, refuse() and say(), for the plan lane and the apply lane
# (R-56 Q-12), and holds three stages: check_clean_arguments(), require_git()
# and check_plan().


class Plan:
    """One plan of `project clean` (data-model.md, "Plan"; contracts/project-clean.md,
    "Plan envelope"): the shape both US1 lanes write to (lead ruling R-56
    Q-12). build_plan() returns one and never a status (R-59 D4); the plan
    lane fills it (T049 to T053), the apply lane reads it (T054 to T057), and
    plan_document() (T051) writes it. A later task may add an attribute; a
    change to one below goes through the lead.

    - `repo`: what resolve_clean_target() returned, a dict whose "root" is
      the command directory and whose "evidence" is inspect_repository()'s
      dict, read where the argument resolved (lead ruling R-71 (b)); `root`,
      that directory; `mode` and `action`, the run's.
    - `evidence`: inspect_repository()'s dict for the plan's repository, or
      None until build_plan() sets it, from repo's "evidence", or by its own
      read for a caller that passes none (R-72 (g)); its `identity` holds
      `root` and `common_dir` as bytes, `dev` and `ino`.
    - `repository`: the envelope's object, repository_object()'s, built from
      that identity.
    - `rows`: the WorktreeRows, main worktree first, then by raw path bytes.
    - `merge_target`: {name, source, sha}, or None until established.
    - `selected`: the selected WorktreeRows in canonical order (raw path
      bytes), each given the attribute `removal_args`, the arguments of its
      removal child, ["-C", ROOT, "worktree", "remove", PATH] (design D9):
      ROOT the identity's `root` as bytes, or os.fsencode(root) while none is
      named, and PATH the row's raw_path, bytes. Its `operation.argv` is
      git_argv("removal", removal_args), each bytes element written through
      json_argument().
    - `excluded`: (row, reason) pairs in canonical order, every reason a
      gate's, never None (lead ruling R-67 (a)).
    - `target`: in mode single, P's row, or None while none, or more than
      one, matches; `target_rows`, the rows P may name (empty outside mode
      single for --action remove).
    - `notes`: the plan notes, {code, message} objects.
    - `completeness` ("complete" or "incomplete", None until decided) and
      `apply_allowed`.
    - `refusals`: the Refused objects refuse() recorded, one per code, in
      REFUSAL_CODES order; the first is the one a `REFUSED:` line names.
    - `digest`: plan_digest()'s value, None until computed.
    - `planning_probes`: the Git children other than removals that built the
      plan, the F + W + E of the estimate (research.md R8).
    - `printed`: whether print_plan() has written the human plan.
    - `report`: a baseline-shaped dict {root, target_branch,
      tracking_freshness, worktrees}, its worktrees the plan's rows, which
      push_or_delete()'s first body reads; the apply stages do not."""

    def __init__(self, repo, run):
        self.repo = repo
        self.root = repo["root"]
        self.mode = run.mode
        self.action = run.action
        self.evidence = None
        self.rows = []
        self.merge_target = None
        self.selected = []
        self.excluded = []
        self.target = None
        self.notes = []
        self.completeness = None
        self.apply_allowed = False
        self.refusals = []
        self.digest = None
        self.printed = False
        self.report = None


def clean_action(args):
    """The action of a `clean` run (lead ruling R-56 Q-1): --action's value,
    `push`, `remove` or `delete-branch`, under --apply; `remove` for
    --all-safe, whose apply removes; None for a report, where --action is
    ignored. Arguments are read with getattr, as clean_mode() reads them."""
    if getattr(args, "apply", False) and getattr(args, "action", None):
        return args.action
    if getattr(args, "all_safe", False):
        return "remove"
    return None


def divert_stream(stream):
    """Point stream's file descriptor at /dev/null (os.dup2) after a write to it
    failed (lead ruling R-55), so that what it still buffers, and every later
    write, goes nowhere instead of failing again, above all when Python
    flushes it at exit, which would print `Exception ignored ...` and exit 120.
    A stream with no descriptor, such as a test's StringIO, is left as it is.
    Never raises."""
    try:
        fd = stream.fileno()
        null = os.open(os.devnull, os.O_WRONLY)
    except (AttributeError, OSError, ValueError):
        return
    try:
        os.dup2(null, fd)
    except OSError:
        return
    finally:
        os.close(null)
    try:
        stream.flush()
    except (OSError, ValueError):
        pass


def write_failed(run, stream, exc):
    """The failed write exc to stream (R-55): the stream is diverted
    (divert_stream()), and exc recorded on run as `write_error` unless an
    earlier one is. Before the apply phase, the pipeline's check after printing
    (check_writes()) raises it, which ends the run as `internal-error`, exit 2,
    nothing mutated, unless a recorded signal outranks it; after the apply
    phase begins, writes are best-effort and D19 decides the exit."""
    divert_stream(stream)
    if getattr(run, "write_error", None) is None:
        run.write_error = exc


def say(run, text, stream=None):
    """Write text and a line feed to stream, run.human by default, and flush it:
    the one writer of `clean`'s human lines (R-55); `REFUSED:` goes to
    standard error through it. A failed write is recorded (write_failed()), so
    say() never raises OSError and a later line goes to /dev/null."""
    stream = run.human if stream is None else stream
    if stream is None:
        return
    try:
        stream.write(text + "\n")
        stream.flush()
    except OSError as exc:
        write_failed(run, stream, exc)


def check_writes(run):
    """The check after printing (R-55): flush standard output and standard
    error, recording a failure as say() does; then raise the run's recorded
    write error, if any. The pipeline calls it after the plan is printed and
    after the question, so before the apply phase a failed write ends the run:
    run_clean() makes the OSError `internal-error`, exit 2, and clean() makes
    it Interrupted when a signal was recorded first."""
    for stream in (sys.stdout, sys.stderr):
        if stream is None:
            continue
        try:
            stream.flush()
        except OSError as exc:
            write_failed(run, stream, exc)
    if run.write_error is not None:
        raise run.write_error


def settle_streams():
    """On leaving clean(), however it ends: flush standard output and standard
    error, diverting one whose flush fails, so that nothing clean() left
    buffered fails again at exit (R-55). Never raises."""
    for stream in (sys.stdout, sys.stderr):
        if stream is None:
            continue
        try:
            stream.flush()
        except OSError:
            divert_stream(stream)
        except ValueError:
            pass  # a closed stream holds nothing to flush


def advise(text):
    """main()'s `REFUSED:` and `Cancelled.` lines, printed to standard error as
    before, best-effort (R-54 X-3, R-55): a failed write, such as the EIO a
    terminal answers after SIGHUP, diverts the stream and never changes the
    exit status."""
    try:
        print(text, file=sys.stderr, flush=True)
    except OSError:
        divert_stream(sys.stderr if sys.stderr is not None else sys.stdout)


def read_slot(run):
    """The pipeline's read of the signal slot while planning (research.md R4;
    R-56 Q-1): a signal recorded before the apply phase ends the run by FR-036,
    so raise Interrupted with it; the scope then reaps every probe group, and
    main() prints `Cancelled.` and exits 130, 143 or 129 with no document."""
    if run.signal is not None:
        raise Interrupted(run.signal)


def refuse(plan, refusal, run):
    """Record refusal, a Refused, on plan, and return 2, the status of a run
    that stops at it (R-56 Q-3): check_plan() (the plan, select and confirm
    refusals), build_plan() (`worktree-not-found`) and confirm_removal()
    (`cancelled`) record through it and never raise, so that the plan
    envelope, not the extended error object, carries the refusal, and the
    pipeline prints the plan once, then, in human output, `REFUSED: MESSAGE`
    naming plan.refusals[0]. T053: the envelope's `apply_allowed` becomes
    false, and `refusals` holds one object per code, kept in REFUSAL_CODES
    order (a refusal with no code last, in the order recorded), so that the
    first is the first check that refused, FR-024's order and REFUSAL_CODES's
    being the same; a second refusal of a code already held is not added."""
    if refusal.code is None or all(item.code != refusal.code for item in plan.refusals):
        plan.refusals.append(refusal)
        plan.refusals.sort(key=lambda item: REFUSAL_CODES.index(item.code)
                           if item.code in REFUSAL_CODES else len(REFUSAL_CODES))
    plan.apply_allowed = False
    return 2


def check_clean_arguments(args):
    """The argument checks, before any Git child, `git --version` included
    (T048; contracts/project-clean.md, "Argument checks"; FR-019). Each raises
    a Refused with code `invalid-arguments` to main(), in the contract table's
    order: --all-safe given with --action, --branch or --worktree; --expect-plan
    without both --all-safe and --apply; an --expect-plan value that is not 64
    lowercase hexadecimal characters; --apply --json with --action push or
    delete-branch, still refused (OQ-10), while --apply --json is accepted with
    --all-safe and with --action remove; then the baseline checks of --apply
    (project:677-678, :681-682, :708-709 and :724-725 at 961c405), their
    messages kept (lead ruling R-45 (6)). Every flag the table does not refuse
    keeps the baseline's handling: without --apply, --yes, --action, --branch
    and --worktree are ignored, and so is an unused --branch or --worktree
    (plan review M9). Arguments are read with getattr."""
    apply, action = getattr(args, "apply", False), getattr(args, "action", None)
    all_safe, expected = getattr(args, "all_safe", False), getattr(args, "expect_plan", None)
    message = None
    if all_safe and (action is not None or getattr(args, "branch", None) is not None
                     or getattr(args, "worktree", None) is not None):
        message = TEXT["invalid_arguments_all_safe"]
    elif expected is not None and not (all_safe and apply):
        message = TEXT["invalid_arguments_expect_plan"]
    elif expected is not None and not re.fullmatch(r"[0-9a-f]{64}", expected):
        message = TEXT["invalid_arguments_expect_plan_value"]
    elif not apply or all_safe:
        return
    elif getattr(args, "json", False) and action in ("push", "delete-branch"):
        message = "--json cannot be combined with --apply; use JSON for the read-only plan."
    elif not action:
        message = "--apply requires --action push|remove|delete-branch"
    elif action == "push" and not getattr(args, "branch", None):
        message = "Push cleanup requires --branch BRANCH"
    elif action == "remove" and not getattr(args, "worktree", None):
        message = "Worktree cleanup requires --worktree PATH"
    elif action == "delete-branch" and not getattr(args, "branch", None):
        message = "Branch cleanup requires --branch BRANCH"
    if message is not None:
        raise Refused(message, code="invalid-arguments")


def require_git(run):
    """The configuration-path test, then the version check, once, after the
    argument checks and before resolution (T048; FR-002, FR-053;
    contracts/project-clean.md, "Order of a run"). A variable that fails D11's
    test (relative_config_paths()) refuses `relative-config-path` with D18's
    lines, one per such variable, exit 2, before any Git child, `git
    --version` included, so that no push or removal child starts either
    (Brett Heap's ruling LQ-15; lead ruling R-102). Then git_version(run),
    memoized on the run, refusing `git-too-old` or `git-unavailable` with its
    contract message, exit 2, before any repository is probed. Returns None
    when Git may run."""
    names = relative_config_paths()
    if names:
        raise Refused(config_path_message(names), code="relative-config-path")
    version = git_version(run)
    if version.code == "git-too-old":
        raise Refused(TEXT["git_too_old"].format(VERSION=version.text), code="git-too-old")
    if version.code is not None:
        raise Refused(TEXT["git_unavailable"].format(DETAIL=version.detail), code="git-unavailable")
    return None


def check_plan(plan, run):
    """Decide where the run goes after the plan is built (T053; FR-024;
    contracts/project-clean.md, "Order of a run"; lead rulings R-56, R-59 D4,
    R-62 (a) and R-67 (b)): return the exit status the run stops at, or None
    when it goes on to the question or --yes (or to push or delete-branch). It
    only decides: each plan, select or confirm refusal is recorded through
    refuse() and 2 returned, never raised to main(); the pipeline prints once.

    The checks, in this order, the first that refuses ending them:
    1. an incomplete plan (plan_completeness(); in mode single for --action
       remove, P's own rows apart): one refusal per code; a preview exits 1,
       a run with --apply 2, before any question;
    2. single, `worktree-not-found`, which build_plan() recorded;
    3. single, P's own incompleteness: P names no single row (several
       matched, or one not decided), or its row is inspection-error or
       unprobed: inspection-incomplete;
    4. all-safe, an --expect-plan digest that differs (`plan-digest-mismatch`);
    5. all-safe, a complete plan selecting nothing: exit 0, no question;
    6. single, P excluded by a gate (`target-excluded`, target_refusal());
    7. `confirmation-required` for --apply without --yes on a standard input
       that is not a terminal, isatty() read now, since T046 patches it.
    A report takes check 1 as a preview does, exiting 1 when incomplete with
    one refusal per code, and otherwise 0, or 2 for a refusal already
    recorded (T101; pcl:40-43; lead ruling R-80, P-5); push and
    delete-branch go on after check 1, to their own checks; a preview that
    passes every check exits 0."""
    args = run.args
    apply = getattr(args, "apply", False)
    if plan.mode == "report":
        codes = plan_completeness(plan)
        for code in codes:
            refuse(plan, incomplete_refusal(plan, code), run)
        if codes:
            return 1
        return 2 if plan.refusals else 0
    single, removing = plan.mode == "single", plan.action == "remove"
    target_rows = getattr(plan, "target_rows", [])
    codes = plan_completeness(plan, target_rows if single and removing else ())
    if codes:
        for code in codes:
            refuse(plan, incomplete_refusal(plan, code), run)
        return 2 if apply else 1
    if plan.refusals:
        return 2
    if single and not removing:
        return None
    if single:
        target = plan.target
        if target is None or row_incomplete(target):
            return refuse(plan, incomplete_refusal(plan, "inspection-incomplete"), run)
        reason = next((reason for row, reason in plan.excluded if row is target), None)
        if reason is not None:
            return refuse(plan, target_refusal(target, reason), run)
    else:
        expected = getattr(args, "expect_plan", None)
        if apply and expected is not None and expected != plan.digest:
            return refuse(plan, Refused(TEXT["plan_digest_mismatch"].format(DIGEST=plan.digest, EXPECTED=expected),
                                        code="plan-digest-mismatch"), run)
        if not plan.selected or not apply:
            return 0
    if not getattr(args, "yes", False):
        try:
            terminal = sys.stdin is not None and sys.stdin.isatty()
        except (AttributeError, OSError, ValueError):
            terminal = False
        if not terminal:
            return refuse(plan, Refused(TEXT["confirmation_required"], code="confirmation-required"), run)
    return None
# endregion dispatcher

# region resolution
def is_bare_name(argument):
    """Whether argument names a project rather than a path (research.md R13
    as plan review M15 words it): after expanduser(), a relative argument
    that contains no `/` and is neither `.` nor `..`. An empty argument is
    none, as discover() reads it."""
    text = os.path.expanduser(os.fsdecode(argument))
    return bool(text) and not os.path.isabs(text) and "/" not in text and text not in (".", "..")


def escaped_not_found(message):
    """discover()'s two bare-name messages, `Directory does not exist: PATH` and
    `No project found at PATH; supply a path or name.`, with PATH printed through
    human_path() as every other path of `clean` is (FR-041; lead ruling R-92 (c));
    None for any other message. discover() prints the user's own argument raw,
    and status, doctor and update share it, so it stays as it is."""
    for head, tail in (("Directory does not exist: ", ""), ("No project found at ", "; supply a path or name.")):
        if message.startswith(head) and message.endswith(tail):
            return head + human_path(message[len(head):len(message) - len(tail)]) + tail
    return None


def resolve_clean_target(args, run):
    """Resolve the target argument Git-first to exactly one repository and
    its main worktree (T107; D8, FR-016, FR-017; contracts/project-clean.md,
    "Resolution"; lead rulings R-13, R-51 and R-53, P-10 to P-12 and P-20).
    Returns {"root": the main worktree, a Path, the command directory;
    "evidence": inspect_repository()'s dict}, which build_plan() reads
    instead of running row 3 again (lead ruling R-71 (b)).

    After expanduser(): an absolute path is probed where it names, and its
    realpath must equal row 3's toplevel and that toplevel be the main
    worktree; a relative path, or none, is joined to the working directory
    and probed there; a bare name (is_bare_name()) goes through discover()'s
    name lookup, and the directory it returns must be a worktree toplevel. A
    relative path and a bare name resolve to their repository's main
    worktree. discover()'s family-holder and manifest-ancestor redirections
    never apply to a path. discover()'s bare-name refusals are coded by their
    exact baseline messages, `ambiguous-name` for "Ambiguous project name;
    supply a path." and `repository-not-found` for "Directory does not exist:
    PATH" and "No project found at PATH; supply a path or name.", until US9's
    T118 gives discover() these codes itself (P-10); a refusal that already
    carries a code passes unchanged, except that the PATH of a
    `repository-not-found` message is printed through human_path() (R-92 (c)).
    A name the lookup cannot examine, `~user` for no such user, a name too
    long for a path component, or one looked up from a working directory
    that is gone, is `repository-not-found` with the message `Directory does
    not exist: PATH`, as a name with no directory is (plan review F4; lane
    3's US7/US9 L-1 and L-3). A relative path, or none, from a working
    directory that is gone is refused `target-not-repository-root` naming
    the argument as given, or `.`; otherwise a relative path's refusal names
    the directory Git examines, its realpath, not its lexical form (L-2).

    Refused `target-not-repository-root`, exit 2, before any plan and with no
    context, in M6's order: row 3 failed (a directory outside any
    repository, a bare repository's own directory, a timeout); a submodule
    checkout (row 3's third line); a main worktree that main_worktree() gives
    as (None, cause); then the absolute-path and bare-name rules above. Then
    `unsupported-path-bytes`, exit 2, before any plan or digest, for a root or
    common directory that is not valid UTF-8 (json_path()'s flag; FR-041,
    T112): the root, the command directory this returns, is checked first and
    named when invalid, else the common directory, as bytes, so the refusal
    object carries `path_valid_utf8: false`; it has no context, so the error
    object's `repository` and `merge_target` are null (lead ruling R-80,
    P-13). Rows 4, 6 and 7 and the manifest read have run by then, inside
    inspect_repository(); no row is probed. Then the merge target's own
    refusal (`no-merge-target`, `manifest-invalid`), before any row is
    probed, its context the repository and a null merge target. A
    repository-wide probe that failed after row 3 is no refusal here:
    build_plan() makes that plan incomplete. Where row 5 failed, the main
    worktree main_worktree() named (`main_path`) is still the root and the
    command directory, and the absolute-path rule compares the toplevel
    with it (plan review F2)."""
    target = getattr(args, "target", None) or ""
    text = os.path.expanduser(target)
    bare, absolute = is_bare_name(target), os.path.isabs(text)

    def refused(path):
        return Refused(TEXT["target_not_repository_root"].format(PATH=human_path(path)),
                       code="target-not-repository-root", path=path)

    if bare:
        try:
            found = discover(target)
        except Refused as exc:
            message = str(exc)
            escaped = escaped_not_found(message)
            if exc.code is None and message == "Ambiguous project name; supply a path.":
                exc.code = "ambiguous-name"
            elif exc.code is None and escaped is not None:
                exc.code = "repository-not-found"
            if exc.code == "repository-not-found" and escaped is not None:
                exc.args = (escaped,)  # R-92 (c): the path the message names prints escaped
            raise
        except (OSError, RuntimeError) as exc:
            # A name the lookup cannot examine names no project directory:
            # `~user` for no such user (Path.expanduser() raises
            # RuntimeError), a name longer than a path component allows
            # (ENAMETOOLONG; Python 3.15 answers False there and reaches
            # discover()'s own refusal), or a working directory that is gone
            # (ENOENT). discover()'s message names the name against the working
            # directory, or the name as given when that is gone (plan review F4;
            # lane 3's US7/US9 L-1 and L-3).
            if isinstance(exc, OSError) and exc.errno not in (errno.ENAMETOOLONG, errno.ENOENT):
                raise
            if not isinstance(exc, OSError) and type(exc) is not RuntimeError:
                raise
            try:
                named = os.path.join(os.getcwd(), target)
            except OSError:
                named = target
            raise Refused("Directory does not exist: " + human_path(named), code="repository-not-found") from None
        directory = shown = os.fsencode(found)
    elif absolute:
        directory = shown = os.fsencode(text)
    else:
        try:
            cwd = os.getcwdb()
        except OSError:  # the working directory is gone: Git finds no worktree there (pcl:449-451; L-3)
            raise refused(os.fsencode(text) if text else b".") from None
        directory = os.path.join(cwd, os.fsencode(text)) if text else cwd
        # The directory Git examines: `..` taken after any symlink before it,
        # as chdir() takes it, not lexically (lane 3's US7/US9 L-2).
        shown = os.path.realpath(directory)

    evidence = inspect_repository(directory, run)
    identity = evidence["identity"]
    if identity is None or evidence["superproject"] is not None or evidence["main_cause"] is not None:
        raise refused(shown)
    # Where row 5 failed the root is not confirmed, but the main worktree is
    # still the one main_worktree() named, never a linked toplevel (plan review F2).
    toplevel, root = evidence["toplevel"], identity["root"] or evidence.get("main_path")
    if bare or absolute:  # the directory itself must be a worktree toplevel
        try:
            exact = _realpath(directory) == toplevel
        except EvidenceError:
            exact = False
        if not exact or (absolute and root is not None and toplevel != root):
            raise refused(shown)
    for raw in (toplevel if root is None else root, identity["common_dir"]):  # FR-041; R-80 P-13
        if not json_path(raw)[1]:
            raise Refused(TEXT["unsupported_path_bytes"].format(PATH=human_path(raw)),
                          code="unsupported-path-bytes", path=raw)
    refusal = evidence["merge_target_refusal"]
    if refusal is not None:
        refusal.context = {"repository": repository_object(identity), "merge_target": None}
        raise refusal
    return {"root": Path(os.fsdecode(toplevel if root is None else root)), "evidence": evidence}
# endregion resolution

# region plan
# The plan of one run (T049, T051; data-model.md, "Plan"; contracts/project-clean.md,
# "Plan envelope"; design D12 to D14; research.md R8 and R12).

# The baseline's freshness text, the envelope's `tracking_freshness`.
TRACKING_FRESHNESS = "local refs only; remote information is as of the last fetch; no fetch performed"


def repository_object(identity):
    """The envelope's `repository` (REPOSITORY_KEYS's order) for inspect_repository()'s
    identity: each path as json_path() writes it beside its flag; root and its
    flag null while the main worktree is not named."""
    root, root_valid = (None, None) if identity["root"] is None else json_path(identity["root"])
    common_dir, common_valid = json_path(identity["common_dir"])
    return {"root": root, "common_dir": common_dir, "dev": identity["dev"], "ino": identity["ino"],
            "root_valid_utf8": root_valid, "common_dir_valid_utf8": common_valid}


def _bounded_realpath(path):
    """The realpath of path by one fs_call(), or None when the call raised or
    was cut at its budget."""
    try:
        found = fs_call(os.path.realpath, path)
    except OSError:
        return None
    return None if isinstance(found, DriverOutcome) else found


def match_target(plan, run, entries, cap):
    """P of a named removal, `--apply --action remove --worktree P` (D13;
    contracts/project-clean.md, "Argument checks" and "Order of a run"; lead
    rulings R-53 P-15, R-56 and R-67 (b) as corrected), matched against the
    whole registry before any row is inspected. entries are the registry
    entries that are rows, (raw, record) in canonical order, raw the path the
    row carries; cap the plan's row cap. --worktree is expanded and
    realpath'd, which joins it to the working directory, by one bounded call;
    an entry matches when raw equals P's bytes, or else when its own realpath,
    one bounded call each, does. The entries matched are P's rows:
    worktree_rows() inspects them before any other row, so that P's status
    probe is the run's first, and they are exempt from the row cap. When any
    realpath cannot be read, P's own or another entry's, a call cut at the
    work deadline included, P's match is undecided (failing closed; lead
    rulings R-73 (d) and R-78 (b)): no entry is exempt, the entries matched are
    the ones the cap takes, the first cap of entries, the main worktree first,
    and no other row is inspected, so that a deadline during matching never
    puts more than the cap's rows into the plan. Sets plan.target_rows, the
    rows inspected for P, and plan.target, the one row when exactly one entry
    matched and was decided, else None. No match records `worktree-not-found`
    through refuse() with the baseline message, never raised (R-59 D4);
    several matches, or one not decided, leave plan.target None, so that
    nothing is selected for P and check_plan() refuses with
    inspection-incomplete. Returns (matched, path, exempt): the entries
    matched; P's realpath, or the expanded argument where that cannot be read,
    the PATH of the single-mode notes while no row is P's; and whether the
    entries matched are exempt from the cap, that is whether P's match was
    decided."""
    wanted = os.path.expanduser(os.fsencode(run.args.worktree))
    found = _bounded_realpath(wanted)
    matches, decided = [], found is not None
    if decided:
        for raw, record in entries:
            if raw != found:
                real = _bounded_realpath(raw)
                if real is None:
                    decided = False  # R-78 (b): an unread realpath leaves P's match undecided
                    break
                if real != found:
                    continue
            matches.append((raw, record))
    if not decided:
        matches = list(entries[:cap])
    path = found if found is not None else wanted
    plan.target_rows = worktree_rows(plan.evidence, run, records=[record for _, record in matches]) if matches else []
    if len(matches) == 1 and decided and len(plan.target_rows) == 1:
        plan.target = plan.target_rows[0]
    elif not matches:
        refuse(plan, Refused(f"No unique linked worktree found at {human_path(path)}",
                             code="worktree-not-found", path=path), run)
    return matches, path, decided


def row_incomplete(row):
    """Whether a row's own evidence is incomplete: `inspection-error`, or
    carrying the unprobed marker (T066's reflog read past its budget)."""
    return bool(row.unprobed) or row["classification"] == "inspection-error"


def cut_at_deadline(errors):
    """Whether errors, row errors {code, message}, are those of reads the work
    deadline stopped and nothing else: at least one, each `deadline-exceeded`
    (lead ruling R-80, P-1)."""
    return bool(errors) and all(error["code"] == "deadline-exceeded" for error in errors)


def deadline_stopped(row):
    """Whether row is incomplete only because the work deadline stopped it
    (T099; lead rulings R-67 (a), R-69 and R-80, P-1): `inspection-error`,
    every row error `deadline-exceeded`, and no unprobed marker. Such a row is
    `deadline-exceeded`'s, never `inspection-incomplete`'s; a row left
    unprobed by its reflog read, which only a cut at the filesystem budget
    leaves, stays `inspection-incomplete`'s, while one whose reflog read the
    deadline cut is inspection-error and so this function's (reflog_gate();
    Brett Heap's ruling "O-1: deadline-exceeded", lead ruling R-263)."""
    return (not row.unprobed and row["classification"] == "inspection-error"
            and cut_at_deadline(row.get("errors")))


def plan_completeness(plan, exclude=()):
    """The codes that make plan incomplete, in REFUSAL_CODES order (FR-024,
    FR-031; data-model.md, "Plan"; analyze M6; T075, T099): `inspection-incomplete`
    when a repository-wide probe failed (plan.evidence's errors), when a
    counted row of plan.rows not in exclude is `inspection-error` or unprobed,
    or when P's rows are not excluded and P names no single established row
    (plan.target None while plan.target_rows holds rows); `inspect-cap` when
    rows were left past the row cap (plan.omitted's count); and
    `deadline-exceeded` when the work deadline stopped planning: a counted
    row deadline_stopped() names, or a repository-wide probe whose every
    error is `deadline-exceeded`, counts toward it and not toward
    `inspection-incomplete`, so that no row counts twice (lead ruling R-80,
    P-1). In mode single for --action remove only P's own rows count and the
    cap is no code: another row's state and the rows past the cap are
    non-blocking notes, which build_plan() records, while P's own evidence
    stays strict (the delta's "Clean can explicitly retire verified
    worktrees"). Every other plan, push and delete-branch included, counts
    every row and the cap (plan review B1). check_plan() passes P's rows as
    exclude, so that its own step 3 judges them."""
    skip = {id(row) for row in exclude}
    target_rows = getattr(plan, "target_rows", [])
    named = plan.mode == "single" and plan.action == "remove"
    own = {id(row) for row in target_rows}
    counted = [row for row in plan.rows if id(row) not in skip and (id(row) in own or not named)]
    errors = (plan.evidence or {}).get("errors") or []
    incomplete = [row for row in counted if row_incomplete(row)]
    stopped = [row for row in incomplete if deadline_stopped(row)]
    codes = []
    if ((errors and not cut_at_deadline(errors)) or len(stopped) < len(incomplete)
            or (plan.target is None and bool(target_rows) and not any(id(row) in skip for row in target_rows))):
        codes.append("inspection-incomplete")
    if not named and (getattr(plan, "omitted", None) or {}).get("count"):
        codes.append("inspect-cap")
    if cut_at_deadline(errors) or stopped:
        codes.append("deadline-exceeded")
    return codes


def incomplete_refusal(plan, code):
    """The refusal of a plan incomplete with code (FR-024, FR-031; design D18):
    `The plan is incomplete (CODE): REMEDY.`, REMEDY D18's for the code. The
    inspect-cap remedy's N counts the registry entries that become rows, as
    the row cap and build_plan() count them: a bare first entry, and a first
    entry that is the common directory with no main worktree named, are no
    rows (D8; contracts/project-clean.md, "Codes"; lead rulings R-73 (d) and
    R-89 (b))."""
    if code == "inspect-cap":
        evidence = plan.evidence or {}
        registry = evidence.get("records") or ()
        no_row = bool(registry) and bool(registry[0]["bare"] or (
            evidence.get("first_is_common_dir") and (evidence.get("identity") or {}).get("root") is None))
        remedy = TEXT["remedy_inspect_cap"].format(N=len(registry) - no_row, M=LIMITS["worktree_rows"][plan.mode])
    elif code == "deadline-exceeded":
        remedy = TEXT["remedy_deadline_exceeded"]
    else:
        remedy = TEXT["remedy_inspection_incomplete"]
    return Refused(TEXT["plan_incomplete"].format(CODE=code, REMEDY=remedy), code=code)


def json_argument(argument):
    """One argument of a child's vector as a JSON document writes it."""
    return argument if isinstance(argument, str) else json_path(argument)[0]


def select_entry(row, plan):
    """One `selected` entry (contracts/project-clean.md, "Plan envelope"), in
    SELECTED_KEYS's order: the path beside its flag; the branch evidence
    (branch, head, upstream, upstream_oid, ahead, behind); the worktree identity
    (dev, ino, admin_id); locked; the baseline signature fields (present, dirty,
    ignored_files, remote_present, merged_into_target, current, classification);
    and operation, {kind: "worktree-remove", argv}, argv the exact vector of
    the row's removal child, git_argv("removal", row.removal_args), each path
    as json_path() writes it."""
    values = dict(row)
    values.update(upstream_oid=row.upstream_oid, dev=row.dev, ino=row.ino,
                  admin_id=None if row.admin_id is None else json_path(row.admin_id)[0],
                  operation={"kind": "worktree-remove",
                             "argv": [json_argument(arg) for arg in git_argv("removal", row.removal_args)]})
    return {key: values[key] for key in SELECTED_KEYS}


def plan_digest(plan):
    """The plan's digest (FR-025; research.md R12; T051): the lowercase hex
    SHA-256 of the UTF-8 encoding of json.dumps(value, sort_keys=True,
    separators=(",", ":"), ensure_ascii=False), value holding exactly the
    repository's `root`, `common_dir`, `dev` and `ino`, the merge target's
    `name` and `sha`, and `selected`, the [path, branch, head] of each selected
    row in canonical order, or null where a report withholds the selection.
    The mode, observed_at, the flags, `excluded` and the notes are not in it,
    and ensure_ascii=False serves this text alone, never a document. Paths are
    the text the document writes; a branch name that is not valid UTF-8 gives
    back its own bytes (surrogateescape)."""
    repository = plan.repository or {}
    merge_target = plan.merge_target or {}
    value = {
        "repository": {key: repository.get(key) for key in ("root", "common_dir", "dev", "ino")},
        "merge_target": {key: merge_target.get(key) for key in ("name", "sha")},
        "selected": None if plan.selected is None else [
            [row["path"], row["branch"], row["head"]] for row in plan.selected],
    }
    text = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(text.encode("utf-8", "surrogateescape")).hexdigest()


def revalidation_children(plan):
    """The most Git children one target's revalidation spawns (design D7 and
    D14; the project-clean delta's "at most six Git children, seven where the
    plan read the repository's extensions.worktreeConfig as true"; lead ruling
    R-165): LIMITS["revalidation_children_worktree_config"] where the plan's
    row 4c read the extension as true, as revalidation_difference() then runs
    the effective-work-tree probe, else LIMITS["revalidation_children"]."""
    evidence = getattr(plan, "evidence", None) or {}
    worktree_config = evidence.get("worktree_config") is True
    return LIMITS["revalidation_children_worktree_config" if worktree_config else "revalidation_children"]


def plan_limits(mode):
    """The envelope's `limits`: the mode's row cap and the bounds, as in force."""
    return {"worktree_rows": LIMITS["worktree_rows"][mode], "targets": LIMITS["targets"],
            "ignored_entries": LIMITS["ignored_entries"], "status_records": LIMITS["status_records"],
            "ignored_samples": LIMITS["ignored_samples"]}


def plan_budget():
    """The envelope's `budget`: the values of TIMING in force, read now (R-29)."""
    return {"probe_timeout_seconds": TIMING["probe_budget"],
            "invocation_timeout_seconds": TIMING["invocation_deadline"],
            "reconciliation_reserve_seconds": TIMING["reconciliation_reserve"],
            "removal_floor_seconds": TIMING["removal_floor"],
            "removal_ceiling_seconds": TIMING["removal_ceiling"],
            "probe_concurrency": 1}


def plan_document(plan):
    """The plan envelope (T051; contracts/project-clean.md, "Plan envelope";
    plan review M6; lead ruling R-56), the keys of PLAN_ENVELOPE_KEYS and no
    other, in that order: the baseline `root`, `target_branch` and
    `tracking_freshness` kept; `observed_at` from region guard's observed_at();
    `worktrees`, the rows in canonical order, row `notes` code strings;
    `probes` and `operations` (research.md R8; lead ruling R-27), `estimated`
    the upper bound of an --apply run of this plan in every mode, F + W + E +
    RT + 3 and T, R the children of one revalidation (revalidation_children(),
    six or seven) and 3 the final rescan's (LIMITS["rescan_children"]), and
    `performed` from the counters of the invocation in force;
    `selected` (select_entry()), `excluded` {path, path_valid_utf8, branch,
    classification, reason}, `omitted` ({count: 0, exactness: "exact"} until
    T075 sets plan.omitted), the plan's `notes` as {code, message} objects,
    `completeness`, `apply_allowed`, `refusals` as refusal objects, and
    `plan_digest`. print_plan() writes it through write_document(), with
    ensure_ascii=True."""
    run = current_invocation()
    selected = plan.selected
    targets = 0 if selected is None else len(selected)
    repository, merge_target = plan.repository, plan.merge_target
    root = (repository["root"] if repository and repository["root"] is not None
            else json_path(os.fsencode(plan.root))[0])
    values = {
        "schema_version": 1,
        "observed_at": observed_at(),
        "mode": plan.mode,
        "root": root,
        "target_branch": merge_target["name"] if merge_target else None,
        "tracking_freshness": TRACKING_FRESHNESS,
        "worktrees": [dict(row) for row in plan.rows],
        "repository": repository,
        "merge_target": merge_target,
        "limits": plan_limits(plan.mode),
        "budget": plan_budget(),
        "probes": {"estimated": getattr(plan, "planning_probes", 0) + revalidation_children(plan) * targets
                   + LIMITS["rescan_children"], "performed": run.probes},
        "operations": {"estimated": targets, "performed": run.operations},
        "selected": None if selected is None else [select_entry(row, plan) for row in selected],
        "excluded": [{"path": row["path"], "path_valid_utf8": row["path_valid_utf8"], "branch": row.get("branch"),
                      "classification": row.get("classification"), "reason": reason}
                     for row, reason in plan.excluded],
        "omitted": getattr(plan, "omitted", None) or {"count": 0, "exactness": "exact"},
        "notes": [dict(note) for note in plan.notes],
        "completeness": plan.completeness,
        "apply_allowed": plan.apply_allowed,
        "refusals": [refusal.as_object() for refusal in plan.refusals],
        "plan_digest": plan.digest,
    }
    return {key: values[key] for key in PLAN_ENVELOPE_KEYS}


def build_plan(repo, run):
    """Build the run's Plan for repo, resolve_clean_target()'s dict, and return
    it, never a status (T049; data-model.md, "Plan"; lead rulings R-56 and R-59
    D4). It reads lane G's evidence directly, inspect_repository()'s dict and
    worktree_rows(), so that a failed repository-wide probe gives a plan
    incomplete with inspection-incomplete, never a refusal. That dict is
    repo's "evidence", the resolution's, so that row 3
    runs once (lead ruling R-71 (b)). Only for a caller that passes no
    evidence does build_plan() read it itself and raise the baseline's
    `Cannot inspect Git repository at ROOT` where row 3 failed, ROOT is no
    worktree toplevel, or no main worktree is named with no probe failed. On
    clean's path that raise is unreachable, because the evidence comes from
    the resolution, which refuses those repositories itself (T107; lead
    ruling R-72 (g)). Still raised, as the repository as a whole cannot be
    planned: the merge target's own refusal (`no-merge-target`, a
    manifest's), with the repository in its context.

    The plan holds: `evidence`; `repository`, the envelope's object;
    `merge_target` {name, source, sha}, its resolution's notes moved to the
    plan's `notes` as {code, message} objects (P-13); `rows`, the main worktree
    first, then by raw path bytes, read within the row cap (T075; FR-013,
    FR-031, D13): the registry, row 4, is read whole before any cap, and of
    its entries that are rows, in that order, the first LIMITS["worktree_rows"]
    of the mode (128, or 256 in a report) are inspected, the main worktree and
    missing rows counting; the rest are not inspected, in neither `rows` nor
    `excluded`, and counted in `omitted`, {count, exactness: "exact"}. In mode
    single for --action remove, P is matched against the whole registry first
    and inspected first (match_target(): `target_rows` and `target`,
    `worktree-not-found` recorded through refuse()), exempt from the cap, so
    that the rows inspected are P's and the first 128 others (lead ruling R-53
    P-15), unless P's match is undecided (R-73 (d), R-78 (b)). P's row is
    established first, identity, status probe and gates (D13; lead ruling
    R-93 (d)): gate_rows() runs on P's rows, gates 1 to 7, gate 8 with P
    alone and gates 9 and 10, before worktree_rows() inspects any other row,
    and then on the other rows. No gate reads another row to decide P, so a
    work deadline reached among the other rows leaves P's row decided and
    the plan complete beside the note `deadline-exceeded`, while one that
    cuts P's own read leaves P's row incomplete, which check_plan() refuses
    as inspection-incomplete. Another row's
    inspection-error or unprobed marker, the rows past the cap, and the rows
    the work deadline stopped are its non-blocking notes
    `inspection-incomplete`, `inspect-cap` and `deadline-exceeded`, a row
    counted in one of them only (lead ruling R-80, P-1). When P's match is
    undecided none of them is recorded, since each says the rows do not
    block P beside the plan's refusal of P, inspection-incomplete, which
    speaks alone (lead ruling R-93 (e)). Push and
    delete-branch take the cap with no exemption and the batch's completeness
    (plan_completeness()).

    Planning stops at the work deadline (T099, FR-029): every Git child and
    filesystem call gets min(5 s, work remaining) from the Invocation
    (child_budget(), region runner), and once none is left none is started,
    so each row the deadline stops is `inspection-error` with a
    `deadline-exceeded` row error, excluded as `inspection-error`, never
    unprobed (lead rulings R-67 (a) and R-69), and the plan is incomplete
    with `deadline-exceeded` (plan_completeness()). Then `selected` and
    `excluded` from gate_rows(), P's rows' and the other rows' together, both
    by raw path bytes, each selected row given `removal_args`, ["-C",
    ROOT, "worktree", "remove", PATH] with ROOT the command directory and PATH
    the registry's raw bytes (design D9); `completeness` and `apply_allowed`
    (false for every report); `digest` (plan_digest()); `planning_probes`, the
    Git children other than removals that this invocation ran to build it, the
    F + W + E of the estimate (research.md R8); and `report`, the baseline
    report built from the same rows, which the first bodies of
    confirm_removal(), apply_removals() and push_or_delete() read until the
    apply and push lanes replace them. gate_rows() runs gate 7, T066's
    reflog_gate(), on every row that passes gates 1 to 6, so an unstarted
    branch is excluded as `unstarted-branch`, and one whose reflog cannot
    decide it as `reflog-unavailable` (lead ruling R-78 (c)). Gate 8,
    deferral_gate(), takes the first 16 rows that pass gates 1 to 7 and
    defers the rest as `deferred-target-cap`, P alone counting in mode
    single (T100). A report above the --all-safe row cap of 128 rows, which
    counts the entries that become rows as `inspect-cap` does (contract,
    "Codes"; lead ruling R-73 (d)), has `selected` null and the note
    `inspect-cap` with `rows`, that count, which alone leaves it complete,
    while the gates still run and `excluded` lists every inspected row a
    gate excludes; its own cap of 256 rows makes it `inspect-cap` incomplete
    (T101; D14, FR-031)."""
    plan = Plan(repo, run)
    root = repo["root"]
    evidence = plan.evidence = repo.get("evidence")  # the resolution's: row 3 runs once (R-71 (b))
    if evidence is None:
        evidence = plan.evidence = inspect_repository(root, run)
        identity = evidence["identity"]
        try:
            toplevel = identity is not None and _realpath(os.fsencode(root)) == evidence["toplevel"]
        except EvidenceError:
            toplevel = False
        if not toplevel or (identity["root"] is None and not evidence["errors"]):
            raise Refused(f"Cannot inspect Git repository at {human_path(root)}")
    identity = evidence["identity"]
    plan.repository = repository_object(identity)
    refusal = evidence["merge_target_refusal"]
    if refusal is not None:
        if refusal.context is None:
            refusal.context = {"repository": plan.repository}
        raise refusal
    target = evidence["merge_target"]
    if target is not None:
        plan.merge_target = {key: target[key] for key in MERGE_TARGET_KEYS}
        plan.notes.extend(target.get("notes") or ())
    # The registry's entries that are rows, as worktree_rows() builds them
    # (D8), in canonical order: the main worktree first, then raw path bytes.
    registry, common_first, entries = evidence["records"] or [], evidence["first_is_common_dir"], []
    for index, record in enumerate(registry):
        if index == 0 and (record["bare"] or (common_first and identity["root"] is None)):
            continue
        entries.append((identity["root"] if index == 0 and common_first else record["path"], record))
    entries.sort(key=lambda entry: (entry[1] is not registry[0], entry[0]))
    cap = LIMITS["worktree_rows"][plan.mode]
    named = plan.mode == "single" and plan.action == "remove"
    plan.target_rows, matched, path, exempt = [], (), None, True
    selected, excluded = [], []
    if named:
        matched, path, exempt = match_target(plan, run, entries, cap)
        # D13: P's row first, its gates included, before any other row is
        # inspected (lead ruling R-93 (d)); no gate reads another row.
        selected, excluded = gate_rows(plan.target_rows, plan, run)
    own = {id(record) for _, record in matched}
    others = [record for _, record in entries if id(record) not in own]
    room = cap if exempt else max(0, cap - len(matched))  # an undecided P takes its rows from the cap
    rows = list(plan.target_rows)
    if others[:room]:
        rows += worktree_rows(evidence, run, records=others[:room])
    plan.omitted = {"count": max(0, len(others) - room), "exactness": "exact"}
    plan.rows = sorted(rows, key=lambda row: (not row.main, row.raw_path))
    first = {id(row) for row in plan.target_rows}
    later_selected, later_excluded = gate_rows([row for row in plan.rows if id(row) not in first], plan, run)
    plan.selected = sorted(selected + later_selected, key=lambda row: row.raw_path)
    plan.excluded = sorted(excluded + later_excluded, key=lambda item: item[0].raw_path)
    command_dir = identity["root"] if identity["root"] is not None else os.fsencode(root)
    for row in plan.selected:
        row.removal_args = ["-C", command_dir, "worktree", "remove", row.raw_path]
    batch_cap = LIMITS["worktree_rows"]["all-safe"]
    if plan.mode == "report" and len(entries) > batch_cap:  # T101; D14, FR-031
        plan.selected = None
        plan.notes.append({"code": "inspect-cap", "message": TEXT["note_inspect_cap_report"].format(
            N=len(entries), M=batch_cap), "rows": len(entries)})
    if named and exempt:  # an undecided P's refusal speaks alone (lead ruling R-93 (e))
        shown = human_path(plan.target.raw_path if plan.target is not None else path)
        own = {id(row) for row in plan.target_rows}
        others = [row for row in plan.rows if id(row) not in own and row_incomplete(row)]
        stopped = sum(1 for row in others if deadline_stopped(row))  # R-80 P-1: one note per row
        if len(others) - stopped:
            plan.notes.append({"code": "inspection-incomplete", "message": TEXT["note_inspection_incomplete"].format(
                K=len(others) - stopped, PATH=shown)})
        if plan.omitted["count"]:
            plan.notes.append({"code": "inspect-cap", "message": TEXT["note_inspect_cap"].format(
                K=plan.omitted["count"], M=cap, PATH=shown)})
        if stopped:
            plan.notes.append({"code": "deadline-exceeded",
                               "message": TEXT["note_deadline_exceeded"].format(K=stopped, PATH=shown)})
    codes = plan_completeness(plan)
    plan.completeness = "incomplete" if codes else "complete"
    plan.apply_allowed = plan.mode != "report" and not codes and not plan.refusals
    plan.digest = plan_digest(plan)
    plan.planning_probes = run.probes
    plan.report = {"root": str(root), "target_branch": target and target["name"],
                   "tracking_freshness": TRACKING_FRESHNESS, "worktrees": plan.rows}
    return plan
# endregion plan

# region gates
# The twelve gates of FR-020 (T050; design D10, D12, D13, D21 and D22;
# data-model.md, "Gate"; lead rulings R-56 Q-6 and R-67 (a); Brett Heap's
# rulings LQ-13 and LQ-14). A row is selected only when it passes every gate,
# and an excluded row's reason is its first failing gate: 1 main-worktree, 2
# unsupported-path-bytes, 3 registration-mismatch (region index), 4
# locked-worktree, 5 the classification when it is not merged-removable, 6
# not-requested, 7 unstarted-branch or reflog-unavailable (region reflog), 8
# deferred-target-cap, 9 contains-submodule and 10 hidden-local-state (region
# index), 11 operation-in-progress, and 12 worktree-only-commits (region
# reflog), the last. Gates 1 to 7 are per-row functions, gate(row, plan, run)
# returning the reason or None, each free to set the row's `errors`, set its
# class to inspection-error or set its unprobed marker; gate 8 takes the rows
# that passed gates 1 to 7 together; gates 9 to 12 run only for the rows gate
# 8 takes. Every excluded row carries the reason its failing gate
# returned, never null (R-67 (a)).


def main_worktree_gate(row, plan, run):
    """Gate 1: `main-worktree` for the main worktree, which is never removed."""
    return "main-worktree" if row.main else None


def path_bytes_gate(row, plan, run):
    """Gate 2: `unsupported-path-bytes` for a path that is not valid UTF-8."""
    return None if row["path_valid_utf8"] else "unsupported-path-bytes"


def locked_gate(row, plan, run):
    """Gate 4: `locked-worktree` for a row whose registry record is locked."""
    return "locked-worktree" if row["locked"] else None


def class_gate(row, plan, run):
    """Gate 5: the row's classification when it is not `merged-removable`; a
    row whose evidence was not established is excluded here as
    `inspection-error`, and one whose registration was never read by its class
    (lead ruling R-53 P-16)."""
    classification = row["classification"]
    return None if classification == "merged-removable" else classification


def not_requested_gate(row, plan, run):
    """Gate 6: `not-requested` in mode single for a row other than P
    (plan.target), which has passed gates 1 to 5. Where P names no single row
    (plan.target None), every such row is not requested, so nothing is
    selected."""
    return "not-requested" if plan.mode == "single" and row is not plan.target else None


def row_gates():
    """The per-row gates 1 to 7 in FR-020's order, one tuple of functions,
    each gate(row, plan, run) returning its reason or None. The tuple is made
    when called, so that the bodies T066 and T067 give the stubs of regions
    reflog and index are the ones run."""
    return (main_worktree_gate, path_bytes_gate, registration_gate, locked_gate, class_gate,
            not_requested_gate, reflog_gate)


def deferral_gate(candidates, plan):
    """Gate 8, `deferred-target-cap` (T100; D12, FR-032): candidates
    are the rows that passed gates 1 to 7, in canonical order. Returns (taken,
    deferred): taken, the first LIMITS["targets"] (16) of them, which go on to
    the gates after it (9 to 12); deferred, the rest, which gate_rows() excludes
    as `deferred-target-cap` with no index probe. A row a gate after it then
    excludes keeps its place among the 16. It runs no child. In mode single
    the candidates are at most P, so the limit counts P alone (pcl:815-817);
    in a report the gates run as in any plan."""
    cap = LIMITS["targets"]
    return list(candidates[:cap]), list(candidates[cap:])


# The markers of an operation in progress (design D22; LQ-14, lead ruling
# R-126): an entry of any kind of one of these eleven names in a worktree's
# administrative directory, from Git's own state detection at 2.36.6 and
# 2.43.7, with MERGE_AUTOSTASH, NOTES_MERGE_PARTIAL and NOTES_MERGE_REF beside
# what `git status` reports. NOTES_MERGE_WORKTREE, which a notes merge's
# --abort and --commit leave behind, is none.
OPERATION_MARKERS = frozenset((
    b"MERGE_HEAD", b"CHERRY_PICK_HEAD", b"REVERT_HEAD", b"BISECT_LOG", b"BISECT_START", b"rebase-apply",
    b"rebase-merge", b"sequencer", b"MERGE_AUTOSTASH", b"NOTES_MERGE_PARTIAL", b"NOTES_MERGE_REF"))


def operation_check(common_dir, admin_id, run):
    """Gate 11's read for one row (design D22; LQ-14; lead rulings R-124 and
    R-126), shared with the revalidation (revalidation_difference()).

    Signature: operation_check(common_dir, admin_id, run) -> (result,
    row_error). common_dir is the repository's common directory and admin_id
    the row's admin directory name, both bytes; run is the Invocation in force,
    whose per-child budget bounds the call. One fs_call() listing of
    `<common_dir>/worktrees/<admin_id>` (through _fs(), OPERATION `listdir`),
    never a Git child:

    - a name of OPERATION_MARKERS among the entries: ("operation-in-progress",
      None), the one decided result that gives the reason;
    - none: (None, None), the gate passes;
    - any error on the listing: (None, its `os-error`);
    - the call cut at its budget: (None, a `probe-timeout` row error), or
      `deadline-exceeded` where the work deadline was the limit.

    A row error means the listing decided nothing (R-124)."""
    path = os.path.join(common_dir, b"worktrees", admin_id)
    try:
        names = _fs("listdir", os.listdir, path)
    except EvidenceError as exc:
        return None, exc.error
    return ("operation-in-progress" if OPERATION_MARKERS.intersection(names) else None), None


def admin_state_gates(row, plan, run):
    """Gates 11 and 12, `operation-in-progress` and `worktree-only-commits`
    (design D21 and D22; LQ-13 and LQ-14; lead ruling R-124), for a row that
    passed gates 1 to 10 only.

    Contract: admin_state_gates(row, plan, run) -> reason or None. Through
    operation_check(common_dir, admin_id, run), then, only where it passed,
    worktree_only_check(common_dir, admin_id, path, negatives, head, run), the
    negatives the non-zero objects of the row's branch reflog that gate 7 read
    (row.reflog_objects), and the common directory the plan's
    (plan.evidence["identity"]): `operation-in-progress` for a marker in the
    row's admin directory; `worktree-only-commits` for a commit that only its
    HEAD reflog or refs/worktree holds, or a logs/HEAD that cannot be decided;
    and `inspection-error`, after putting the check's row error in
    row["errors"] and setting row["classification"] to inspection-error
    (_index_undecided()), for a read or child that failed, timed out or met
    the deadline, so that the plan is incomplete with inspection-incomplete,
    or with deadline-exceeded where only the deadline cut it
    (plan_completeness()). The listing runs first, being one filesystem call
    and the earlier gate, so that a row with an operation in progress runs no
    child. A row whose admin directory or common directory is not established
    cannot be checked and is inspection-error, with no read made, as
    index_gates() makes it."""
    identity = plan.evidence["identity"] if plan.evidence else None
    common_dir = identity["common_dir"] if identity else None
    if common_dir is None or row.admin_id is None:
        return _index_undecided(row, None)
    reason, error = operation_check(common_dir, row.admin_id, run)
    if reason is None and error is None:
        reason, error = worktree_only_check(common_dir, row.admin_id, row.raw_path,
                                            getattr(row, "reflog_objects", None), row["head"], run)
    if error is not None:
        return _index_undecided(row, error)
    return reason


def first_failing_gate(row, gates, plan, run):
    """The reason of the first of gates that row fails, or None."""
    for gate in gates:
        reason = gate(row, plan, run)
        if reason is not None:
            return reason
    return None


def gate_rows(rows, plan, run):
    """The gates of FR-020 over rows, plan's rows in canonical order (data-model.md,
    "Gate"): gates 1 to 7 per row (row_gates()), then gate 8 over the rows that
    passed them (deferral_gate()), then gates 9 and 10 (index_gates()) and gates
    11 and 12 (admin_state_gates()) for the rows gate 8 took. Returns (selected, excluded): selected, the rows that
    passed every gate; excluded, (row, reason) pairs, reason the first failing
    gate's, never None (R-67 (a)); both by raw path bytes."""
    excluded, candidates = [], []
    for row in rows:
        reason = first_failing_gate(row, row_gates(), plan, run)
        if reason is None:
            candidates.append(row)
        else:
            excluded.append((row, reason))
    taken, deferred = deferral_gate(candidates, plan)
    excluded += [(row, "deferred-target-cap") for row in deferred]
    selected = []
    for row in taken:
        reason = index_gates(row, plan, run)
        if reason is None:
            reason = admin_state_gates(row, plan, run)
        if reason is None:
            selected.append(row)
        else:
            excluded.append((row, reason))
    selected.sort(key=lambda row: row.raw_path)
    excluded.sort(key=lambda item: item[0].raw_path)
    return selected, excluded


def next_step(reason):
    """D18's next step for an exclusion reason: NEXT_STEPS's, else the class's
    recommendation (RECOMMENDATIONS); None for a reason with neither."""
    return NEXT_STEPS.get(reason) or RECOMMENDATIONS.get(reason)


def target_refusal(row, reason):
    """The `target-excluded` refusal of P's row, excluded by reason (FR-013;
    design D18; lead rulings R-58 (a) and R-59 D9), its message in the
    baseline's precedence (project:715-718 at 961c405): the current worktree's
    when P is current, else the class's when P's class is not
    merged-removable, which keeps its wording and has no next step, else the
    gate's, `Worktree is excluded: REASON; NEXT STEP`."""
    if row.get("current"):
        message = TEXT["target_excluded_current"]
    elif row["classification"] != "merged-removable":
        message = TEXT["target_excluded_class"].format(CLASS=row["classification"])
    else:
        message = TEXT["target_excluded_gate"].format(REASON=reason, NEXT_STEP=next_step(reason) or "")
    return Refused(message, code="target-excluded", path=row.raw_path, reason=reason)
# endregion gates

# region reflog
# Gate 7 from the branch's reflog (T066; design D10; data-model.md, "Reflog
# anchor and movement"; FR-021, FR-022; lead rulings R-33, R-53 P-22, R-54 X-1,
# R-56 Q-6 and R-67 (a)). read_reflog() makes the one bounded filesystem call;
# reflog_outcome() decides from the bytes read and does no I/O. Gate 12,
# worktree-only-commits, from the row's own HEAD reflog (design D21; Brett
# Heap's ruling LQ-13; lead rulings R-124 and R-146): worktree_only_check()
# reads logs/HEAD by one bounded filesystem call and runs one rev-list child,
# whose negatives include the non-zero objects that the branch's reflog named
# when gate 7 read it (reflog_objects()).

# One reflog line: `<old> <new> <identity> <time> <zone>`, then a tab and the
# message when the command wrote one; `git update-ref` without -m writes neither
# (D10). The identity ends at its first `>`, as Git's own reader takes it.
REFLOG_LINE = re.compile(
    rb"(?P<old>[0-9a-f]{40}|[0-9a-f]{64}) (?P<new>[0-9a-f]{40}|[0-9a-f]{64}) "
    rb"[^\n]*?> [0-9]+ [+-][0-9]{4}(?:\t(?P<message>[^\n]*))?")
# The messages that anchor a reflog besides an all-zeros old object (D10):
# `worktree add -b`, `branch` and `checkout -b` write the first; `worktree add
# -B`, `branch -f` and `checkout -B` on an existing branch the second.
REFLOG_ANCHOR_MESSAGES = (b"branch: Created from", b"branch: Reset to")


def reflog_path(common_dir, branch):
    """The branch's reflog, logs/refs/heads/<branch> under common_dir, as
    bytes: common_dir the common directory's bytes, branch the row's short
    name, whose text encodes back to its bytes with surrogateescape; each `/`
    of the name is a directory level."""
    name = branch.encode("utf-8", "surrogateescape") if isinstance(branch, str) else branch
    return os.path.join(common_dir, b"logs", b"refs", b"heads") + b"/" + name


def _null_object(name):
    return not name.strip(b"0")


def reflog_outcome(data, head):
    """Gate 7's decision from the bytes a reflog read gave, a pure decider
    (lead ruling R-54 X-1; D10; data-model.md, "Reflog anchor and movement"):
    `reflog-unavailable`, `unstarted-branch`, or None when the gate passes.
    data is what the read returned, at most LIMITS["reflog_bytes"]; head the
    row's head, its object name as text or bytes, or None.

    Empty data, data that reached the 64 KiB bound (65,536 bytes read, R-33),
    a line that is not `<old> <new> ...` (a truncated last line, one with no
    line feed, included: lead ruling R-53 P-22), or a last entry whose new
    object is not the head: `reflog-unavailable`, since the entries cannot
    decide or do not describe the branch. Otherwise the anchor is the last
    entry whose old object is all zeros or whose message begins `branch:
    Created from` or `branch: Reset to`; a movement is an entry after the
    anchor, or any entry when none survives, whose old and new objects are
    non-zero and differ (a rename's are equal). A movement passes (None); an
    anchor with no movement after it, its new object the head, is
    `unstarted-branch`; anything else, no anchor and no movement included, is
    `reflog-unavailable`."""
    if isinstance(head, str):
        head = head.encode("utf-8", "surrogateescape")
    if (head is None or not data or len(data) >= LIMITS["reflog_bytes"]
            or not data.endswith(b"\n")):
        return "reflog-unavailable"
    entries = []
    for line in data[:-1].split(b"\n"):
        match = REFLOG_LINE.fullmatch(line)
        if match is None or not len(match["old"]) == len(match["new"]) == len(head):
            return "reflog-unavailable"
        entries.append((match["old"], match["new"], match["message"] or b""))
    if entries[-1][1] != head:
        return "reflog-unavailable"
    anchor = None
    for index, (old, new, message) in enumerate(entries):
        if _null_object(old) or message.startswith(REFLOG_ANCHOR_MESSAGES):
            anchor = index
    later = entries if anchor is None else entries[anchor + 1:]
    if any(not _null_object(old) and not _null_object(new) and old != new for old, new, _ in later):
        return None
    if anchor is not None and entries[anchor][1] == head:
        return "unstarted-branch"
    return "reflog-unavailable"


def reflog_objects(data, length=None):
    """The non-zero old and new objects that reflog bytes name, each once in
    first-seen order, as text, a pure function of the bytes (D10, D21): [] for
    no bytes, and None where the bytes cannot be decided, as reflog_outcome()
    reads them: read to the 64 KiB bound (65,536 bytes, R-33), ending without
    a line feed, or holding a line that is not `<old> <new> ...` with old and
    new of one length, and of length where given (a head's)."""
    if not data:
        return []
    if len(data) >= LIMITS["reflog_bytes"] or not data.endswith(b"\n"):
        return None
    named = {}
    for line in data[:-1].split(b"\n"):
        match = REFLOG_LINE.fullmatch(line)
        if match is None or len(match["old"]) != len(match["new"]) or (
                length is not None and len(match["old"]) != length):
            return None
        for name in (match["old"], match["new"]):
            if not _null_object(name):
                named.setdefault(name.decode("ascii"), None)
    return list(named)


def read_reflog(common_dir, branch, head, run, named=None):
    """Read the branch's reflog (reflog_path()) by one fs_call() of at most
    LIMITS["reflog_bytes"] (64 KiB) and decide gate 7 from it (D10, the
    project-clean delta's outcome rule; lead ruling R-56 Q-6): (reason, error),
    error a row error or None. The read asks for no more than 65,536 bytes and
    needs no fstat (R-33); it is never a Git child. ENOENT or ENOTDIR is
    (`reflog-unavailable`, None); any other OSError (`inspection-error`, its
    `os-error` for OPERATION read); a call cut at its budget or the deadline
    (`reflog-unavailable`, its `probe-timeout` or `deadline-exceeded`), which
    reflog_gate() leaves unprobed, or for the deadline makes
    inspection-error; and bytes read, (reflog_outcome(data, head),
    None). run is the invocation in force, whose per-child budget fs_call()
    gives the read and the timeout message names, as _fs() does; Interrupted
    passes up. named, when given, is a list that receives the non-zero
    objects the bytes read name (reflog_objects()), the negatives of gate 12
    (D21, LQ-13)."""
    path = reflog_path(common_dir, branch)
    budget, _ = current_invocation().child_budget("probe")
    try:
        data = fs_call(_read_head, path, LIMITS["reflog_bytes"])
    except OSError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return "reflog-unavailable", None
        return "inspection-error", os_error("read", exc)
    if isinstance(data, DriverOutcome):
        return "reflog-unavailable", probe_error(data, "read", budget)
    if named is not None:
        named.extend(reflog_objects(data, None if head is None else len(head)) or ())
    return reflog_outcome(data, head), None


def reflog_gate(row, plan, run):
    """Gate 7, `unstarted-branch` or `reflog-unavailable` (T066 fills; D10,
    FR-021, FR-022; lead rulings R-56 Q-6 and R-67 (a)).

    Contract: reflog_gate(row, plan, run) -> reason or None, for a row that
    passed gates 1 to 6, in every mode. It reads the common directory from the
    plan (plan.evidence["identity"]["common_dir"]) and the branch and head from
    the row, so that it can mark the row, and wraps
    read_reflog(common_dir, branch, head, run): one fs_call() read of
    logs/refs/heads/<branch> under the common directory, at most 64 KiB, never
    a Git child. It returns `unstarted-branch` when an anchor survives with no
    movement after it, its new object the head; `reflog-unavailable` where the
    reflog cannot decide it (missing, empty, read to its 64 KiB bound, entries
    that cannot decide, or a last entry whose new object is not the head);
    `inspection-error`, after putting an `os-error` in row["errors"] and
    setting row["classification"] to inspection-error, for any other read
    error; and None when a movement survives. A read not finished within the
    filesystem budget, the work deadline not being the limit, returns
    `reflog-unavailable` AND sets row.unprobed, the marker's only setter,
    which plan_completeness() reads as inspection-incomplete; its
    `probe-timeout` goes in row["errors"], as the delta records for every
    filesystem call cut at its budget. A read the work deadline cuts
    (read_cut()) is gate 11's: its `deadline-exceeded` goes in row["errors"]
    and the row is `inspection-error`, never unprobed (_index_undecided()),
    so that deadline_stopped() names it and the plan is incomplete with
    `deadline-exceeded`, whose refusal prints no repair remedy, as for every
    other read (Brett Heap's ruling "O-1: deadline-exceeded", lead ruling
    R-263, amending ratified 0050f3e pcl:606-608; writer E's O-1). The
    inspection-error row also takes that class's recommendation, as
    classify() pairs them. It sets row.reflog_objects, the non-zero objects
    the reflog names, which gate 12 and the revalidation take as negatives,
    as they were (D21, LQ-13); no document writes it."""
    common_dir = plan.evidence["identity"]["common_dir"]
    named = []
    reason, error = read_reflog(common_dir, row["branch"], row["head"], run, named)
    row.reflog_objects = tuple(named)
    if error is None:
        return reason
    if reason == "inspection-error" or read_cut(error):
        return _index_undecided(row, error)
    row["errors"].append(error)
    row.unprobed = True
    return reason


# The reachability probe of gate 12, after its `-C WORKTREE` (design D21).
REACHABILITY_PROBE = ("rev-list", "--max-count=1", "--glob=refs/worktree")


def worktree_only_check(common_dir, admin_id, path, negatives, head, run):
    """Gate 12's reads for one row (design D21; LQ-13; lead rulings R-124 and
    R-146), shared with the revalidation (revalidation_difference()).

    Signature: worktree_only_check(common_dir, admin_id, path, negatives, head,
    run) -> (result, row_error). common_dir and admin_id name the row's admin
    directory, path is its worktree, all bytes; negatives the non-zero objects
    its branch's reflog named (row.reflog_objects); head its head, whose length
    a line of logs/HEAD must have; run the Invocation that bounds and counts
    the child. First one fs_call() read of `<admin>/logs/HEAD` of at most
    LIMITS["reflog_bytes"] (through _fs(), OPERATION `read`), every non-zero
    object it names a candidate (reflog_objects()); then one Git child of kind
    `probe` in the worktree, `rev-list --max-count=1 --glob=refs/worktree
    <candidates> --not --branches --tags --remotes <negatives>`:

    - logs/HEAD read to its 64 KiB bound, or holding a line that does not
      parse: ("worktree-only-commits", None), with no child;
    - a missing (ENOENT or ENOTDIR) or empty logs/HEAD: no candidate, and the
      child still runs, for refs/worktree;
    - a child that exits 0 and prints anything: ("worktree-only-commits",
      None); one that prints nothing: (None, None), the gate passes;
    - any other error on the read, or the read cut at its budget or the
      deadline: (None, its row error);
    - a child that cannot start or exits nonzero, as on a missing object (128),
      or one stopped at its budget or the deadline: (None, its row error),
      `probe-failed`, `probe-timeout` or `deadline-exceeded`, OPERATION `git
      rev-list`.

    Only a decided result gives the reason (R-124). Interrupted passes."""
    log = os.path.join(common_dir, b"worktrees", admin_id, b"logs", b"HEAD")
    try:
        data = _fs("read", _read_head, log, LIMITS["reflog_bytes"])
    except EvidenceError as exc:
        if exc.errno not in (errno.ENOENT, errno.ENOTDIR):
            return None, exc.error
        data = b""
    candidates = reflog_objects(data, None if head is None else len(head))
    if candidates is None:
        return "worktree-only-commits", None
    args = [*REACHABILITY_PROBE, *candidates, "--not", "--branches", "--tags", "--remotes", *(negatives or ())]
    outcome, error = _git(run, path, args, "rev-list")
    if error is not None:
        return None, error
    return ("worktree-only-commits" if outcome.result else None), None
# endregion reflog

# region index
def registration_gate(row, plan, run):
    """Gate 3, `registration-mismatch` (T067 fills; D7, FR-055; lead ruling
    R-53 P-16).

    Contract: registration_gate(row, plan, run) -> "registration-mismatch" or
    None. It fails only when row.registered is False, the two-way
    registration read and found to disagree, a path two registry entries share
    included; a row whose registration was never read (registered None, a
    present: false row among them) passes, and gate 5 excludes it by its class.
    It runs no child and reads no file. Such a row is already
    inspection-error by its evidence (classify(): no status probe ran), so
    the gate changes nothing on it."""
    return "registration-mismatch" if row.registered is False else None


# The hidden-state probe of a worktree, after its `-C WORKTREE` (design D2 and
# D11; contracts/project-clean.md, "Git children", the hidden-state row).
HIDDEN_STATE_PROBE = ("ls-files", "-v", "--stage", "-z")


def modules_check(common_dir, admin_id, run):
    """Gate 9's admin-directory half for one target (T067; D12, FR-023; lead
    rulings R-53 P-21 and R-56 Q-6), shared with US4's revalidation (T084).

    Signature: modules_check(common_dir, admin_id, run) -> (result,
    row_error). common_dir is the repository's common directory and admin_id
    the target's admin directory name (WorktreeRow.admin_id), both bytes; run
    is the Invocation in force, whose per-child budget bounds the call. One
    fs_call() lstat of `<common_dir>/worktrees/<admin_id>/modules` (through
    _fs(), OPERATION `lstat`), never a Git child:

    - ENOENT or ENOTDIR, no entry: (None, None), the gate passes;
    - an entry of any type: ("contains-submodule", None);
    - any other error: (None, an `os-error` row error);
    - the call cut at its budget: (None, a `probe-timeout` row error), or
      `deadline-exceeded` where the work deadline was the limit.

    A row error means the check decided nothing; the caller makes the row
    inspection-error, since a null flag never passes."""
    path = os.path.join(common_dir, b"worktrees", admin_id, b"modules")
    try:
        _fs("lstat", os.lstat, path)
    except EvidenceError as exc:
        if exc.errno in (errno.ENOENT, errno.ENOTDIR):
            return None, None
        return None, exc.error
    return "contains-submodule", None


def hidden_state_probe(path, run):
    """Gates 9's index half and gate 10 for one target (T067; D2, D11, D12,
    FR-023; lead ruling R-56 Q-6), shared with US4's revalidation (T084).

    Signature: hidden_state_probe(path, run) -> (result, row_error). path is
    the target's worktree, the row's raw path bytes; run is the Invocation
    that bounds and counts the child. One Git child of kind `hidden`,
    git_argv("hidden", ["-C", path, "ls-files", "-v", "--stage", "-z"]): the
    two status pins, then the protocol pins, run through run_bounded() with
    HiddenStateParser, so that the index read is the worktree's own:

    - a gitlink (mode 160000), where the parser stops at its bound:
      ("contains-submodule", None);
    - else an entry flagged assume-unchanged (a lowercase tag) or
      skip-worktree (`S`): ("hidden-local-state", None);
    - else (None, None), the gates pass;
    - a child that failed, timed out or met the deadline: (None, its row
      error), `probe-failed`, `probe-timeout` or `deadline-exceeded` by T024's
      map as built (OUTCOME_ERRORS, probe_error()), OPERATION `git ls-files`.

    Interrupted passes, as from any probe."""
    outcome, error = _git(run, path, list(HIDDEN_STATE_PROBE), "ls-files", HiddenStateParser(), kind="hidden")
    if error is not None:
        return None, error
    if outcome.result["gitlink"]:
        return "contains-submodule", None
    if outcome.result["hidden"]:
        return "hidden-local-state", None
    return None, None


def index_gates(row, plan, run):
    """Gates 9 and 10, `contains-submodule` and `hidden-local-state` (T067
    fills; D12, FR-023; lead ruling R-56 Q-6).

    Contract: index_gates(row, plan, run) -> reason or None, for a row that
    passed gates 1 to 8 only. Through the per-target helpers T067 adds,
    modules_check(common_dir, admin_id, run) and hidden_state_probe(path, run),
    each (result, row_error): `contains-submodule` for a `modules` entry in the
    row's admin directory or a gitlink in its own index; `hidden-local-state`
    for an index entry flagged assume-unchanged or skip-worktree; and
    `inspection-error`, after putting the check's row error in row["errors"]
    and setting row["classification"] to inspection-error, for a check that
    failed, timed out or met the deadline, since a null flag never passes.

    The common directory is the plan's (plan.evidence["identity"]). The
    `modules` check runs first, being one filesystem call; the hidden-state
    probe runs only when it passed, so that the first check to fail or to be
    undecided names the row's reason. A row whose admin directory or common
    directory is not established cannot be checked and is inspection-error,
    with no read made: a defensive branch, since every row past gate 5 is a
    present linked worktree whose registration holds."""
    identity = plan.evidence["identity"] if plan.evidence else None
    common_dir = identity["common_dir"] if identity else None
    if common_dir is None or row.admin_id is None:
        return _index_undecided(row, None)
    reason, error = modules_check(common_dir, row.admin_id, run)
    if reason is None and error is None:
        reason, error = hidden_state_probe(row.raw_path, run)
    if error is not None:
        return _index_undecided(row, error)
    return reason


def _index_undecided(row, error):
    """Make row inspection-error for an index gate that decided nothing,
    error its row error (None when no read was made); return that reason."""
    if error is not None:
        row["errors"].append(error)
    row["classification"], row["recommendation"] = "inspection-error", RECOMMENDATIONS["inspection-error"]
    return "inspection-error"
# endregion index

# region preview
def print_plan(plan, run):
    """Print the plan as the run shows it (T052 fills; contracts/project-clean.md,
    "Streams" and "Human output"; lead ruling R-56 Q-3 and Q-11). The pipeline
    calls it once after check_plan()'s decision, with run.status the status
    the run stops at (None while it goes on), and once more where a removal
    run stops at the question (confirm_removal() returned 2). The human plan
    goes to run.human through say(), on the first call only (plan.printed);
    plain --json prints none, and push and delete-branch print nothing here,
    keeping their `Cleanup action:` output. Under --json the plan envelope goes
    to standard output through write_document() on the call where the run
    stops before the apply phase, so one document is written; not once a
    write has failed (run.write_error), since check_writes() then ends the
    run as `internal-error`, whose object is that one document (lead ruling
    R-101 (b), F1). The pipeline writes `REFUSED:` itself.

    What prints (T052; lead rulings R-56 Q-11, R-57 H1, R-59 D2 and D8, R-62
    (b) and R-67 (a)): a report, the baseline layout with each null shown as
    `unknown` (report_lines()); an --all-safe plan, and a single-mode plan for
    --action remove, D18's preview layout (preview_lines()); push and
    delete-branch, nothing. `Merge target: NAME (SOURCE)` prints in every
    mode, and every path and branch goes through human_path(). A row noted
    `partially-removed` (D4) also prints D18's partial-removal note beside its
    advice, never instead of it (T094; lead ruling R-79, P-11). It replaced the
    baseline's print_clean_report() for `clean`, which T125 then retired."""
    if plan.action in ("push", "delete-branch"):
        return
    json_output, apply = getattr(run.args, "json", False), getattr(run.args, "apply", False)
    if not plan.printed:
        plan.printed = True
        if apply or not json_output:
            for line in plan_lines(plan):
                say(run, line)
    if json_output and run.status is not None and getattr(run, "write_error", None) is None:
        write_document(plan_document(plan))


# The order of the Excluded groups (contracts/project-clean.md, "Human
# output"): the gates in FR-020's order, the classes of gate 5 in the ladder's
# order (RECOMMENDATIONS's), then the later gates; a reason not listed follows.
EXCLUDED_GROUP_ORDER = ("main-worktree", "unsupported-path-bytes", "registration-mismatch", "locked-worktree",
                        *RECOMMENDATIONS, "not-requested", "unstarted-branch", "reflog-unavailable",
                        "deferred-target-cap", "contains-submodule", "hidden-local-state", "operation-in-progress",
                        "worktree-only-commits")
# The reasons of the gates after deferred-target-cap, in gate order: those
# that exclude a row gate 8 took (D12; R-146, W21 L-f).
AFTER_CAP_REASONS = EXCLUDED_GROUP_ORDER[EXCLUDED_GROUP_ORDER.index("deferred-target-cap") + 1:]


def _shown(value):
    """A report value as the baseline prints it, null as `unknown`."""
    return "unknown" if value is None else str(value)


def plan_root(plan):
    """ROOT as the human plan names it: the identity's root, the main
    worktree's realpath, or plan.root where none is established."""
    identity = plan.evidence["identity"] if plan.evidence else None
    return identity["root"] if identity and identity["root"] is not None else os.fsencode(plan.root)


def plan_lines(plan):
    """The human plan, one string per line: the baseline header, `Cleanup plan
    for ROOT`, then `Merge target: NAME (SOURCE)` (`unknown` while none is
    established) and `Freshness:`, then the report's rows or the preview."""
    target = plan.merge_target
    lines = [f"Cleanup plan for {human_path(plan_root(plan))}",
             TEXT["merge_target_line"].format(NAME=human_path(target["name"]) if target else "unknown",
                                              SOURCE=target["source"] if target else "unknown"),
             f"Freshness: {TRACKING_FRESHNESS}"]
    return lines + (report_lines(plan) if plan.mode == "report" else preview_lines(plan))


def report_lines(plan):
    """The baseline report's rows (project:631-637 at 961c405), in canonical
    order: `CLASS: PATH [BRANCH] dirty=D; upstream=U; DELTA; merged=M`, then
    the recommendation; a null dirty, merge answer or count shown as
    `unknown`, and no upstream configured as `none`, as the baseline prints it.
    A row noted `partially-removed` (D4) prints D18's partial-removal note,
    its locked form for a locked row (W52 F-2, R-248), on
    its own line right after its recommendation, the `dirty` advice, and
    indented as that line is, its PATH in the command form, since the note
    names a command to paste (T094; lead rulings R-79, P-11, and R-83, P-2).
    First D14's two lines (T101; plan review M8): `Report: complete`, or
    `Report: incomplete (CODES)` with plan_completeness()'s codes in
    REFUSAL_CODES order joined by `, ` (lead ruling R-80, P-5); then
    `--all-safe would select N`, N the rows the gates select, or, above the
    --all-safe row cap, where `selected` is null, `--all-safe would be
    incomplete (inspect-cap)`."""
    codes = plan_completeness(plan)
    lines = [TEXT["completeness_line_incomplete"].format(CODES=", ".join(codes)) if codes
             else TEXT["completeness_line_complete"],
             TEXT["selection_line_above_cap"] if plan.selected is None
             else TEXT["selection_line"].format(N=len(plan.selected))]
    for row in plan.rows:
        upstream = human_path(row["upstream"]) if row.get("upstream") else "none"
        ahead, behind = row.get("ahead"), row.get("behind")
        delta = "unknown" if ahead is None or behind is None else f"ahead={ahead}, behind={behind}"
        lines.append(f"{row['classification'].upper()}: {human_path(row.raw_path)} [{human_path(row['branch'])}] "
                     f"dirty={_shown(row.get('dirty'))}; upstream={upstream}; {delta}; "
                     f"merged={_shown(row.get('merged_into_target'))}")
        lines.append(f"  {row['recommendation']}")
        if "partially-removed" in (row.get("notes") or ()):
            note = "partial_removal_note_locked" if row.get("locked") else "partial_removal_note"  # W52 F-2
            lines.append("  " + TEXT[note].format(PATH=human_path(row.raw_path, command=True)))
    return lines


def ignored_suffix(row):
    """D18's `: N ignored; first: SAMPLE` of an ignored-local-files row,
    `at least N` when the probe stopped at its bound; empty with no sample."""
    samples = row.status["ignored_samples"] if row.status else [
        os.fsencode(sample["path"]) for sample in row.get("ignored_samples") or ()]
    if not samples or row.get("ignored_files") is None:
        return ""
    key = "ignored_suffix_truncated" if row.get("ignored_files_truncated") else "ignored_suffix"
    return TEXT[key].format(N=row["ignored_files"], SAMPLE=human_path(samples[0]))


def preview_lines(plan):
    """D18's preview layout (design.md D18; contracts/project-clean.md, "Human
    output"): `Selected (N):` and one `  remove PATH [BRANCH]` per selected row;
    `Excluded (M):` and, per reason in EXCLUDED_GROUP_ORDER, `  REASON (K):
    NEXT STEP` (next_step()) over one `    PATH [BRANCH]` per row, an
    ignored-local-files row adding its count and first sample, and a row
    noted `partially-removed` (D4), a dirty one, followed by D18's
    partial-removal note, its locked form for a locked row (W52 F-2, R-248),
    six spaces in, its PATH in the command form (T094;
    lead rulings R-79, P-11, and R-83, P-2); the `deferred-target-cap`
    group headed by D18's deferral line in place of the generic one, its K
    the deferred rows and its ROOT plan_root() in the command form (T100;
    D12, FR-032), and, right under it, the non-drain line when all 16 rows
    gate 8 took are excluded by a gate after it (AFTER_CAP_REASONS), so that
    running again would defer the same rows, naming their reasons, each once,
    in gate order, joined by ", " (design D12 and D18 as R-146, W21 L-f, amends
    them; it reads as before when all 16 are `contains-submodule`), and no
    line otherwise, since the deferral line still says to run again (lead
    ruling R-80, P-6);
    `No eligible worktrees` when a complete --all-safe plan that carries no refusal selects
    nothing; and the residual-window line when anything is selected. Rows go
    in raw path byte order. In mode single, P is the one selected row and the
    other eligible rows form the `not-requested` group."""
    lines = []
    selected = plan.selected or []
    if selected:
        lines.append(TEXT["selected_heading"].format(N=len(selected)))
        lines += [TEXT["selected_row"].format(PATH=human_path(row.raw_path), BRANCH=human_path(row["branch"]))
                  for row in selected]
    if plan.excluded:
        groups = {}
        for row, reason in plan.excluded:
            groups.setdefault(reason, []).append(row)
        order = [reason for reason in EXCLUDED_GROUP_ORDER if reason in groups]
        order += [reason for reason in groups if reason not in EXCLUDED_GROUP_ORDER]
        lines.append(TEXT["excluded_heading"].format(M=len(plan.excluded)))
        for reason in order:
            rows = groups[reason]
            if reason == "deferred-target-cap":
                lines.append(TEXT["deferral_line"].format(K=len(rows), ROOT=human_path(plan_root(plan), command=True)))
                ahead = [reason for reason in AFTER_CAP_REASONS if reason in groups]
                if sum(len(groups[reason]) for reason in ahead) == LIMITS["targets"]:
                    lines.append(TEXT["non_drain_line"].format(REASONS=", ".join(ahead)))
            else:
                lines.append(TEXT["excluded_group"].format(REASON=reason, K=len(rows),
                                                           NEXT_STEP=next_step(reason) or ""))
            for row in rows:
                suffix = ignored_suffix(row) if reason == "ignored-local-files" else ""
                lines.append(TEXT["excluded_row"].format(PATH=human_path(row.raw_path),
                                                         BRANCH=human_path(row["branch"])) + suffix)
                if "partially-removed" in (row.get("notes") or ()):
                    note = "partial_removal_note_locked" if row.get("locked") else "partial_removal_note"  # F-2
                    lines.append("      " + TEXT[note].format(PATH=human_path(row.raw_path, command=True)))
    if plan.mode == "all-safe" and not selected and plan.completeness == "complete" and not plan.refusals:
        lines.append(TEXT["empty_line"])
    if selected:
        lines.append(TEXT["residual_window_line"])
    return lines
# endregion preview

# region apply
def confirm_removal(plan, run):
    """Accept the plan for removal (T054; FR-026; research.md R3; lead ruling
    R-56 Q-3): --yes accepts the fresh plan without asking; otherwise
    ask_removal(), looked up by its global name since T046 patches it there,
    asks D18's question under raising_signals(), swapped in around the
    question alone, with the clock paused, and only `yes`, its surrounding
    whitespace stripped, accepts. Returns None when the plan is accepted. Any
    other answer records `cancelled`, with the baseline's message, through
    refuse() and returns 2, never raising. End of input and a signal at the
    question pass to main() (EOFError, KeyboardInterrupt, Terminated). The
    pipeline then reads the slot, sets phase `apply` and calls
    apply_removals()."""
    if getattr(run.args, "yes", False):
        return None
    if ask_removal(plan, run).strip() == "yes":
        return None
    return refuse(plan, Refused("Cancelled; no command was run.", code="cancelled"), run)


def ask_removal(plan, run):
    """The removal question (T054; FR-026, design D18; research.md R3): write
    D18's question for the plan's selected targets, `question_one` for one, to
    the human stream (run.human, standard error under --apply --json) through
    say(), which flushes it; then read one line by input() given no prompt, so
    that standard output never carries the question; and return that line as
    read, which confirm_removal() strips and compares with `yes`.

    The question alone runs under raising_signals() (D1, D15; research.md R4)
    with the Invocation's clock paused (run.pause(), FR-031): SIGINT raises
    KeyboardInterrupt and SIGTERM or SIGHUP Terminated, and end of input
    raises EOFError, each passing to main(), which prints `Cancelled.` and
    exits 130, 143 or 129, with no JSON document. A question that could not be
    written (say() recorded the failed write) is not answered: nothing is read
    and "" is returned, so the plan is not accepted, and the pipeline's check
    after the question ends the run as `internal-error` (lead ruling R-55).
    An answer that standard input cannot decode, such as the byte 0xE9 read
    by a strict UTF-8 decoder, is returned as "", so that confirm_removal()
    records `cancelled`, as for any other answer that is not `yes` (lead
    ruling R-101 (c); plan review F1). confirm_removal() looks this function
    up by its global name, so a test patches it there (T046; lead ruling
    R-56)."""
    count = len(plan.selected)
    question = TEXT["question_one"] if count == 1 else TEXT["question"].format(N=count)
    run.pause()
    try:
        with raising_signals():
            say(run, question)
            if getattr(run, "write_error", None) is not None:
                return ""
            try:
                return input()
            except UnicodeDecodeError:
                return ""
    finally:
        run.resume()


class Target(dict):
    """One selected target of the apply phase (data-model.md, "Target result
    and reconciliation record"): as a dict, the target result's values in
    TARGET_RESULT_KEYS's order as project keeps them, `path_valid_utf8` aside,
    which result_document() derives: `path`, the registry's raw path bytes;
    `branch` and `planned_sha`, the planned row's branch and head; `stage`,
    `pending` until it is final, and its `reason`; `notes`, codes; `command`,
    the planned argument vector, git_argv("removal", removal_args), held
    whether or not anything ran; `exit_status`; `probes_performed`; and
    `reconciliation`, the record, or None while none was read. As attributes,
    what no document writes: `row`, the plan's selected WorktreeRow;
    `removal_args`, its removal's arguments (region dispatcher, Plan); `root`,
    the command directory; `identity`, the plan's repository identity
    {root, common_dir, dev, ino}, which the rescan re-establishes first; and
    `git_file_present`, whether the rescan found the target's `.git` present
    (git_file_presence()), None where it did not read it or the read gave no
    value, which only the human partial-removal note reads
    (partial_removal_text(); lane 3's W52 F-1, lead ruling R-263)."""

    row = removal_args = root = identity = git_file_present = None


def make_target(plan, row):
    """The pending Target of row, one of plan.selected (T056; design D9): its
    command is the plan's own argument vector, git_argv("removal",
    row.removal_args), the vector operation.argv shows (lead ruling R-56)."""
    target = Target(path=row.raw_path, branch=row["branch"], planned_sha=row["head"], stage="pending",
                    reason=None, notes=[], command=git_argv("removal", row.removal_args), exit_status=None,
                    probes_performed=0, reconciliation=None)
    target.row, target.removal_args, target.root = row, list(row.removal_args), plan.root
    target.identity = None if plan.evidence is None else plan.evidence["identity"]
    return target


# The repository identity's fields, compared at every revalidation and first
# in every rescan (design D7; data-model.md, "Repository identity").
IDENTITY_FIELDS = ("root", "common_dir", "dev", "ino")
ORIGIN_REFS = b"refs/remotes/origin/"
ORIGIN_HEAD_REF = ORIGIN_REFS + b"HEAD"
# A manifest that could not be re-read: never equal to any planned value.
UNREADABLE = object()


def reconciliation_record(registry_entry_present, path_present, branch_present, branch_sha):
    """A reconciliation record in RECONCILIATION_KEYS's order (data-model.md,
    "Target result and reconciliation record"): each value true, false or
    null, null meaning not established; `reconciled` is true only when the
    three presence fields are non-null and `branch_sha` is non-null whenever
    `branch_present` is true. A pure function."""
    reconciled = (None not in (registry_entry_present, path_present, branch_present)
                  and (branch_sha is not None or not branch_present))
    return {"registry_entry_present": registry_entry_present, "path_present": path_present,
            "branch_present": branch_present, "branch_sha": branch_sha, "reconciled": reconciled}


class UnfinishedRescan(dict):
    """The reconciliation record of a rescan one of whose reads failed or was
    cut: the identity probe, while the planned root and common directory were
    still there by lstat, the registry listing, the ref listing or the lstat
    of the planned path (lead ruling R-78 (e), second amendment). As a dict
    it compares, and is written, exactly as the plain record; only its class
    tells decide_stage() that the rescan was unfinished
    (`reconciliation-incomplete`), where an unmarked record whose reads all
    gave a value shows the removal not done, or the identity found lost or
    another one (`unconfirmed-removal`). target_document() copies its keys
    into a plain dict, so no document carries the class."""


def path_presence(raw, budget=None):
    """Whether the planned path is present, by one lstat through fs_call()
    (design D6; data-model.md, "Target result and reconciliation record"):
    true when it succeeds, false only on ENOENT or ENOTDIR, and null on any
    other error or when the call is cut at its budget, the per-child budget
    unless budget is given (reserve_budget())."""
    try:
        found = fs_call(os.lstat, raw, budget=budget)
    except OSError as exc:
        found = exc
    if isinstance(found, DriverOutcome):
        return None
    return presence_from_lstat(found)[0]


def git_file_presence(raw):
    """Whether the `.git` of the worktree at raw, the registry's path bytes,
    is present (lane 3's W52 F-1; Brett Heap's ruling "F-1:
    prune-then-delete", lead ruling R-263): one lstat of raw/.git through
    path_presence(), at the per-child budget, never a Git child. True when
    it succeeds, false on ENOENT or ENOTDIR, and None on any other error, a
    call cut at its budget, or a second SIGINT, which abandons the call
    (Interrupted does not pass, as it never leaves the rescan)."""
    try:
        return path_presence(os.path.join(os.fsencode(raw), b".git"))
    except Interrupted:
        return None


def reserve_budget(run):
    """The budget of the one lstat that records a refused target's planned
    path after its revalidation stopped before its own (revalidate(); lead
    ruling R-101 (d); apply review F3): min(probe budget, reserve remaining),
    as child_budget() gives a read while reconciling, never below 0, so that
    a difference found as the work deadline passes still records the path's
    presence; None, the per-child budget, without a deadline. Read at call
    time (lead ruling R-29)."""
    left = run.reserve_remaining()
    if left is None:
        return None
    return max(0.0, min(TIMING["probe_budget"], left))


def _branch_ref(target):
    return b"refs/heads/" + target["branch"].encode("utf-8", "surrogateescape")


def _branch_evidence(target, refs):
    """(branch_present, branch_sha) of target's branch in refs, RefParser's
    records, or (None, None) when the listing did not run or failed."""
    if refs is None:
        return None, None
    for ref in refs:
        if ref["refname"] == _branch_ref(target):
            return True, ref["objectname"]
    return False, None


def _row_ref(row):
    """The full refname of a selected row's branch, as bytes."""
    return b"refs/heads/" + row["branch"].encode("utf-8", "surrogateescape")


def narrowed_ref_patterns(plan, declared=None):
    """The patterns of revalidation's one ref listing (T084; design D7;
    BA:686-693 at da33d92; contracts/project-clean.md, "Git children", the
    narrowed ref listing), full refnames as bytes, each once, in this order:
    under refs/heads/, the merge target, the manifest's candidate less a
    leading `origin/` (the plan's, and declared, the fresh read's, when it
    differs), the branch the plan's `origin/HEAD` named, `main` and `master`;
    then refs/remotes/origin/HEAD; then each selected branch and the
    upstream refname row 6 gave it when the plan was built, a deleted one
    included. `for-each-ref` matches a pattern literally, as a whole refname
    or a leading part up to a slash, and a ref name holds no glob character,
    so the listing holds at least these refs. A pure function of the plan."""
    evidence = plan.evidence or {}
    planned = {ref["refname"]: ref for ref in evidence.get("refs") or ()}
    names = [plan.merge_target["name"].encode("utf-8", "surrogateescape")] if plan.merge_target else []
    for value in (evidence.get("declared"), declared):
        if isinstance(value, str):
            names.append(value.removeprefix("origin/").encode("utf-8", "surrogateescape"))
    origin_head = planned.get(ORIGIN_HEAD_REF)
    if origin_head is not None and (origin_head["symref"] or b"").startswith(ORIGIN_REFS):
        names.append(origin_head["symref"][len(ORIGIN_REFS):])
    patterns = [b"refs/heads/" + name for name in (*names, b"main", b"master")] + [ORIGIN_HEAD_REF]
    for row in plan.selected or ():
        patterns.append(_row_ref(row))
        upstream = (planned.get(_row_ref(row)) or {}).get("upstream")
        if upstream:
            patterns.append(upstream)
    return list(dict.fromkeys(patterns))


def repository_identity(root, run, errors=None):
    """The repository identity at root, the command directory (design D7):
    the identity probe (row 3, one Git child, or one per option where its
    output needs it), then the realpaths of the toplevel and the common
    directory and the lstat of that directory, by filesystem calls. Returns
    {root, common_dir, dev, ino, superproject}, or None when the probe failed
    or a call gave no value. errors, when given, is a list that receives the
    row error of the probe where it gave no value, and of a filesystem call
    that failed other than with ENOENT or ENOTDIR, or was cut at its budget,
    so that a caller can tell a read that decided nothing from an identity
    read, an absent path included (the lead's R-195 and R-208)."""
    values, error = identity_probe(root, run)
    if error is not None:
        if errors is not None:
            errors.append(error)
        return None
    try:
        common_dir = _realpath(values[1])
        found = _fs("lstat", os.lstat, common_dir)
        toplevel = _realpath(values[0])
    except EvidenceError as exc:
        if errors is not None and exc.errno not in (errno.ENOENT, errno.ENOTDIR):
            errors.append(exc.error)
        return None
    return {"root": toplevel, "common_dir": common_dir, "dev": found.st_dev, "ino": found.st_ino,
            "superproject": values[2]}


def same_repository(found, planned):
    """Whether found, repository_identity()'s value, is the planned identity:
    every one of IDENTITY_FIELDS equal, and no superproject."""
    return (found is not None and planned is not None and found["superproject"] is None
            and all(found[key] == planned[key] for key in IDENTITY_FIELDS))


def reread_manifest(root):
    """The manifest's raw `tracking_branch` at root, re-read as the plan read
    it (declared_tracking_branch(), one bounded filesystem call), or
    UNREADABLE when it refuses: unparseable, over 1 MiB, a wrong kind or a
    read cut at its budget."""
    try:
        return declared_tracking_branch(root)
    except Refused:
        return UNREADABLE


def as_candidate(declared):
    """A manifest's raw `tracking_branch` as resolve_merge_target() reads it:
    the string as written, or None for any other value, which names no
    candidate, YAML's `.nan` among them (lead ruling R-101 (d); apply review
    F2). Revalidation compares the plan's and the fresh value through it, so
    that a value planning ignored is no difference, while a string is still
    compared as written (lead ruling R-77). A pure function."""
    return declared if isinstance(declared, str) else None


def _listing(run, root, args, subcommand, parser):
    """One read-only Git child at root through _git(): its parser's result,
    or None when it failed, timed out or met the deadline."""
    outcome, error = _git(run, root, args, subcommand, parser)
    return None if error is not None else outcome.result


def _upstream_evidence(ref, refs):
    """(upstream, remote_present, ahead, behind, upstream_oid) of a branch's
    record in refs, a {refname: record} map, as row_evidence() derives them
    from row 6, so that a null in the plan and a null again compare equal."""
    if ref["upstream_short"] is None:
        return None, None, None, None, None
    tracked = refs.get(ref["upstream"])
    oid = tracked["objectname"] if ref["remote_present"] and tracked else None
    return _evidence_text(ref["upstream_short"]), ref["remote_present"], ref["ahead"], ref["behind"], oid


def _same_merge_target(plan, refs, declared, patterns):
    """Whether the merge target re-resolved over refs, the fresh listing, with
    declared, the fresh manifest value, is the plan's {name, source, sha}; and,
    where the listing was narrowed to patterns, whether an `origin/HEAD` that
    names a branch outside it is ruled out, since the listing cannot show that
    branch's existence (BA:690-693 at da33d92; lead ruling R-77 (c))."""
    if plan.merge_target is None:
        return False
    try:
        fresh = resolve_merge_target(refs, declared)
    except Refused:
        return False
    if any(fresh[key] != plan.merge_target[key] for key in MERGE_TARGET_KEYS):
        return False
    if patterns is not None:
        for ref in refs:
            symref = ref["symref"] or b""
            if (ref["refname"] == ORIGIN_HEAD_REF and symref.startswith(ORIGIN_REFS)
                    and b"refs/heads/" + symref[len(ORIGIN_REFS):] not in patterns):
                return False
    return True


def take_rescan_part(plan, target, run):
    """The repository part a rescan left on run for this target (T085), or
    None: the identity, the manifest value, the registry listing and the ref
    listing of the rescan that followed the previous selected target's
    removal, taken once, and only when that target is the selected row just
    before this one in this run, which then ended a plain `removed` (lead
    ruling R-77 (b)). Any part left is dropped."""
    part = getattr(run, "rescan_part", None)
    run.rescan_part = None
    selected = list(plan.selected or ())
    index = next((at for at, row in enumerate(selected) if row is target.row), None)
    if part is None or not index or part["after"] is not selected[index - 1]:
        return None
    return part


def read_cut(error):
    """Whether error, a read's row error or None, says the work deadline cut
    the read: code `deadline-exceeded` (T099; lead ruling R-80, P-2)."""
    return error is not None and error["code"] == "deadline-exceeded"


def work_spent(run):
    """Whether the work deadline has passed: no work time is left (T099)."""
    left = run.work_remaining()
    return left is not None and left <= 0


def slot_set(run):
    """Whether the signal slot holds a signal, read by revalidation_difference()
    before each read it starts, its Git children and its filesystem steps
    alike (lead ruling R-93 (e), LOW-1; design D15; the project-clean delta's
    "stop scheduling, so that no further probe or removal starts",
    pcl:931-933). In phase `apply` the driver stops no child
    (Invocation.interrupting()), so the revalidation reads the slot itself,
    and a set slot ends it as the seam before the spawn would: `interrupted`."""
    return run.signal is not None


def below_removal_floor(run):
    """Whether less than the removal floor of work time is left, read now
    (T099, FR-030; design D9; the project-clean delta's "a removal child SHALL
    be spawned only while at least the 5 s removal floor of the work deadline
    remains"): TIMING["removal_floor"], read at call time (lead ruling R-29).
    False without a deadline (an Invocation of another command)."""
    left = run.work_remaining()
    return left is not None and left < TIMING["removal_floor"]


def _absence_error(error, operation):
    """Whether error, a row error, is the `os-error` that operation gives for
    ENOENT or ENOTDIR: the path or a parent of it gone, which is absence and
    not a failed read (lead rulings R-36 and R-93 (a))."""
    return any(error == os_error(operation, OSError(number, os.strerror(number)))
               for number in (errno.ENOENT, errno.ENOTDIR))


def registry_twin(evidence, records, rows, common_dir, unread=frozenset()):
    """A twin made after planning, the step 5 check of revalidation_difference()
    (lead ruling R-81 (a); R-67 (c)): each entry of records, the fresh registry
    listing, read as worktree_rows() reads a row (_read_row(): its lstat, its
    realpath and its two-way registration), with the entries worktree_rows()
    builds no row for skipped, then compared by shared_identities().
    Returns `identity-changed` when a present entry shares a checked row's
    realpath or admin id, since two spellings of one worktree both pass the
    two-way check; `state-changed` when an entry's lstat or realpath decided
    nothing (the lead's R-208); `deadline-exceeded` when the work deadline cut
    one of these reads (R-80, P-2), so that no twin goes unread for want of
    time; else None. Every entry is read, a row past the cap included, since the cap
    bounds planning's rows and not this comparison. rows are the checked
    rows; common_dir the planned common directory; unread the raw paths of
    the plan's rows whose lstat failed while planning (`present: null`).

    An entry whose lstat or realpath fails other than with ENOENT or ENOTDIR,
    a call cut at its probe budget included, gives `state-changed` at once
    (R-208): a twin could stand behind it, and a value that cannot be re-read
    is a difference (the project-clean-review-safety delta, rs:92-93; lead
    ruling R-93 (e), LOW-3). Planning fails closed on such an entry too:
    --all-safe makes its row `inspection-error`, and in single mode a
    realpath that raises leaves P's match undecided (R-78 (b)). One entry is
    no difference: a row of unread whose lstat fails again, null in the plan
    and null again (rs:89-92), which in single mode the plan recorded as
    another row's non-blocking `inspection-error`, and which therefore does
    not refuse P (the project-clean delta, pcl:258-262). An entry the plan
    never read, new since planning or left past the row cap, is not one of
    them. An entry whose lstat or realpath gives ENOENT or ENOTDIR is absent
    and compared by neither (R-36), and one whose registration alone cannot
    be read is compared by its realpath alone (R-57 L2)."""
    own = {row.raw_path for row in rows}
    identity = evidence.get("identity") or {}
    reads, checked = [], set()
    for index, record in enumerate(records):
        raw = record["path"]
        if index == 0 and record["bare"]:
            continue
        if index == 0 and evidence.get("first_is_common_dir"):
            raw = identity.get("root")
            if raw is None:
                continue
        read = _read_row(raw, index == 0, common_dir, None, None, False)
        if any(read_cut(error) for error in read["errors"]):
            return "deadline-exceeded"
        lstat_failed = read["present"] is None and raw not in unread
        realpath_failed = (read["present"] is True and read["tree"] is None
                           and not _absence_error(read["errors"][-1], "realpath"))
        if lstat_failed or realpath_failed:
            return "state-changed"  # a read that decided nothing (R-208)
        if raw in own:
            checked.add(len(reads))
        reads.append(read)
    return "identity-changed" if checked & shared_identities(reads) else None


def revalidation_difference(plan, target, run, part, seen):
    """The first difference of target's revalidation, its reason, or None
    (T084; design D7; the project-clean-review-safety delta, rs:66-96;
    data-model.md, "Revalidation step and probes_performed"). Steps 1 to 4
    come from part, the previous target's rescan, when there is one (T085),
    and are read here otherwise. seen receives what the steps read for the
    reconciliation: the registry listing, the ref listing, and the target's
    own lstat.

    1. The repository identity at the command directory equals the plan's,
       else `identity-changed`; an identity probe that decided nothing is
       `state-changed` (the lead's R-195).
    2. The manifest's `tracking_branch`, re-read, equals the plan's as
       written, its absence included (lead ruling R-77), and a value that
       is not a string read as none, as planning reads it (as_candidate();
       lead ruling R-101 (d)), else `state-changed`.
    3. The registry listing names each checked row's path once, else
       `identity-changed`, with its `locked` as planned, else
       `state-changed`; a listing that decided nothing is `state-changed`
       (R-195).
    4. The narrowed ref listing (narrowed_ref_patterns()): each checked
       row's registry branch and head and its branch's tip as planned, else
       `branch-changed`; its upstream, `remote_present`, `ahead`, `behind` and
       upstream object as planned, else `state-changed`; then the merge
       target re-resolved as planned, else `state-changed`.
    5. By filesystem reads, each checked row's path present with its planned
       `dev` and `ino`, and its two-way registration holding with its planned
       `admin_id` (verify_registration()), else `identity-changed`; then no
       other present entry of the registry listing sharing a checked row's
       realpath or admin id, a twin made after planning (registry_twin();
       lead ruling R-81 (a)), and no entry whose lstat or realpath cannot
       be read, unless the plan read its lstat as failed too (lead ruling
       R-93 (e), LOW-3), else `identity-changed`; then the target's
       `modules` check, else `contains-submodule`; then the listing of its
       admin directory (operation_check(); D22, LQ-14), else
       `operation-in-progress` for a marker it finds; then, where the plan's
       row 4c read true, the target's effective work tree
       (effective_work_tree(), strict), `identity-changed` only for a decided
       other toplevel and `state-changed` for a probe that decided nothing
       (the lead's R-171). The filesystem checks come before that probe, in
       the review-safety delta's order (the lead's R-198), so that one of
       them that refuses spares its child.
    6. The combined status probe in the target, which must print no record,
       else `state-changed`.
    7. The hidden-state probe in the target: its own reason
       (`contains-submodule` or `hidden-local-state`).
    8. Gate 12's check in the target (worktree_only_check(); D21, LQ-13):
       logs/HEAD read again and the reachability probe run again, with the
       non-zero objects that the plan's branch reflog named taken as they
       were (row.reflog_objects), else `worktree-only-commits`.

    The checked rows are the target's own, or for the first selected target
    every selected row: its revalidation is the preflight of every selected
    target in steps 3 and 4 and in step 5's identity reads and twin check,
    so that a difference there on any of them refuses the first target and
    nothing is removed (research.md R16, lead ruling R-41, LQ-4). Step 5's
    `modules` check, admin directory listing and effective-work-tree probe,
    and steps 6 to 8, the ignored-file state, the classification and the
    worktree-only commits among them, read the target alone, in each
    target's own revalidation (lane 3's W32 L2). A value null in the
    plan and null again is no difference; a value that cannot be re-read is
    one. Every Git child of these steps that fails, or runs past its own
    budget while the deadline is not the limit, is `state-changed`, whatever
    its step, and gives its step's own reason only for a value it decided
    (the lead's R-171 and R-195; #19 at 4485678): the identity probe, the
    registry listing, the ref listing, the work-tree probe, the status
    probe, the hidden-state probe and the reachability probe; and so is
    every filesystem call of these steps that fails other than with ENOENT
    or ENOTDIR, or runs past its own budget (the lead's R-208; #19 at
    9267303): step 1's identity reads, step 5's lstat, registration reads,
    twin reads, `modules` check, admin directory listing and read of
    logs/HEAD. ENOENT or ENOTDIR decides that the path is absent, which
    keeps the step's reason: an absent target, `.git` or admin directory is
    `identity-changed`. A `timeout` stays such a difference (T084).

    A read the work deadline cut gives `deadline-exceeded` instead, never a
    difference (T099; lead ruling R-80, P-2): its row error's code says so,
    and for steps 1 and 2, read through repository_identity() and
    reread_manifest(), which keep no code, an unread value with no work time
    left (work_spent()).

    The signal slot is read before each read a step starts (slot_set()): the
    Git children of steps 1, 3, 4, 6, 7 and 8, the manifest re-read, and
    step 5's identity reads, twin reads, `modules` check and admin listing. A signal recorded
    gives `interrupted`, never a difference, and no later read starts (lead
    ruling R-93 (e), LOW-1; pcl:931-933). A step whose values come from part
    starts no read. A step that has already read is decided first, so a
    difference it found stands."""
    evidence = plan.evidence or {}
    planned = evidence.get("identity")
    root = os.fsencode(target.root)
    selected = list(plan.selected or ())
    rows = selected if selected and target.row is selected[0] else [target.row]

    if not part and slot_set(run):
        return "interrupted"
    read_errors = []
    found = part["identity"] if part else repository_identity(root, run, read_errors)
    if found is None and not part and (work_spent(run) or any(map(read_cut, read_errors))):
        return "deadline-exceeded"
    if found is None and read_errors:
        return "state-changed"  # an identity probe or read that decided nothing (R-195, R-208)
    if not same_repository(found, planned):
        return "identity-changed"

    if not part and slot_set(run):
        return "interrupted"
    declared = part["declared"] if part else reread_manifest(root)
    if declared is UNREADABLE and not part and work_spent(run):
        return "deadline-exceeded"
    expected = evidence.get("declared", UNREADABLE)
    if declared is UNREADABLE or expected is UNREADABLE or as_candidate(declared) != as_candidate(expected):
        return "state-changed"

    if part:
        records = part["records"]
    elif slot_set(run):
        return "interrupted"
    else:
        outcome, error = _git(run, root, ["worktree", "list", "--porcelain", "-z"], "worktree list",
                              WorktreeListParser())
        if read_cut(error):
            return "deadline-exceeded"
        records = None if error is not None else outcome.result
    seen["records"] = records
    if records is None:
        return "state-changed"  # a registry listing that decided nothing (R-195)
    entries = []
    for row in rows:
        matches = [record for record in records if record["path"] == row.raw_path]
        if len(matches) != 1:
            return "identity-changed"
        if matches[0]["locked"] != row["locked"]:
            return "state-changed"
        entries.append((row, matches[0]))

    if part:
        refs, patterns = part["refs"], None
    elif slot_set(run):
        return "interrupted"
    else:
        patterns = narrowed_ref_patterns(plan, declared)
        outcome, error = _git(run, root, ["for-each-ref", "--format=" + REF_FORMAT, *patterns], "for-each-ref",
                              RefParser())
        if read_cut(error):
            return "deadline-exceeded"
        refs = None if error is not None else outcome.result
    seen["refs"] = refs
    if refs is None:
        return "state-changed"
    by_name = {ref["refname"]: ref for ref in refs}
    for row, entry in entries:
        ref = by_name.get(_row_ref(row))
        if (entry["branch"] != _row_ref(row) or entry["head"] != row["head"] or ref is None
                or ref["objectname"] != row["head"]):
            return "branch-changed"
    for row, _ in entries:
        if _upstream_evidence(by_name[_row_ref(row)], by_name) != (
                row["upstream"], row["remote_present"], row["ahead"], row["behind"], row.upstream_oid):
            return "state-changed"
    if not _same_merge_target(plan, refs, declared, patterns):
        return "state-changed"

    if slot_set(run):
        return "interrupted"
    common_dir = planned["common_dir"]
    for row in rows:
        result = _lstat(row.raw_path)
        present = presence_from_lstat(result)[0]
        if row is target.row:
            seen["path_present"] = present
        if isinstance(result, EvidenceError) and read_cut(result.error):
            return "deadline-exceeded"
        if present is None:
            return "state-changed"  # an lstat that decided nothing (R-208)
        if not present or (result.st_dev, result.st_ino) != (row.dev, row.ino):
            return "identity-changed"
        try:
            registered, admin_id = verify_registration(row.raw_path, common_dir, False)
        except EvidenceError as exc:
            if read_cut(exc.error):
                return "deadline-exceeded"
            # A registration read that failed decided nothing (R-208); an
            # absent file decides, as verify_registration() reads one.
            return "identity-changed" if exc.errno in (errno.ENOENT, errno.ENOTDIR) else "state-changed"
        if not registered or admin_id != row.admin_id:
            return "identity-changed"
    if slot_set(run):
        return "interrupted"
    unread = {row.raw_path for row in getattr(plan, "rows", None) or () if row["present"] is None}
    twin = registry_twin(evidence, records, rows, common_dir, unread)
    if twin is not None:
        return twin
    if slot_set(run):
        return "interrupted"
    reason, error = modules_check(common_dir, target.row.admin_id, run)
    if read_cut(error):
        return "deadline-exceeded"
    if error is not None:
        return "state-changed"  # a modules check that decided nothing (R-208)
    if reason is not None:
        return reason
    if slot_set(run):
        return "interrupted"
    reason, error = operation_check(common_dir, target.row.admin_id, run)  # D22's listing (LQ-14)
    if read_cut(error):
        return "deadline-exceeded"
    if error is not None:
        # An admin directory found absent decides that the registration is gone
        # (R-208); any other failure is a value that cannot be re-read (R-124,
        # R-127).
        return "identity-changed" if _absence_error(error, "listdir") else "state-changed"
    if reason is not None:
        return reason
    # The target's effective work tree, as row 4c read (LQ-11), after the
    # filesystem checks, in the text's order (the lead's R-198).
    if evidence.get("worktree_config") is True:
        if slot_set(run):
            return "interrupted"
        holds, error = effective_work_tree(target.row.raw_path, run, strict=True)
        if read_cut(error):
            return "deadline-exceeded"
        if holds is None:
            return "state-changed"  # a probe that decided nothing (R-171)
        if not holds:
            return "identity-changed"  # a decided different work tree

    if slot_set(run):
        return "interrupted"
    outcome, error = status_probe(target.row.raw_path, run)
    if read_cut(error):
        return "deadline-exceeded"
    status = None if error is not None else outcome.result
    if (status is None or status["records"] or status["ignored_files_truncated"] or status["dirty"] is not False
            or status["ignored_files"] != 0):
        return "state-changed"

    if slot_set(run):
        return "interrupted"
    reason, error = hidden_state_probe(target.row.raw_path, run)
    if read_cut(error):
        return "deadline-exceeded"
    if reason is not None:
        return reason
    if error is not None:
        return "state-changed"  # a hidden-state probe that decided nothing (R-195)

    if slot_set(run):
        return "interrupted"
    row = target.row
    reason, error = worktree_only_check(common_dir, row.admin_id, row.raw_path, getattr(row, "reflog_objects", None),
                                        row["head"], run)  # D21's re-read (LQ-13)
    if read_cut(error):
        return "deadline-exceeded"
    if error is not None:
        return "state-changed"  # a value that cannot be re-read (R-124, R-127)
    return reason


def revalidate(plan, target, run):
    """Revalidate target after the confirmation, before its removal (T084;
    design D7, FR-046, FR-047; lead rulings R-22, R-41 and R-77): D7's
    targeted check, revalidation_difference(), at most six Git children, seven
    where the plan read extensions.worktreeConfig as true
    (revalidation_children()), never the full report and never the memo. Its repository part (the
    identity probe, the manifest, the registry listing and the ref listing)
    is the previous target's rescan when take_rescan_part() hands one over
    (T085), and is read here otherwise.

    Sets target["probes_performed"], the Git children of this revalidation,
    a shared rescan's included, and returns None when nothing differs, or
    (reason, reconciliation): the record from the reads that refused it
    (plan review M13), its registry field from the registry listing and its
    branch fields from the ref listing, each null where its listing did not
    run, and the path's presence from the target's own lstat, or from one
    lstat of the planned path where the revalidation stopped before it, run
    with the reserve's budget (reserve_budget(); lead ruling R-101 (d)). A
    read the work deadline cut returns ("deadline-exceeded", None), its
    distinct return: no refusal, the target `not-attempted` with no
    reconciliation (T099; lead ruling R-80, P-2). A signal in the slot
    before one of its reads returns ("interrupted", None) the same way, the
    outcome of the seam before the spawn (lead ruling R-93 (e), LOW-1)."""
    before = run.probes
    part = take_rescan_part(plan, target, run)
    seen = {"records": None, "refs": None, "path_present": UNREADABLE}
    reason = revalidation_difference(plan, target, run, part, seen)
    target["probes_performed"] = run.probes - before + (part["children"] if part else 0)
    if reason is None:
        return None
    if reason in ("deadline-exceeded", "interrupted"):
        return reason, None
    raw = target["path"]
    registry_entry_present = None if seen["records"] is None else any(
        record["path"] == raw for record in seen["records"])
    if seen["path_present"] is UNREADABLE:
        path_present = path_presence(raw, reserve_budget(run))
    else:
        path_present = seen["path_present"]
    branch_present, branch_sha = _branch_evidence(target, seen["refs"])
    return reason, reconciliation_record(registry_entry_present, path_present, branch_present, branch_sha)


def removal_exit_status(outcome):
    """A removal's `exit_status` (T045, T056; data-model.md, "Target result and
    reconciliation record"; plan review M12) from its DriverOutcome: None
    unless the child was spawned and reaped; Git's own status when it exited;
    and 128 plus the signal number when a signal ended it, whoever sent it
    (128 minus Popen's negative return code), as execute() reports a
    delegate's: so 143 when SIGTERM ends it, at the ceiling too, and 137 only
    for a child that outlives SIGTERM until SIGKILL (lead rulings R-68 (b) and
    R-76 (e))."""
    status = outcome.status
    if status is None:
        return None
    return status if status >= 0 else 128 - status


class RemovalWait(RawOutput):
    """The parser of a removal child (T092; design D9 and D18; lead ruling
    R-83, P-1): its standard output read whole, as RawOutput reads it, and
    tick(run), which run_bounded() calls on each pass of its wait loop while
    the child is in flight. tick() prints D18's wait line, PATH in its
    command form (human_path(path, command=True); R-83, P-2), at most once
    per run: at the first signal recorded in the slot, or once the work
    deadline has passed, whichever comes first. It stops nothing, since a
    started removal is never signalled for either (D9). The line goes
    through say() only when the run has a human stream, so a bare
    Invocation prints nothing."""

    def __init__(self, path):
        super().__init__()
        self.path = path

    def tick(self, run):
        if getattr(run, "wait_line_printed", False):
            return
        left = run.work_remaining()
        if run.signal is None and (left is None or left > 0):
            return
        run.wait_line_printed = True
        if getattr(run, "human", None) is not None:
            say(run, TEXT["wait_line"].format(PATH=human_path(self.path, command=True)))


def run_removal(target, run):
    """Spawn target's removal and wait for it (T056, T092; design D2 and D9,
    FR-012): a ChildHandle of kind `removal` running git_argv("removal",
    target.removal_args), the plan's own argument vector, `-C ROOT worktree
    remove PATH` with PATH the registry's raw bytes and never --force, from
    the command directory, through run_bounded(), which counts it among
    `operations` and waits for it in D1's one loop with no budget: SIGINT,
    SIGTERM and SIGHUP are only recorded and the work deadline changes
    nothing, so the child is never signalled for any of them. Only its hard
    ceiling ends the wait: TIMING["removal_ceiling"] (300 s in the real
    table), read by run_bounded() at the spawn, after which terminate_group()
    sends SIGTERM to its group and the loop advances it to SIGKILL and a
    bounded reap, or abandons it (R-30), outcome `timeout`, which the rescan
    decides (decide_stage()). An exception in that loop waits for the child
    before it goes on (_settle()). Its parser, RemovalWait, prints D18's wait
    line at the first signal or once the deadline has passed (lead ruling
    R-83, P-1). Sets target["exit_status"] (removal_exit_status()) and returns
    the DriverOutcome; one that could not be spawned is outcome `failed` with
    no status."""
    outcome = run_bounded(("removal", target.removal_args, target.root), RemovalWait(target["path"]), run)
    target["exit_status"] = removal_exit_status(outcome)
    return outcome


def _identity_gone(planned):
    """Whether the planned repository is gone by filesystem evidence: an
    lstat of its root or of its common directory fails with ENOENT or
    ENOTDIR. A call that gives no value, or another error, proves nothing."""
    for path in (planned["root"], planned["common_dir"]):
        result = _lstat(path)
        if isinstance(result, EvidenceError) and result.errno in (errno.ENOENT, errno.ENOTDIR):
            return True
    return False


def rescan(target, run):
    """The rescan after target's removal child is reaped (T056, T085; design
    D7; data-model.md, "Revalidation step and probes_performed"; BA:709-719
    at da33d92). It first re-establishes the repository identity
    (repository_identity(): the identity probe in the command directory, the
    realpaths and the common directory's lstat), compared with the plan's
    {root, common_dir, dev, ino}. Where it differs, or the repository is gone
    (_identity_gone()), every field is null and `reconciled` false, and
    decide_stage() makes the target `unknown` with `unconfirmed-removal`.
    Where any read fails or is cut (the identity probe while the repository
    is still there, the registry listing, the ref listing or the lstat), the
    record is an UnfinishedRescan, which decide_stage() makes
    `reconciliation-incomplete` after exit 0 (lead ruling R-78 (e), second
    amendment).

    Then, with the manifest re-read between the first two children, the
    registry listing (row 4, WorktreeListParser), the ref listing (row 6,
    RefParser, over refs/heads and refs/remotes, a superset of revalidation's
    narrowed listing; lead ruling R-77 (a)) and an lstat of the planned path.
    Returns the reconciliation record: whether the registry still lists the
    planned path, whether the path is present, and the branch's presence and
    SHA, a value not established null. Last, only where the registry entry
    and the path are both shown present, one lstat of the target's `.git`
    (git_file_presence()), never a Git child, kept on the target as
    `git_file_present` and in no record: Git refuses `git worktree remove
    --force` once that file is gone, so the partial-removal note that a
    removal cut at its ceiling prints names that command only where both
    are present (partial_removal_text(); lane 3's W52 F-1, Brett Heap's
    ruling "F-1: prune-then-delete", lead ruling R-263). Its failure, its
    cut or a second SIGINT during it leaves `git_file_present` None and the
    record as the other reads made it.

    These three repository children, with the manifest value, are left on
    run as `rescan_part`, for the next selected target's revalidation to
    take as its steps 1 to 4 when this target ends a plain `removed`
    (take_rescan_part(); T085; lead ruling R-77 (b)); they then count in that
    target's `probes_performed`, and otherwise they are the final rescan.

    apply_removals() runs it in phase `reconciling` (T093; lead ruling R-83,
    P-3), so each of its children and calls gets min(5 s, reserve remaining)
    (child_budget()), and a second SIGINT raises Interrupted out of the read
    in progress, run_bounded() having terminated and reaped its child, or
    fs_call() having abandoned its call. The remaining reads are then
    abandoned (D15, FR-036; pcl:935-937): the fields they would have read
    stay null, the record is an UnfinishedRescan, and no part is left for a
    next target. Interrupted never leaves the rescan."""
    before = run.probes
    run.rescan_part = target.git_file_present = None
    root = os.fsencode(target.root)
    planned = target.identity
    records = refs = path_present = None
    abandoned = False
    try:
        found = repository_identity(root, run)
        if planned is None or (found is None and not _identity_gone(planned)):
            return UnfinishedRescan(reconciliation_record(None, None, None, None))
        if not same_repository(found, planned):
            return reconciliation_record(None, None, None, None)
        declared = reread_manifest(root)
        records = _listing(run, root, ["worktree", "list", "--porcelain", "-z"], "worktree list",
                           WorktreeListParser())
        refs = _listing(run, root, ["for-each-ref", "--format=" + REF_FORMAT, "refs/heads", "refs/remotes"],
                        "for-each-ref", RefParser())
        run.rescan_part = {"after": target.row, "identity": found, "declared": declared, "records": records,
                           "refs": refs, "children": run.probes - before}
        path_present = path_presence(target["path"])
    except Interrupted:
        run.rescan_part, abandoned = None, True
    registry_entry_present = None if records is None else any(
        record["path"] == target["path"] for record in records)
    if not abandoned and registry_entry_present is True and path_present is True:
        target.git_file_present = git_file_presence(target["path"])  # W52 F-1
    branch_present, branch_sha = _branch_evidence(target, refs)
    reconciliation = reconciliation_record(registry_entry_present, path_present, branch_present, branch_sha)
    if abandoned or None in (records, refs, path_present):
        return UnfinishedRescan(reconciliation)
    return reconciliation


def decide_stage(target, outcome, reconciliation):
    """The final stage of a spawned target (T056, T085; design D7, D9, D15
    and D19; data-model.md, "Target stages"; lead rulings R-76 (a) and R-78
    (e)), a pure function of its removal's DriverOutcome, the rescan's
    reconciliation record and the target's planned branch head
    (`planned_sha`); returns (stage, reason, notes). A target is `removed`
    only when the rescan shows its registry entry and its path both gone and
    the record is `reconciled` (FR-034; pcl:891-895).

    - Not spawned (outcome `failed` with no status): `failed`, `spawn-error`.
    - Exited on its own, signal or not: nonzero is `failed`, `git-refused` for
      128 and `git-failed` for any other status, whatever the slot holds.
    - Exited 0: gone and reconciled is `removed`, its reason null, or
      `branch-missing-after-removal` when the branch is absent, or
      `branch-advanced-after-removal` when it is at a SHA other than
      `planned_sha`, any difference, a rewind included (D7; rs:210-214);
      either stops the run, exit 2, and no commit is lost, since no branch is
      deleted. Otherwise `unknown`: `reconciliation-incomplete` when a rescan
      read failed, was cut or was abandoned (an UnfinishedRescan), or the
      entry and the path are gone with the branch not read back (BA:518-526
      at da33d92; lead ruling R-78 (e), second amendment); else
      `unconfirmed-removal`, whose reads showed the removal not done, or the
      identity found lost or another one (pcl:966-970, rs:215-217).
    - Cut at its ceiling, or its exit not observed (outcome `timeout`, design
      D9): the rescan alone decides, `removed` when the entry and the path
      are gone and the record is reconciled, otherwise `unknown`, each with
      `removal-ceiling`, and the note `partially-removed` while the entry or
      the path is shown to remain, whose human text partial_removal_text()
      picks (W52 F-1, R-263); a repository found replaced or lost at
      the ceiling, every field null, is `unknown` with `removal-ceiling` and
      no note.

    The `orphaned-directory` note is never decided here: apply_removals()
    adds it after this function (target_notes(); lead ruling R-83, P-5)."""
    entry, path = reconciliation["registry_entry_present"], reconciliation["path_present"]
    proven = entry is False and path is False and reconciliation["reconciled"]
    if outcome.name == "timeout":
        if proven:
            return "removed", "removal-ceiling", []
        return "unknown", "removal-ceiling", ["partially-removed"] if entry or path else []
    if outcome.status is None:
        return "failed", "spawn-error", []
    if outcome.status != 0:
        return "failed", "git-refused" if outcome.status == 128 else "git-failed", []
    if proven:
        if reconciliation["branch_present"] is False:
            return "removed", "branch-missing-after-removal", []
        if reconciliation["branch_sha"] != target["planned_sha"]:
            return "removed", "branch-advanced-after-removal", []
        return "removed", None, []
    if isinstance(reconciliation, UnfinishedRescan) or (entry is False and path is False):
        return "unknown", "reconciliation-incomplete", []
    return "unknown", "unconfirmed-removal", []


def target_notes(notes, reconciliation):
    """A target's `notes` (T093; the project-clean delta, pcl:921-926; lead
    ruling R-83, P-5): notes, what decide_stage() gave (`partially-removed`
    or none), plus `orphaned-directory` when the target has a reconciliation
    record whose registry entry is absent (false) and whose path is present
    (true), a refused target's included; in NOTE_CODES["target"]'s order. A
    pure function."""
    codes = set(notes)
    if (reconciliation is not None and reconciliation["registry_entry_present"] is False
            and reconciliation["path_present"] is True):
        codes.add("orphaned-directory")
    return [code for code in NOTE_CODES["target"] if code in codes]


def remove_target(plan, target, run):
    """One selected target's own steps, in phase `apply` (T057, T093, T099;
    design D7, D9 and D15): its revalidation (revalidate()), a difference
    refusing it with that revalidation's record, and a read the work deadline
    cut making it `not-attempted` with `deadline-exceeded` and no
    reconciliation (lead ruling R-80, P-2), as a signal read in the slot
    before one of its reads makes it `not-attempted` with `interrupted` (lead
    ruling R-93 (e), LOW-1); then the seam before the spawn:
    the slot read, a signal recorded since the revalidation began making it
    `not-attempted` with `interrupted`, then the removal floor read again
    (below_removal_floor()), less than the floor of work left making it
    `not-attempted` with `deadline-exceeded`, each with no reconciliation
    (R-83, P-15; R-80, P-2); then its removal child, spawned and waited for
    (run_removal()); then the reserve counted from the child's exit, the
    Invocation's reserve_end becoming the later of its planned end and the
    exit plus TIMING["reconciliation_reserve"], so that the reserve never
    shrinks (R-80, P-3; design D9); then the phase `reconciling` and the
    rescan (rescan()), its record kept on the target at once; then its stage
    (decide_stage()) and its notes (target_notes()). Each step may raise an
    Exception, which apply_removals() handles."""
    refused = revalidate(plan, target, run)
    if refused is not None:
        reason, reconciliation = refused
        if reason in ("deadline-exceeded", "interrupted"):
            target.update(stage="not-attempted", reason=reason, reconciliation=None)
            return
        target.update(stage="refused", reason=reason, reconciliation=reconciliation,
                      notes=target_notes((), reconciliation))
        return
    if run.signal is not None:
        target.update(stage="not-attempted", reason="interrupted", reconciliation=None)
        return
    if below_removal_floor(run):
        target.update(stage="not-attempted", reason="deadline-exceeded", reconciliation=None)
        return
    outcome = run_removal(target, run)
    if run.reserve_end is not None:
        run.reserve_end = max(run.reserve_end, run.now() + TIMING["reconciliation_reserve"])
    run.phase = "reconciling"
    target["reconciliation"] = reconciliation = rescan(target, run)
    stage, reason, notes = decide_stage(target, outcome, reconciliation)
    target.update(stage=stage, reason=reason, notes=target_notes(notes, reconciliation))


def best_effort(write, *args):
    """Call write(*args), one of the apply phase's renderings: a progress
    line, the human result, or the apply result record. An Exception there
    changes no stage, since a proven removal stays proven, and no exit
    status, which D19 has decided already (T093; lead ruling R-83, P-8); the
    rendering is dropped and the run goes on. A failed write is say()'s and
    write_document()'s to record, never raised (lead ruling R-55, P-9)."""
    try:
        write(*args)
    except Exception:
        pass


def apply_removals(plan, run):
    """Remove the plan's selected worktrees (T057, T093; design D7, D9, D15
    and D19; contracts/project-clean.md, "Order of a run", step 8): called in
    phase `apply`, which the pipeline sets after its own read of the slot
    (lead ruling R-56). Per selected row, in canonical order, its Target
    (make_target()); then:

    - the seam before its revalidation: a signal in the slot makes it, and
      every later target, `not-attempted` with `interrupted` and no
      reconciliation (D15; pcl:931-935); otherwise, once the work deadline
      has stopped the run, or when less than the removal floor of work is
      left now (below_removal_floor()), `not-attempted` with
      `deadline-exceeded` and no reconciliation, and so is every later
      target (T099; pcl:779-782; lead ruling R-80, P-2); otherwise, once the
      batch has stopped, `not-attempted` with `batch-stopped`;
    - otherwise its own steps (remove_target()) in phase `apply`, set again
      here after the previous target's rescan: D7's targeted revalidation
      (T084), a read the deadline cut ending it `not-attempted` with
      `deadline-exceeded`, and a signal it reads in the slot before any of
      its reads `not-attempted` with `interrupted`, so that no probe starts
      after the signal (lead ruling R-93 (e), LOW-1; pcl:931-933); the seam
      before the spawn, with the floor read
      again (T099); the removal, never signalled and waited for up to its
      ceiling (T092), the reserve then counting from its exit (T099); then
      the rescan in phase `reconciling`, within the reserve, whose three
      repository children serve as the next target's steps 1 to 4 after a
      plain `removed` (T085; lead ruling R-83, P-3), and the stage and notes;
    - an Exception while handling it, after any removal in flight has been
      waited for (run_bounded()'s _settle()), makes it `unknown` with
      `internal-error`, its record the rescan's when one was read and every
      field null otherwise, and later targets `not-attempted` (plan review
      M2; pcl:938-941; research.md R6). Interrupted, a second SIGINT while
      reconciling, never leaves the rescan.

    The batch stops after the first target that is not a plain `removed`
    (reason null). Each target's progress line prints at its final stage
    (print_progress()), then the result (print_result()), every human line
    through say() to run.human, standard error under --apply --json, and
    under --apply --json the apply result record then goes to standard
    output through write_document(): each rendering best-effort
    (best_effort()), so the record is printed whatever stopped the batch.
    Returns apply_exit_status(targets, run.signal), D19's table, whose first
    row reads the slot."""
    targets = [make_target(plan, row) for row in plan.selected or ()]
    stopped = deadline = False
    for target in targets:
        if run.signal is not None:
            target.update(stage="not-attempted", reason="interrupted", reconciliation=None)
        elif deadline or (not stopped and below_removal_floor(run)):
            target.update(stage="not-attempted", reason="deadline-exceeded", reconciliation=None)
            stopped = deadline = True
        elif stopped:
            target.update(stage="not-attempted", reason="batch-stopped", reconciliation=None)
        else:
            run.phase = "apply"
            try:
                remove_target(plan, target, run)
            except Exception:
                reconciliation = target["reconciliation"] or reconciliation_record(None, None, None, None)
                target.update(stage="unknown", reason="internal-error", reconciliation=reconciliation,
                              notes=target_notes((), reconciliation))
            stopped = not (target["stage"] == "removed" and target["reason"] is None)
            deadline = (target["stage"], target["reason"]) == ("not-attempted", "deadline-exceeded")
        best_effort(print_progress, target, run)
    status = apply_exit_status(targets, run.signal)
    best_effort(print_result, plan, targets, run)
    if getattr(run.args, "json", False):
        estimated = (getattr(plan, "planning_probes", 0) + revalidation_children(plan) * len(targets)
                     + LIMITS["rescan_children"])
        best_effort(lambda: write_document(result_document(
            targets, status, repository=getattr(plan, "repository", None), merge_target=plan.merge_target,
            plan_digest=plan.digest, probes={"estimated": estimated, "performed": run.probes},
            operations={"estimated": len(targets), "performed": run.operations})))
    return status
# endregion apply

# region result
# The end of an apply (T045, T057; design D18 and D19; data-model.md, "Target
# stages", "Exit statuses" and "Apply result record"; contracts/project-clean.md,
# "Human output", "Apply result record" and "Exit statuses"; lead ruling R-56
# Q-8 to Q-10). A target is a mapping of the values a target result holds
# (region apply, Target): these functions read it and never mutate it.

# The reasons that send a run with --apply to D19's second row, exit 1: the
# deadline stopping work after the apply phase began, and the hard ceiling.
EXIT_ONE_REASONS = ("deadline-exceeded", "removal-ceiling")


def apply_exit_status(targets, signum):
    """The exit status of a run with --apply by D19's table (FR-037; lead
    ruling R-56 Q-8), its first matching row: signum, the slot's first
    signal, gives 128 plus its number (130, 143 or 129); then 1 when any
    target is `unknown`, or its reason is `removal-ceiling` or, on a
    `not-attempted` target, `deadline-exceeded`; then the status of the first
    target `failed` with `git-refused` or `git-failed`, Git's own, passed
    through even when it equals one of project's (OQ-25); then 2 for a
    `refused` target, a `removed` one with a branch-after-removal reason, or
    `failed` with `spawn-error`; then 0 when every target is `removed` with
    reason null, or none was selected. A list no row matches, which the apply
    phase never builds (a target still `pending`, or `not-attempted` with
    nothing that stopped the run), fails closed with 2."""
    if signum is not None:
        return 128 + int(signum)
    if any(target["stage"] == "unknown" or target["reason"] in EXIT_ONE_REASONS for target in targets):
        return 1
    for target in targets:
        if (target["stage"] == "failed" and target["reason"] in ("git-refused", "git-failed")
                and target["exit_status"] is not None):
            return target["exit_status"]
    if all(target["stage"] == "removed" and target["reason"] is None for target in targets):
        return 0
    return 2


def json_argv(argv):
    """An argument vector as a document writes it: each str as it is, and each
    path (bytes or a path object) through json_path(), as text."""
    return [arg if isinstance(arg, str) else json_path(arg)[0] for arg in argv]


def target_document(target):
    """One target result in TARGET_RESULT_KEYS's order (data-model.md, "Target
    result and reconciliation record"): `path` through json_path() with
    `path_valid_utf8` beside it, `command` through json_argv(), and
    `reconciliation` null on a `not-attempted` target and an object in
    RECONCILIATION_KEYS's order on every other, every field null and
    `reconciled` false where none was read."""
    path, valid = json_path(target["path"])
    reconciliation = None
    if target["stage"] != "not-attempted":
        record = target["reconciliation"] or {key: None for key in RECONCILIATION_KEYS}
        reconciliation = {key: record[key] for key in RECONCILIATION_KEYS}
        reconciliation["reconciled"] = bool(reconciliation["reconciled"])
    values = dict(target, path=path, path_valid_utf8=valid, notes=list(target["notes"]),
                  command=json_argv(target["command"]), reconciliation=reconciliation)
    return {key: values[key] for key in TARGET_RESULT_KEYS}


def result_document(targets, exit_code, *, repository, merge_target, plan_digest, probes, operations):
    """The apply result record (contracts/project-clean.md, "Apply result
    record"; data-model.md, "Apply result record"), in APPLY_RESULT_KEYS's
    order, written by write_document() as the one document of --apply --json
    once the apply phase has begun: `schema_version` 1; `observed_at`, now,
    when reconciliation finished; `repository`, `merge_target` and
    `plan_digest`, the plan's, as its envelope writes them; `probes` and
    `operations`, {estimated, performed}; one target_document() per target,
    in canonical order; `exit_code`, the run's exit status (apply_exit_status());
    and `completeness`, `complete` when every target whose reconciliation is
    an object has `reconciled: true`, else `incomplete`."""
    documents = [target_document(target) for target in targets]
    complete = all(document["reconciliation"]["reconciled"] for document in documents
                   if document["reconciliation"] is not None)
    values = {"schema_version": 1, "observed_at": observed_at(), "repository": repository,
              "merge_target": merge_target, "plan_digest": plan_digest, "probes": probes,
              "operations": operations, "targets": documents, "exit_code": exit_code,
              "completeness": "complete" if complete else "incomplete"}
    return {key: values[key] for key in APPLY_RESULT_KEYS}


def progress_line(target):
    """A target's one progress line, at its final stage (lead ruling R-56
    Q-10; `pending` is never printed): `  STAGE PATH`, or `  STAGE PATH
    (REASON)` when it has a reason, PATH through human_path()."""
    path = human_path(target["path"])
    if target["reason"] is None:
        return TEXT["progress_line"].format(STAGE=target["stage"], PATH=path)
    return TEXT["progress_line_reason"].format(STAGE=target["stage"], PATH=path, REASON=target["reason"])


def print_progress(target, run):
    """Print target's progress line through say() once it is final; the apply
    phase calls it for each target in canonical order as it ends."""
    say(run, progress_line(target))


# The stages of a target whose removal child the apply phase spawned, or
# tried to: the rescan after it reads the branch back (lead ruling R-79, P-10).
RESCANNED_STAGES = ("removed", "failed", "unknown")


def branch_not_confirmed(target):
    """Whether target's branch is left out of `Branches kept:` (T094; lead
    rulings R-76 (f) and R-79, P-10): its last read shows it absent
    (`branch_present` false, at any stage), or its rescan did not read it
    back (`branch_present` null on a `removed`, `failed` or `unknown`
    target), a reconciliation still None reading as every field null, as
    target_document() writes it. A `refused` target whose revalidation
    stopped before its ref listing, and a `not-attempted` one, which has no
    reconciliation, keep their branch, since nothing was spawned for them.
    print_result()'s alone."""
    if target["stage"] == "not-attempted":
        return False
    present = (target["reconciliation"] or {}).get("branch_present")
    return present is False or (present is None and target["stage"] in RESCANNED_STAGES)


def partial_removal_text(target):
    """The TEXT key of the partial-removal note of a target noted
    `partially-removed` at its removal ceiling (lane 3's W52 F-1; Brett
    Heap's ruling "F-1: prune-then-delete", lead ruling R-263), a pure
    function: `partial_removal_note`, whose `git worktree remove --force`
    Git accepts, only where the rescan showed both the registry entry
    (`registry_entry_present` true) and the target's `.git`
    (`git_file_present` true) present; otherwise `partial_removal_note_prune`,
    since Git refuses that command once the `.git` file is gone ("validation
    failed") or the entry is gone ("is not a working tree"), and a value not
    established never shows both present. A target that is a plain dict
    carries no `.git` read. print_result()'s alone; a report row's note is
    partial_removal_note()'s and keeps its own text."""
    entry = (target["reconciliation"] or {}).get("registry_entry_present")
    if entry is True and getattr(target, "git_file_present", None) is True:
        return "partial_removal_note"
    return "partial_removal_note_prune"


def print_result(plan, targets, run):
    """The human result of an apply (design D18; lead rulings R-56 Q-9,
    R-76 (d) and (f) and R-79, P-10 and P-11), after every target's progress
    line, through say(), so standard error under --apply --json and a failed
    write recorded, never raised. First, D18's partial-removal note for each
    target noted `partially-removed`, in canonical order, its PATH in the
    command form (lead ruling R-83, P-2), its text partial_removal_text()'s
    (W52 F-1, R-263). Then, when every target is
    `removed` with reason null, `Removed N; branches kept: B1, B2.`, naming
    every selected target's branch, since the apply phase deletes no branch;
    otherwise D18's stop block at the first target that is not, its `Not
    attempted:` naming the `not-attempted` targets (`none` when there is
    none, a case D18 leaves open), its `Next:` command naming plan.root, then
    `Branches kept: B1, B2.` (`none` when there is none), leaving out each
    branch branch_not_confirmed() names, and those branches on their own
    line, `Branches not confirmed: B1.`, when there is one. In both cases the
    residual-window line ends the result. Targets go in canonical order;
    paths and branches print through human_path(), the commands' paths in
    their command form."""
    for target in targets:
        if "partially-removed" in (target["notes"] or ()):
            say(run, TEXT[partial_removal_text(target)].format(PATH=human_path(target["path"], command=True)))
    stop = next((target for target in targets
                 if not (target["stage"] == "removed" and target["reason"] is None)), None)
    if stop is None:
        branches = ", ".join(human_path(target["branch"]) for target in targets)
        say(run, TEXT["success_line"].format(N=len(targets), BRANCHES=branches))
    else:
        skipped = [human_path(target["path"]) for target in targets if target["stage"] == "not-attempted"]
        say(run, TEXT["stop_block"].format(
            PATH=human_path(stop["path"]), REASON=stop["reason"],
            K=sum(target["stage"] == "removed" for target in targets), N=len(targets),
            NOT_ATTEMPTED=", ".join(skipped) or "none", ROOT=human_path(plan.root, command=True)))
        kept = [human_path(target["branch"]) for target in targets if not branch_not_confirmed(target)]
        unconfirmed = [human_path(target["branch"]) for target in targets if branch_not_confirmed(target)]
        say(run, TEXT["branches_kept_line"].format(BRANCHES=", ".join(kept) or "none"))
        if unconfirmed:
            say(run, TEXT["branches_not_confirmed"].format(BRANCHES=", ".join(unconfirmed)))
    say(run, TEXT["residual_window_line"])
# endregion result

# region push
def push_or_delete(repo, run):
    """Push a branch, or delete a merged one (T076, T077; FR-010, FR-041, FR-046,
    FR-047; research.md R1, R4 and R5; data-model.md, "States of push and
    delete-branch"; lead rulings R-45 (5), R-53 and R-74 (c)). Called in phase
    `planning`, which it keeps, with run.plan the run's own plan: its full
    inspection under single mode's row cap and bounds with the batch's
    completeness, which check_plan() has already refused when incomplete, so
    that is the check before confirmation (plan review B1). Returns the
    child's exit status, or raises a refusal or Interrupted to main().

    The baseline's checks and messages are kept (project:680-706 and :723-743
    at 961c405; the --branch checks are check_clean_arguments()'s), a branch
    or path in them shown through human_path(). Push refuses a branch with no
    unique worktree, the default branch, a worktree not exactly clean, a
    detached one and the classes to reconcile; then a branch whose configured
    upstream's remote-tracking ref is gone, whatever its class, with
    TEXT["push_remote_gone"] and the reason `remote-gone`, no code (R-45 (5));
    only then is the command built (lead ruling R-101 (e) 1; lane 3's H-1 and
    H-2). For a configured upstream it is `push -- REMOTE refs/heads/B:MERGE`,
    REMOTE and MERGE read from branch.B.remote and branch.B.merge through the
    driver (git_text()), never split from the upstream's short name: one value
    each, REMOTE not `.` and MERGE under refs/heads/, or the baseline's
    `Unsupported upstream mapping` refusal. With none it is `push -u -- origin
    refs/heads/B:refs/heads/B`, `remote get-url origin` running through the
    driver. The refspec is fully qualified with no leading `+`, and `--` ends
    the options, so that no remote, branch or ref text is read as an option, a
    forced update or a configured push mapping. Delete-branch refuses the
    default branch, a branch a present worktree holds (with the baseline's
    message where a linked worktree holds it, and with
    TEXT["branch_held_by_main_worktree"] where the main worktree alone does,
    since Git never removes the main worktree: lane 3's W52 F-5, lane 5's
    RI-4, R-248), and a branch not verified as merged: its
    head is read from row 6 and its merged-ness from row 7 of the plan's
    evidence, never through a new child, and a branch absent from row 6 or a
    row 7 not read refuses (P-23). Its vector is `branch -d -- B`, `--`
    ending the options, so that a name that begins with `-` is never read as
    one (W52 F-4).

    Then `Cleanup action:` and show_push_plan() through say(), and the check
    after printing (check_writes(); R-74 (c)(3)), so that a closed standard
    output refuses before any child; confirm(), unchanged, under
    default_signals() with the clock paused, since time at the question does
    not count (research.md R4; analyze M3); the full re-inspection after
    confirmation (require_unchanged_cleanup_state()); and the child, the
    slot read just before it is spawned, a set slot raising Interrupted with
    nothing run (P-7). Once the child is reaped the phase is `apply`, as the
    pipeline sets it before a removal (R-101 (e) 2; lane 3's M-1; pcl:928-935):
    a signal recorded by then is reported on standard error with git's status,
    never as `Cancelled.`, and the run exits 130, 143 or 129; otherwise it
    exits with the child's status, 128 plus the signal number for a signal
    death (D19's first row; plan review M3).

    The push child runs through execute() with git_env("push") (R1, PR #19):
    project's own streams and process group, so that it is in the terminal's
    foreground when project is; no pin; the caller's GIT_ALLOW_PROTOCOL kept
    and the other thirty names removed (R-28, Q9 B). The `git branch -d` child is a
    `delegate` handle on the driver: its own process group, the thirty-one
    names removed and the seven pins, no budget, its output relayed to
    project's streams by RelayParser (R5, P-1); one that cannot be spawned is
    the baseline's `Cannot run git: ...` refusal. Neither is ever signalled:
    signal_scope()'s handlers only record a signal that reaches project
    meanwhile, and the child is waited for."""
    args, plan = run.args, run.plan
    root, report, branch = repo["root"], plan.report, args.branch
    rows, target, shown = report["worktrees"], report["target_branch"], human_path(branch)
    if args.action == "push":
        matches = [row for row in rows if row.get("branch") == branch]
        if len(matches) != 1:
            raise Refused(f"No unique linked worktree found for branch {shown}")
        row = matches[0]
        if row.get("branch") == target:
            raise Refused("The default branch is protected; use its normal repository workflow.")
        if row.get("dirty") is not False:
            raise Refused(f"Cannot push {shown}; its worktree is dirty, missing, or unreadable.")
        if row.get("branch") == "detached":
            raise Refused("Cannot push a detached worktree; name the branch first.")
        if row.get("classification") in ("diverged", "remote-ahead", "review-required"):
            raise Refused(f"Cannot push {shown}; reconcile its remote state first.")
        upstream = row.get("upstream")
        if upstream is not None and row.get("remote_present") is False:
            raise Refused(TEXT["push_remote_gone"].format(BRANCH=shown, UPSTREAM=human_path(upstream)),
                          reason="remote-gone")
        if upstream:
            remote = git_text(root, "config", "--get-all", f"branch.{branch}.remote")
            merge = git_text(root, "config", "--get-all", f"branch.{branch}.merge")
            if (not remote or remote == "." or not merge or "\n" in remote + merge
                    or not merge.startswith("refs/heads/") or merge == "refs/heads/"):
                raise Refused(f"Unsupported upstream mapping for {shown}: {human_path(upstream)}")
            words = ["--", remote, f"refs/heads/{branch}:{merge}"]
        else:
            if not git_text(root, "remote", "get-url", "origin"):
                raise Refused("Cannot publish a branch without an origin remote.")
            words = ["-u", "--", "origin", f"refs/heads/{branch}:refs/heads/{branch}"]
        argv = git_argv("push", ["-C", str(root), "push", *words])
        action = f"push branch {shown}"
    else:
        if branch == target:
            raise Refused("The default branch is protected and cannot be deleted.")
        holders = [row for row in rows if row.get("present") and row.get("branch") == branch]
        if any(not row.main for row in holders):
            raise Refused("Remove the linked worktree first; branch deletion is a separate action.")
        if holders:  # the main worktree alone holds it, which Git never removes (W52 F-5, RI-4)
            raise Refused(TEXT["branch_held_by_main_worktree"].format(BRANCH=shown, NAME=human_path(target)))
        refname, evidence = os.fsencode("refs/heads/" + branch), plan.evidence
        listed = any(ref["refname"] == refname for ref in evidence["refs"] or ())
        if not listed or evidence["merged"] is None or refname not in evidence["merged"]:
            raise Refused(f"Branch {shown} is not verified as merged into {human_path(target)}.")
        # `--` before the name, as the push's vector has it, so that a name that
        # begins with `-` is a branch and never an option (W52 F-4).
        delegate = ["-C", str(root), "branch", "-d", "--", branch]
        argv = git_argv("delegate", delegate)
        action = f"delete verified merged local branch {shown}"
    say(run, f"Cleanup action: {action}")
    show_push_plan(run, argv, root)
    check_writes(run)
    run.pause()
    try:
        with default_signals():
            confirm(args.yes)
    finally:
        run.resume()
    require_unchanged_cleanup_state(repo, run, args.action, branch)
    read_slot(run)
    if args.action == "push":
        status = execute(argv, env=git_env("push"))
    else:
        outcome = run_bounded(("delegate", delegate, None), RelayParser(), run)
        if outcome.status is None:  # it could not be spawned: the baseline's refusal
            detail = outcome.detail or "git was not run"
            raise Refused(detail[:1].upper() + detail[1:])
        status = outcome.status if outcome.status >= 0 else 128 - outcome.status
    run.phase = "apply"  # the child ran: a signal now sets the status, never `Cancelled.`
    if run.signal is None:
        return status
    noun = "the push" if args.action == "push" else "the branch deletion"
    say(run, f"Interrupted; {noun} had started and was waited for, and git exited with status {status}.",
        sys.stderr)
    return 128 + int(run.signal)


def show_push_plan(run, argv, cwd):
    """The plan of push and delete-branch (T076; FR-041; plan review B2; lead
    rulings R-53 P-8 and R-74 (c)(1)), as show_plan() prints it, through
    say(): `Working directory:` in the prose form, human_path(cwd), and the
    argument vector exactly as it is spawned, the push with no pin and `git
    branch -d` with the seven, every word through human_path(word,
    command=True), which is shlex.quote() for an ordinary word and the $'...'
    form for a word holding a Cc, Cf, Zl or Zp code point or an undecodable
    byte. show_plan() stays as it is for `new` and `update`."""
    say(run, f"Working directory: {human_path(cwd)}")
    say(run, "  " + " ".join(human_path(word, command=True) for word in argv))


class RelayParser:
    """The parser of the `git branch -d` delegate (T077; research.md R5; lead
    rulings R-50 (e) and R-53 P-1). It gathers no evidence: feed() writes each
    chunk of the child's standard output to project's own standard output,
    and feed_stderr(), which run_bounded() calls beside keep_stderr(), each
    chunk of its standard error to project's own standard error, both whole,
    as bytes, and flushed, so that the person sees the child's output as
    execute() gave it before this change. It never reaches a bound, and
    finish() returns b"". A failed write diverts that stream and is recorded
    as say() records one (write_failed(); R-55), never raised, so that the
    delegate is still read to its end and waited for."""

    bound_reached = False

    def feed(self, chunk):
        self._relay(sys.stdout, chunk)

    def feed_stderr(self, chunk):
        self._relay(sys.stderr, chunk)

    def finish(self):
        return b""

    @staticmethod
    def _relay(stream, chunk):
        if stream is None:
            return
        try:
            stream.flush()  # what project wrote first stays first
            buffer = getattr(stream, "buffer", None)
            if buffer is None:
                stream.write(chunk.decode("utf-8", "surrogateescape"))
                stream.flush()
            else:
                buffer.write(chunk)
                buffer.flush()
        except OSError as exc:
            write_failed(current_invocation(), stream, exc)
